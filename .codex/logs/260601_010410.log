ss=\"task-title\"><?php echo $safeTitle; ?></h3>\n                        </div>\n                        <p class=\"task-summary\"><?php echo $safeSummary; ?></p>\n                        <div><span class=\"status-badge\"><?php echo $safeStatus; ?></span></div>\n                        <time class=\"created-time\" datetime=\"<?php echo escapeHtml($task['created_at']); ?>\"><?php echo $safeCreatedAt; ?></time>\n                        <nav class=\"actions\" aria-label=\"<?php echo $safeTitle; ?> 操作\">\n                            <a class=\"action-link\" href=\"index.php?action=view&id=<?php echo $taskId; ?>\">查看</a>\n                            <a class=\"action-link\" href=\"index.php?action=edit&id=<?php echo $taskId; ?>\">编辑</a>\n                            <a class=\"action-link\" href=\"index.php?action=delete&id=<?php echo $taskId; ?>\">删除</a>\n                        </nav>\n                    </article>\n                <?php endforeach; ?>\n            <?php endif; ?>\n        </section>\n    </main>\n</body>\n</html>\n","exit_code":0,"status":"completed"}}

