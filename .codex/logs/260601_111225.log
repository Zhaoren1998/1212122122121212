k-title\">\n            <h2 id=\"create-task-title\">新增任务</h2>\n\n            \n            \n            \n            <form method=\"post\" action=\"index.php\" data-task-form data-form-action=\"create\" novalidate>\n                <input type=\"hidden\" name=\"form_action\" value=\"create\">\n                                <div class=\"form-grid\">\n                    <div class=\"form-field\">\n                        <label for=\"task-title\">任务标题</label>\n                        <input\n                            class=\"input\"\n                            id=\"task-title\"\n                            name=\"title\"\n                            type=\"text\"\n                            maxlength=\"80\"\n                            value=\"\"\n                            aria-describedby=\"task-title-help\"\n                            required\n                        >\n                                                <span class=\"field-help\" id=\"task-title-help\">最多 80 个字符。</span>\n                    </div>\n\n                    <div class=\"form-field\">\n                        <label for=\"task-status\">初始状态</label>\n                        <select\n                            class=\"select\"\n                            id=\"task-status\"\n                            name=\"status\"\n                            aria-describedby=\"task-status-help\"\n                        >\n                                                            <option value=\"未开始\" selected>\n                                    未开始                                </option>\n                                                            <option value=\"进行中\">\n                                    进行中                                </option>\n                                                            <option value=\"已完成\">\n                                    已完成                                </option>\n                                                            <option value=\"已归档\">\n                                    已归档                                </option>\n                                                    </select>\n                                                <span class=\"field-help\" id=\"task-status-help\">创建后会直接显示在列表中。</span>\n                    </div>\n\n                    <div class=\"form-field\">\n                        <label for=\"task-priority\">任务优先级</label>\n                        <select\n                            class=\"select\"\n                            id=\"task-priority\"\n                            name=\"priority\"\n                            aria-describedby=\"task-priority-help\"\n                        >\n                                                            <option value=\"高\">\n                                    高                                </option>\n                                                            <option value=\"中\" selected>\n                                    中                                </option>\n                                                            <option value=\"低\">\n                                    低                                </option>\n                                                    </select>\n                                                <span class=\"field-help\" id=\"task-priority-help\">未选择时默认使用中优先级。</span>\n                    </div>\n\n                    <div class=\"form-field\">\n                        <label for=\"task-category\">任务分类</label>\n                        <select\n                            class=\"select\"\n                            id=\"task-category\"\n                            name=\"category_id\"\n                            aria-describedby=\"task-category-help\"\n                        >\n                            <option value=\"\">未分类</option>\n                                                    </select>\n                                                <span class=\"field-help\" id