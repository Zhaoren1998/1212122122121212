{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' index.php\"","aggregated_output":"<?php\ndeclare(strict_types=1);\n\nconst DATA_FILE = __DIR__ . '/data/tasks.json';\nconst LOG_FILE = __DIR__ . '/logs/app.log';\nconst MAX_TITLE_LENGTH = 80;\nconst MAX_CONTENT_LENGTH = 1000;\nconst ALLOWED_STATUSES = ['待处理', '进行中', '已完成'];\n\ndate_default_timezone_set('Asia/Shanghai');\n\nfunction writeDebugLog(string $operation, array $parameters, string $status, array $context = []): void\n{\n    $logDirectory = dirname(LOG_FILE);\n    if (!is_dir($logDirectory)) {\n        mkdir($logDirectory, 0775, true);\n    }\n\n    $entry = [\n        'timestamp' => date('Y-m-d H:i:s'),\n        'operation' => $operation,\n        'parameters' => $parameters,\n        'status' => $status,\n        'context' => $context,\n    ];\n\n    file_put_contents(\n        LOG_FILE,\n        json_encode($entry, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL,\n        FILE_APPEND | LOCK_EX\n    );\n}\n\nfunction escapeHtml(string $value): string\n{\n    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n}\n\nfunction normalizeTask(array $task, int $index): array\n{\n    $createdAt = isset($task['created_at']) && is_string($task['created_at']) && trim($task['created_at']) !== ''\n        ? trim($task['created_at'])\n        : '1970-01-01 00:00:00';\n\n    return [\n        'id' => isset($task['id']) && is_string($task['id']) && trim($task['id']) !== ''\n            ? trim($task['id'])\n            : 'task-' . $index,\n        'title' => isset($task['title']) && is_string($task['title'])\n            ? $task['title']\n            : '未命名任务',\n        'content' => isset($task['content']) && is_string($task['content'])\n            ? $task['content']\n            : '',\n        'status' => isset($task['status']) && is_string($task['status']) && trim($task['status']) !== ''\n            ? trim($task['status'])\n            : '待处理',\n        'created_at' => $createdAt,\n    ];\n}\n\nfunction stringLength(string $value): int\n{\n    if (function_exists('mb_strlen')) {\n        return mb_strlen($value, 'UTF-8');\n    }\n\n    return strlen($value);\n}\n\nfunction loadTasks(): array\n{\n    writeDebugLog('task_list_load', ['data_file' => basename(DATA_FILE)], 'started');\n\n    try {\n        if (!file_exists(DATA_FILE)) {\n            writeDebugLog('task_list_empty_data_file', ['data_file' => basename(DATA_FILE)], 'success', [\n                'reason' => 'data_file_missing',\n                'task_count' => 0,\n            ]);\n            return [];\n        }\n\n        $rawJson = file_get_contents(DATA_FILE);\n        if ($rawJson === false) {\n            writeDebugLog('task_list_read_exception', ['data_file' => basename(DATA_FILE)], 'failed', [\n                'reason' => 'file_get_contents_failed',\n            ]);\n            return [];\n        }\n\n        $trimmedJson = trim($rawJson);\n        if ($trimmedJson === '') {\n            writeDebugLog('task_list_empty_data', ['data_file' => basename(DATA_FILE)], 'success', [\n                'reason' => 'empty_file',\n                'task_count' => 0,\n            ]);\n            return [];\n        }\n\n        $decoded = json_decode($trimmedJson, true);\n        if (!is_array($decoded)) {\n            writeDebugLog('task_list_read_exception', ['data_file' => basename(DATA_FILE)], 'failed', [\n                'reason' => 'invalid_json',\n                'json_error' => json_last_error_msg(),\n            ]);\n            return [];\n        }\n\n        $tasks = [];\n        foreach ($decoded as $index => $task) {\n            if (is_array($task)) {\n                $tasks[] = normalizeTask($task, (int) $index);\n            }\n        }\n\n        usort($tasks, static function (array $left, array $right): int {\n            $rightTime = strtotime($right['created_at']) ?: 0;\n            $leftTime = strtotime($left['created_at']) ?: 0;\n            return $rightTime <=> $leftTime;\n        });\n\n        if (count($tasks) === 0) {\n            writeDebugLog('task_list_empty_data', ['data_file' => basename(DATA_FILE)], 'success', [\n                'reason' => 'no_valid_tasks',\n                'task_count' => 0,\n            ]);\n        }\n\n        writeDebugLog('task_list_load', ['data_file' => basename(DATA_FILE)], 'success', [\n            'task_count' => count($tasks),\n            'sort' => 'created_at_desc',\n        ]);\n\n        return $tasks;\n    } catch (Throwable $exception) {\n        writeDebugLog('task_list_read_exception', ['data_file' => basename(DATA_FILE)], 'failed', [\n            'reason' => 'unexpected_exception',\n            'message' => $exception->getMessage(),\n        ]);\n        return [];\n    }\n}\n\nfunction validateTaskInput(string $title, string $content, string $status): array\n{\n    $errors = [];\n    $trimmedTitle = trim($title);\n    $trimmedContent = trim($content);\n\n    if ($trimmedTitle === '') {\n        $errors['title'] = '任务标题不能为空。';\n    } elseif (stringLength($trimmedTitle) > MAX_TITLE_LENGTH) {\n        $errors['title'] = '任务标题不能超过 ' . MAX_TITLE_LENGTH . ' 个字符。';\n    }\n\n    if (stringLength($trimmedContent) > MAX_CONTENT_LENGTH) {\n        $errors['content'] = '任务内容不能超过 ' . MAX_CONTENT_LENGTH . ' 个字符。';\n    }\n\n    if (!in_array($status, ALLOWED_STATUSES, true)) {\n        $errors['status'] = '请选择有效的任务状态。';\n    }\n\n    return $errors;\n}\n\nfunction findTaskById(array $tasks, string $taskId): ?array\n{\n    foreach ($tasks as $task) {\n        if (($task['id'] ?? '') === $taskId) {\n            return $task;\n        }\n    }\n\n    return null;\n}\n\nfunction createTaskId(): string\n{\n    try {\n        return 'task-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n    } catch (Throwable $exception) {\n        return 'task-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n    }\n}\n\nfunction saveNewTask(array $task): bool\n{\n    $dataDirectory = dirname(DATA_FILE);\n    if (!is_dir($dataDirectory) && !mkdir($dataDirectory, 0775, true) && !is_dir($dataDirectory)) {\n        writeDebugLog('task_create_save_exception', [\n            'title_length' => stringLength((string) ($task['title'] ?? '')),\n            'status' => (string) ($task['status'] ?? ''),\n        ], 'failed', [\n            'reason' => 'data_directory_unavailable',\n            'directory' => $dataDirectory,\n        ]);\n        return false;\n    }\n\n    $handle = fopen(DATA_FILE, 'c+');\n    if ($handle === false) {\n        writeDebugLog('task_create_save_exception', [\n            'title_length' => stringLength((string) ($task['title'] ?? '')),\n            'status' => (string) ($task['status'] ?? ''),\n        ], 'failed', [\n            'reason' => 'data_file_open_failed',\n            'data_file' => basename(DATA_FILE),\n        ]);\n        return false;\n    }\n\n    try {\n        if (!flock($handle, LOCK_EX)) {\n            writeDebugLog('task_create_save_exception', [\n                'title_length' => stringLength((string) ($task['title'] ?? '')),\n                'status' => (string) ($task['status'] ?? ''),\n            ], 'failed', [\n                'reason' => 'file_lock_failed',\n","exit_code":0,"status":"completed"}}
