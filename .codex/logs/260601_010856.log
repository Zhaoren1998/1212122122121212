], 'failed', [\n                    'reason' => 'invalid_existing_json',\n                    'json_error' => json_last_error_msg(),\n                ]);\n                flock($handle, LOCK_UN);\n                fclose($handle);\n                return false;\n            }\n\n            foreach ($decoded as $index => $existingTask) {\n                if (is_array($existingTask)) {\n                    $existingTasks[] = normalizeTask($existingTask, (int) $index);\n                }\n            }\n        }\n\n        array_unshift($existingTasks, $task);\n        $encodedJson = json_encode($existingTasks, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n        if (!is_string($encodedJson)) {\n            writeDebugLog('task_create_save_exception', [\n                'task_id' => (string) ($task['id'] ?? ''),\n                'title_length' => stringLength((string) ($task['title'] ?? '')),\n                'status' => (string) ($task['status'] ?? ''),\n","exit_code":0,"status":"completed"}}

