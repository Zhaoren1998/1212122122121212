            : '待处理',\n        'created_at' => $createdAt,\n    ];\n}\n\nfunction stringLength(string $value): int\n{\n    if (function_exists('mb_strlen')) {\n        return mb_strlen($value, 'UTF-8');\n    }\n\n    return strlen($value);\n}\n\nfunction loadTasks(): array\n{\n    writeDebugLog('task_list_load', ['data_file' => basename(DATA_FILE)], 'started');\n\n    try {\n        if (!file_exists(DATA_FILE)) {\n            writeDebugLog('task_list_empty_data_file', ['data_file' => basename(DATA_FILE)], 'success', [\n                'reason' => 'data_file_missing',\n                'task_count' => 0,\n            ]);\n            return [];\n        }\n\n        $rawJson = file_get_contents(DATA_FILE);\n        if ($rawJson === false) {\n            writeDebugLog('task_list_read_exception', ['data_file' => basename(DATA_FILE)], 'failed', [\n                'reason' => 'file_get_contents_failed',\n            ]);\n            return [];\n        }\n\n        $trimmedJson = trim($rawJson);\n        if ($trimmedJson === '') {\n            writeDebugLog('task_list_empty_data', ['data_file' => basename(DATA_FILE)], 'success', [\n                'reason' => 'empty_file',\n                'task_count' => 0,\n            ]);\n            return [];\n        }\n\n        $decoded = json_decode($trimmedJson, true);\n        if (!is_array($decoded)) {\n            writeDebugLog('task_list_read_exception', ['data_file' => basename(DATA_FILE)], 'failed', [\n                'reason' => 'invalid_json',\n                'json_error' => json_last_error_msg(),\n            ]);\n            return [];\n        }\n\n        $tasks = [];\n        foreach ($decoded as $index => $task) {\n            if (is_array($task)) {\n                $tasks[] = normalizeTask($task, (int) $index);\n            }\n        }\n\n        usort($tasks, static function (array $left, array $right): int {\n            $rightTime = strtotime($right['created_at']) ?: 0;\n            $leftTime = strtotime($lef