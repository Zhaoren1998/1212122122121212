ask_edit_save_exception', [\n            'task_id' => $taskId,\n            'title_length' => stringLength($title),\n            'content_length' => stringLength($content),\n            'status' => $status,\n        ], 'failed', [\n            'reason' => 'data_directory_unavailable',\n            'directory' => $dataDirectory,\n        ]);\n        return 'exception';\n    }\n\n    $handle = fopen(DATA_FILE, 'c+');\n    if ($handle === false) {\n        writeDebugLog('task_edit_save_exception', [\n            'task_id' => $taskId,\n            'title_length' => stringLength($title),\n            'content_length' => stringLength($content),\n            'status' => $status,\n        ], 'failed', [\n            'reason' => 'data_file_open_failed',\n            'data_file' => basename(DATA_FILE),\n        ]);\n        return 'exception';\n    }\n\n    try {\n        if (!flock($handle, LOCK_EX)) {\n            writeDebugLog('task_edit_save_exception', [\n                'task_id' => $taskId,\n                'title_length' => stringLength($title),\n                'content_length' => stringLength($content),\n                'status' => $status,\n            ], 'failed', [\n                'reason' => 'file_lock_failed',\n                'data_file' => basename(DATA_FILE),\n            ]);\n            fclose($handle);\n            return 'exception';\n        }\n\n        rewind($handle);\n        $rawJson = stream_get_contents($handle);\n        $existingTasks = [];\n\n        if (is_string($rawJson) && trim($rawJson) !== '') {\n            $decoded = json_decode($rawJson, true);\n            if (!is_array($decoded)) {\n                writeDebugLog('task_edit_save_exception', [\n                    'task_id' => $taskId,\n                    'title_length' => stringLength($title),\n                    'content_length' => stringLength($content),\n                    'status' => $status,\n                ], 'failed', [\n                    'reason' => 'invalid_existing_