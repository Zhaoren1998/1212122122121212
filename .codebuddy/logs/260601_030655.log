       }\n1652→\n1653→            $trimmedJson = trim($rawJson);\n1654→            if ($trimmedJson !== '') {\n1655→                $decoded = json_decode($trimmedJson, true);\n1656→                if (!is_array($decoded)) {\n1657→                    throw new RuntimeException('旧 JSON 数据格式无效：' . json_last_error_msg());\n1658→                }\n1659→\n1660→                $statement = $pdo->prepare(\n1661→                    \"INSERT OR IGNORE INTO tasks\n1662→                    (id, title, content, status, priority, category_id, due_at, archived_at, deleted_at, created_at, updated_at)\n1663→                    VALUES\n1664→                    (:id, :title, :content, :status, :priority, NULL, NULL, NULL, NULL, :created_at, :updated_at)\"\n1665→                );\n1666→\n1667→                foreach ($decoded as $index => $legacyTask) {\n1668→                    if (!is_array($legacyTask)) {\n1669→                        $skippedCount++;\n1670→                        continue;\n1671→                    }\n1672→\n1673→                    $task = normalizeTask($legacyTask, (int) $index);\n1674→                    $statement->execute([\n1675→                        ':id' => $task['id'],\n1676→                        ':title' => $task['title'],\n1677→                        ':content' => $task['content'],\n1678→                        ':status' => normalizeTaskStatus($task['status']),\n1679→                        ':priority' => '中',\n1680→                        ':created_at' => $task['created_at'],\n1681→                        ':updated_at' => $task['updated_at'],\n1682→                    ]);\n1683→\n1684→                    if ($statement->rowCount() > 0) {\n1685→                        $migratedCount++;\n1686→                    } else {\n1687→                        $skippedCount++;\n1688→                    }\n1689→                }\n1690→            }\n1691→        }\n1692→\n1693→        upsertSystemSetting($pdo, 'legacy_json_migrated', '1');\n1694→        write