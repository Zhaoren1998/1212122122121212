Validation['error'];\n2788→    }\n2789→\n2790→    return $errors;\n2791→}\n2792→\n2793→function buildStatusCounts(array $tasks): array\n2794→{\n2795→    $counts = [];\n2796→    foreach (ALLOWED_STATUSES as $status) {\n2797→        $counts[$status] = 0;\n2798→    }\n2799→\n2800→    foreach ($tasks as $task) {\n2801→        $status = isset($task['status']) && is_string($task['status']) ? normalizeTaskStatus($task['status']) : '未开始';\n2802→        if (!isset($counts[$status])) {\n2803→            $counts[$status] = 0;\n2804→        }\n2805→        $counts[$status]++;\n2806→    }\n2807→\n2808→    return $counts;\n2809→}\n2810→\n2811→function findTaskById(array $tasks, string $taskId): ?array\n2812→{\n2813→    foreach ($tasks as $task) {\n2814→        if (($task['id'] ?? '') === $taskId) {\n2815→            return $task;\n2816→        }\n2817→    }\n2818→\n2819→    return null;\n2820→}\n2821→\n2822→function loadSubtasksForTask(PDO $pdo, string $taskId): array\n2823→{\n2824→    writeDebugLog('task_subtasks_load', [\n2825→        'task_id' => $taskId,\n2826→    ], 'started');\n2827→\n2828→    try {\n2829→        $statement = $pdo->prepare(\n2830→            \"SELECT id, task_id, title, is_completed, sort_order, created_at, updated_at\n2831→            FROM subtasks\n2832→            WHERE task_id = :task_id\n2833→            ORDER BY sort_order ASC, created_at ASC\"\n2834→        );\n2835→        $statement->execute([':task_id' => $taskId]);\n2836→        $rows = $statement->fetchAll();\n2837→        $statement->closeCursor();\n2838→\n2839→        $subtasks = [];\n2840→        foreach ($rows as $row) {\n2841→            if (!is_array($row)) {\n2842→                continue;\n2843→            }\n2844→            $subtasks[] = [\n2845→                'id' => isset($row['id']) && is_string($row['id']) ? trim($row['id']) : '',\n2846→                'task_id' => isset($row['task_id']) && is_string($row['task_id']) ? trim($row['task_id']) : '',\n2847→                'title' => isset($row['title']) && is_string($row['title']) ? trim($row['title']) : '',\n2848→                'is_completed' => isset($row['is_completed']) ? (int) $row['is_completed'] : 0,\n2849→                'sort_order' => isset($row['sort_order']) ? (int) $row['sort_order'] : 0,\n2850→                'created_at' => isset($row['created_at']) && is_string($row['created_at']) ? trim($row['created_at']) : '',\n2851→                'updated_at' => isset($row['updated_at']) && is_string($row['updated_at']) ? trim($row['updated_at']) : '',\n2852→            ];\n2853→        }\n2854→\n2855→        writeDebugLog('task_subtasks_load', [\n2856→            'task_id' => $taskId,\n2857→        ], 'success', [\n2858→            'subtask_count' => count($subtasks),\n2859→        ]);\n2860→\n2861→        return $subtasks;\n2862→    } catch (Throwable $exception) {\n2863→        writeDebugLog('task_subtasks_load', [\n2864→            'task_id' => $taskId,\n2865→        ], 'failed', [\n2866→            'reason' => 'database_query_exception',\n2867→            'message' => $exception->getMessage(),\n2868→        ]);\n2869→        return [];\n2870→    }\n2871→}\n2872→\n2873→const MAX_SUBTASK_TITLE_LENGTH = 200;\n2874→\n2875→function createSubtaskId(): string\n2876→{\n2877→    try {\n2878→        return 'subtask-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n2879→    } catch (Throwable $exception) {\n2880→        return 'subtask-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n2881→    }\n2882→}\n2883→\n2884→function validateSubtaskInput(string $title, string $parentTaskId, array $tasks): array\n2885→{\n2886→    $errors = [];\n2887→    $normalizedTitle = trim($title);\n2888→\n2889→    if ($normalizedTitle === '') {\n2890→        $errors['title'] = '子任务标题不能为空。';\n2891→        writeDebugLog('subtask_validation', [\n2892→            'parent_task_id' => $parentTaskId,\n2893→            'title_length' => 0,\n2894→        ], 'failed', [\n2895→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_1yzmo8klzvg5_1","__timestamp":"2026-05-31T19:08:21.748Z","_requestId":"4bde5eda72264241a555b1785a99d8a1"}

