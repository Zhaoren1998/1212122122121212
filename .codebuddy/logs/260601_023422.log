> $parameters,\n  44→        'status' => $status,\n  45→        'context' => $context,\n  46→    ];\n  47→\n  48→    file_put_contents(\n  49→        LOG_FILE,\n  50→        json_encode($entry, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL,\n  51→        FILE_APPEND | LOCK_EX\n  52→    );\n  53→    persistDebugLogToDatabase($entry);\n  54→}\n  55→\n  56→function persistDebugLogToDatabase(array $entry): void\n  57→{\n  58→    if (!empty($GLOBALS['isPersistingDebugLog']) || !empty($GLOBALS['suppressDatabaseDebugLog']) || !extension_loaded('pdo_sqlite')) {\n  59→        return;\n  60→    }\n  61→\n  62→    $GLOBALS['isPersistingDebugLog'] = true;\n  63→\n  64→    try {\n  65→        $dataDirectory = dirname(DB_FILE);\n  66→        if (!is_dir($dataDirectory) && !mkdir($dataDirectory, 0775, true) && !is_dir($dataDirectory)) {\n  67→            return;\n  68→        }\n  69→\n  70→        $pdo = new PDO('sqlite:' . DB_FILE);\n  71→        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n  72→        $pdo->exec('PRAGMA busy_timeout = 5000');\n  73→        $pdo->exec(\"CREATE TABLE IF NOT EXISTS operation_logs (\n  74→            id INTEGER PRIMARY KEY AUTOINCREMENT,\n  75→            operation TEXT NOT NULL,\n  76→            parameters_json TEXT NOT NULL DEFAULT '{}',\n  77→            status TEXT NOT NULL,\n  78→            context_json TEXT NOT NULL DEFAULT '{}',\n  79→            created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n  80→        )\");\n  81→\n  82→        $parametersJson = json_encode($entry['parameters'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n  83→        $contextJson = json_encode($entry['context'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n  84→        $statement = $pdo->prepare(\n  85→            'INSERT INTO operation_logs (operation, parameters_json, status, context_json, created_at)\n  86→            VALUES (:operation, :parameters_json, :status, :context_json, :created_at)'\n  87→        );\n  88→        $statement->execute([\n  89→            ':operation' => (string) ($entry['operation'] ?? 'unknown'),\n  90→            ':parameters_json' => is_string($parametersJson) ? $parametersJson : '{}',\n  91→            ':status' => (string) ($entry['status'] ?? 'unknown'),\n  92→            ':context_json' => is_string($contextJson) ? $contextJson : '{}',\n  93→            ':created_at' => (string) ($entry['timestamp'] ?? date('Y-m-d H:i:s')),\n  94→        ]);\n  95→    } catch (Throwable $exception) {\n  96→        $GLOBALS['lastDebugLogDatabaseError'] = $exception->getMessage();\n  97→    } finally {\n  98→        $GLOBALS['isPersistingDebugLog'] = false;\n  99→    }\n 100→}\n 101→\n 102→function escapeHtml(string $value): string\n 103→{\n 104→    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n 105→}\n 106→\n 107→function normalizeTaskStatus(string $status, string $fallback = '未开始'): string\n 108→{\n 109→    $trimmedStatus = trim($status);\n 110→    if (isset(LEGACY_STATUS_MAP[$trimmedStatus])) {\n 111→        return LEGACY_STATUS_MAP[$trimmedStatus];\n 112→    }\n 113→\n 114→    if (in_array($trimmedStatus, ALLOWED_STATUSES, true)) {\n 115→        return $trimmedStatus;\n 116→    }\n 117→\n 118→    return in_array($fallback, ALLOWED_STATUSES, true) ? $fallback : '未开始';\n 119→}\n 120→\n 121→function isAllowedTaskStatus(string $status): bool\n 122→{\n 123→    return in_array(trim($status), ALLOWED_STATUSES, true);\n 124→}\n 125→\n 126→function normalizeTaskPriority(string $priority, string $fallback = DEFAULT_TASK_PRIORITY): string\n 127→{\n 128→    $trimmedPriority = trim($priority);\n 129→    if (in_array($trimmedPriority, ALLOWED_PRIORITIES, true)) {\n 130→        return $trimmedPriority;\n 131→    }\n 132→\n 133→    return in_array($fallback, ALLOWED_PRIORITIES, true) ? $fallback : DEFAULT_TASK_PRIORITY;\n 134→}\n 135→\n 136→function isAllowedTaskPriority(string $priority): bool\n 137→{\n 138→    return in_array(trim($priority), ALLOWED_PRIORITIES, true);\n 139→}\n 140→\n 141→function getPriorityBadgeClass(string $priority): string\n 142→{\n 143→    $normalizedPriority = normalizeTaskPriority($priority);\n 144→    if ($normalizedPriority === '高') {\n 145→        return 'priority-high';\n 146→    }\n 147→    if ($normalizedPriority === '低') {\n 148→        return 'priority-low';\n 149→    }\n 150→\n 151→    return 'priority-medium';\n 152→}\n 153→\n 154→function normalizeStoredDueAt($dueAt): string\n 155→{\n 156→    if (!is_string($dueAt)) {\n 157→        return '';\n 158→    }\n 159→\n 160→    $trimmedDueAt = trim($dueAt);\n 161→    if ($trimmedDueAt === '') {\n 162→        return '';\n 163→    }\n 164→\n 165→    $dateTime = DateTimeImmutable::createFromFormat('Y-m-d H:i:s', $trimmedDueAt);\n 166→    $dateErrors = DateTimeImmutable::getLastErrors();\n 167→    if ($dateTime instanceof DateTimeImmutable && $dateErrors === false) {\n 168→        return $dateTime->format('Y-m-d H:i:s');\n 169→    }\n 170→\n 171→    $timestamp = strtotime($trimmedDueAt);\n 172→    if ($timestamp === false) {\n 173→        return '';\n 174→    }\n 175→\n 176→    return date('Y-m-d H:i:s', $timestamp);\n 177→}\n 178→\n 179→function validateDueAtInput(string $dueAtInput): array\n 180→{\n 181→    $trimmedDueAt = trim($dueAtInput);\n 182→    if ($trimmedDueAt === '') {\n 183→        writeDebugLog('task_due_at_validation', [\n 184→            'submitted_due_at' => $dueAtInput,\n 185→        ], 'success', [\n 186→            'result' => 'empty_due_at_allowed',\n 187→            'normalized_due_at' => '',\n 188→        ]);\n 189→        return [\n 190→            'valid' => true,\n 191→            'normalized' => '',\n 192→            'error' => '',\n 193→            'reason' => 'empty_due_at_allowed',\n 194→        ];\n 195→    }\n 196→\n 197→    $dateTime = DateTimeImmutable::createFromFormat('Y-m-d\\TH:i', $trimmedDueAt);\n 198→    $dateErrors = DateTimeImmutable::getLastErrors();\n 199→    if (!$dateTime instanceof DateTimeImmutable || $dateErrors !== false) {\n 200→        writeDebugLog('task_due_at_validation', [\n 201→            'submitted_due_at' => $dueAtInput,\n 202→        ], 'failed', [\n 203→            'reason' => 'invalid_datetime_format',\n 204→            'expected_format' => 'Y-m-dTH:i',\n 205→            'database_write_blocked' => true,\n 206→        ]);\n 207→        return [\n 208→            'valid' => false,\n 209→            'normalized' => '',\n 210→            'error' => '截止日期时间格式无效，请使用页面日期时间控件选择。',\n 211→            'reason' => 'invalid_datetime_format',\n 212→        ];\n 213→    }\n 214→\n 215→    $minDateTime = new DateTimeImmutable(MIN_DUE_AT);\n 216→    $maxDateTime = new DateTimeImmutable(MAX_DUE_AT);\n 217→    if ($dateTime < $minDateTime || $dateTime > $maxDateTime) {\n 218→        writeDebugLog('task_due_at_validation', [\n 219→            'submitted_due_at' => $dueAtInput,\n 220→            'normalized_due_at' => $dateTime->format('Y-m-d H:i:s'),\n 221→        ], 'failed', [\n 222→            'reason' => 'datetime_out_of_allowed_range',\n 223→            'min_due_at' => MIN_DUE_AT,\n 224→            'max_due_at' => MAX_DUE_AT,\n 225→            'database_write_blocked' => true,\n 226→        ]);\n 227→        return [\n 228→            'valid' => false,\n 229→            'normalized' => '',\n 230→            'error' => '截止日期时间必须在 2000-01-01 00:00 到 2100-12-31 23:59 之间。',\n 231→            'reason' => 'datetime_out_of_allowed_range',\n 232→        ];\n 233→    }\n 234→\n 235→    $normalizedDueAt = $dateTime->format('Y-m-d H:i:s');\n 236→    writeDebugLog('task_due_at_validation', [\n 237→        'submitted_due_at' => $dueAtInput,\n 238→        'normalized_due_at' => $normalizedDueAt,\n 239→    ], 'success', [\n 240→        'result' => 'valid_due_at',\n 241→        'min_due_at' => MIN_DUE_AT,\n 242→        'max_due_at' => MAX_DUE_AT,\n 243→    ]);\n 244→\n 245→    return [\n 246→        'valid' => true,\n 247→        'normalized' => $normalizedDueAt,\n 248→        'error' => '',\n 249→        'reason' => 'valid_due_at',\n 250→    ];\n 251→}\n 252→\n 253→function formatDueAtForInput(string $dueAt): string\n 254→{\n 255→    $normalizedDueAt = normalizeStoredDueAt($dueAt);\n 256→    if ($normalizedDueAt === '') {\n 257→        return '';\n 258→    }\n 259→\n 260→    $timestamp = strtotime($normalizedDueAt);\n 261→    return $timestamp === false ? '' : date('Y-m-d\\TH:i', $timestamp);\n 262→}\n 263→\n 264→function buildDueAtState(array $task, string $source): array\n 265→{\n 266→    $taskId = isset($task['id']) && is_string($task['id']) ? $task['id'] : '';\n 267→    $dueAt = normalizeStoredDueAt($task['due_at'] ?? '');\n 268→    $nowTimestamp = time();\n 269→    $todayStart = strtotime(date('Y-m-d 00:00:00', $nowTimestamp));\n 270→    $todayEnd = strtotime(date('Y-m-d 23:59:59', $nowTimestamp));\n 271→\n 272→    if ($dueAt === '') {\n 273→        writeDebugLog('task_due_at_status_calculate', [\n 274→            'task_id' => $taskId,\n 275→            'due_at' => '',\n 276→            'source' => $source,\n 277→        ], 'success', [\n 278→            'result_status' => '未设置',\n 279→            'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 280→            'has_due_at' => false,\n 281→        ]);\n 282→        return [\n 283→            'label' => '未设置',\n 284→            'class' => 'due-none',\n 285→            'description' => '未设置截止时间',\n 286→            'datetime' => '',\n 287→        ];\n 288→    }\n 289→\n 290→    $dueTimestamp = strtotime($dueAt);\n 291→    if ($dueTimestamp === false) {\n 292→        writeDebugLog('task_due_at_status_calculate', [\n 293→            'task_id' => $taskId,\n 294→            'due_at' => $dueAt,\n 295→            'source' => $source,\n 296→        ], 'failed', [\n 297→            'reason' => 'stored_due_at_unparseable',\n 298→            'result_status' => '无效日期',\n 299→            'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 300→        ]);\n 301→        return [\n 302→            'label' => '无效日期',\n 303→            'class' => 'due-invalid',\n 304→            'description' => '截止时间格式异常',\n 305→            'datetime' => $dueAt,\n 306→        ];\n 307→    }\n 308→\n 309→    if ($dueTimestamp < $nowTimestamp) {\n 310→        $label = '已逾期';\n 311→        $class = 'due-overdue';\n 312→    } elseif ($todayStart !== false && $todayEnd !== false && $dueTimestamp >= $todayStart && $dueTimestamp <= $todayEnd) {\n 313→        $label = '今日到期';\n 314→        $class = 'due-today';\n 315→    } else {\n 316→        $label = '未到期';\n 317→        $class = 'due-future';\n 318→    }\n 319→\n 320→    writeDebugLog('task_due_at_status_calculate', [\n 321→        'task_id' => $taskId,\n 322→        'due_at' => $dueAt,\n 323→        'source' => $source,\n 324→    ], 'success', [\n 325→        'result_status' => $label,\n 326→        'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 327→        'due_timestamp' => $dueTimestamp,\n 328→        'has_due_at' => true,\n 329→    ]);\n 330→\n 331→    return [\n 332→        'label' => $label,\n 333→        'class' => $class,\n 334→        'description' => formatDateTime($dueAt),\n 335→        'datetime' => $dueAt,\n 336→    ];\n 337→}\n 338→\n 339→function normalizeTask(array $task, int $index): array\n 340→{\n 341→    $createdAt = isset($task['created_at']) && is_string($task['created_at']) && trim($task['created_at']) !== ''\n 342→        ? trim($task['created_at'])\n 343→        : '1970-01-01 00:00:00';\n 344→    $updatedAt = isset($task['updated_at']) && is_string($task['updated_at']) && trim($task['updated_at']) !== ''\n 345→        ? trim($task['updated_at'])\n 346→        : $createdAt;\n 347→\n 348→    $rawStatus = isset($task['status']) && is_string($task['status']) && trim($task['status']) !== ''\n 349→        ? trim($task['status'])\n 350→        : '未开始';\n 351→    $rawPriority = isset($task['priority']) && is_string($task['priority']) && trim($task['priority']) !== ''\n 352→        ? trim($task['priority'])\n 353→        : DEFAULT_TASK_PRIORITY;\n 354→\n 355→    return [\n 356→        'id' => isset($task['id']) && is_string($task['id']) && trim($task['id']) !== ''\n 357→            ? trim($task['id'])\n 358→            : 'task-' . $index,\n 359→        'title' => isset($task['title']) && is_string($task['title'])\n 360→            ? $task['title']\n 361→            : '未命名任务',\n 362→        'content' => isset($task['content']) && is_string($task['content'])\n 363→            ? $task['content']\n 364→            : '',\n 365→        'status' => normalizeTaskStatus($rawStatus),\n 366→        'priority' => normalizeTaskPriority($rawPriority),\n 367→        'category_id' => isset($task['category_id']) && is_string($task['category_id'])\n 368→            ? trim($task['category_id'])\n 369→            : '',\n 370→        'category_name' => isset($task['category_name']) && is_string($task['category_name'])\n 371→            ? trim($task['category_name'])\n 372→            : '',\n 373→        'due_at' => normalizeStoredDueAt($task['due_at'] ?? ''),\n 374→        'created_at' => $createdAt,\n 375→        'updated_at' => $updatedAt,\n 376→        'archived_at' => isset($task['archived_at']) && is_string($task['archived_at'])\n 377→            ? trim($task['archived_at'])\n 378→            : '',\n 379→    ];\n 380→}\n 381→\n 382→function stringLength(string $value): int\n 383→{\n 384→    if (function_exists('mb_strlen')) {\n 385→        return mb_strlen($value, 'UTF-8');\n 386→    }\n 387→\n 388→    return strlen($value);\n 389→}\n 390→\n 391→function normalizeSearchText(string $value): string\n 392→{\n 393→    $normalized = preg_replace('/\\s+/u', ' ', trim($value));\n 394→    if (!is_string($normalized)) {\n 395→        $normalized = trim($value);\n 396→    }\n 397→\n 398→    return function_exists('mb_strtolower') ? mb_strtolower($normalized, 'UTF-8') : strtolower($normalized);\n 399→}\n 400→\n 401→function stringContainsInsensitive(string $haystack, st