d,\n 455→    ], 'started');\n 456→\n 457→    $pdo = new PDO('sqlite:' . DB_FILE);\n 458→    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n 459→    $pdo->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);\n 460→    $pdo->exec('PRAGMA foreign_keys = ON');\n 461→    $pdo->exec('PRAGMA busy_timeout = 5000');\n 462→\n 463→    writeDebugLog('database_connection_open', [\n 464→        'database_file' => basename(DB_FILE),\n 465→        'database_existed' => $databaseExisted,\n 466→    ], 'success');\n 467→\n 468→    return $pdo;\n 469→}\n 470→\n 471→function getDatabaseConnection(): PDO\n 472→{\n 473→    static $pdo = null;\n 474→    static $schemaReady = false;\n 475→\n 476→    if (!$pdo instanceof PDO) {\n 477→        $pdo = createDatabaseConnection();\n 478→    }\n 479→\n 480→    if (!$schemaReady) {\n 481→        initializeDatabaseSchema($pdo);\n 482→        ensureTaskCategorySchema($pdo);\n 483→        ensureTaskDeadlineSchema($pdo);\n 484→        ensureTaskPrioritySchema($pdo);\n 485→        migrateLegacyTasksJson($pdo);\n 486→        migrateTaskStatuses($pdo);\n 487→        migrateTaskPriorities($pdo);\n 488→        $schemaReady = true;\n 489→    }\n 490→\n 491→    return $pdo;\n 492→}\n 493→\n 494→function initializeDatabaseSchema(PDO $pdo): void\n 495→{\n 496→    writeDebugLog('database_schema_initialize', [\n 497→        'database_file' => basename(DB_FILE),\n 498→    ], 'started');\n 499→\n 500→    try {\n 501→        $GLOBALS['suppressDatabaseDebugLog'] = true;\n 502→        $pdo->beginTransaction();\n 503→\n 504→        $statements = [\n 505→            'categories' => \"CREATE TABLE IF NOT EXISTS categories (\n 506→                id TEXT PRIMARY KEY,\n 507→                name TEXT NOT NULL UNIQUE,\n 508→                color TEXT NOT NULL DEFAULT '#2563eb',\n 509→                sort_order INTEGER NOT NULL DEFAULT 0,\n 510→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 511→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 512→            )\",\n 513→            'tasks' => \"CREATE TABLE IF NOT EXISTS tasks (\n 514→                id TEXT PRIMARY KEY,\n 515→                title TEXT NOT NULL,\n 516→                content TEXT NOT NULL DEFAULT '',\n 517→                status TEXT NOT NULL DEFAULT '待处理',\n 518→                priority TEXT NOT NULL DEFAULT '中',\n 519→                category_id TEXT NULL,\n 520→                due_at TEXT NULL,\n 521→                archived_at TEXT NULL,\n 522→                deleted_at TEXT NULL,\n 523→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 524→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 525→                FOREIGN KEY (category_id) REFERENCES categories(id) ON UPDATE CASCADE ON DELETE SET NULL\n 526→            )\",\n 527→            'tags' => \"CREATE TABLE IF NOT EXISTS tags (\n 528→                id TEXT PRIMARY KEY,\n 529→                name TEXT NOT NULL UNIQUE,\n 530→                color TEXT NOT NULL DEFAULT '#667085',\n 531→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 532→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 533→            )\",\n 534→            'task_tags' => \"CREATE TABLE IF NOT EXISTS task_tags (\n 535→                task_id TEXT NOT NULL,\n 536→                tag_id TEXT NOT NULL,\n 537→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 538→                PRIMARY KEY (task_id, tag_id),\n 539→                FOREIGN KEY (task_id) REFERENCES tasks(id) ON UPDATE CASCADE ON DELETE CASCADE,\n 540→                FOREIGN KEY (tag_id) REFERENCES tags(id) ON UPDATE CASCADE ON DELETE CASCADE\n 541→            )\",\n 542→            'subtasks' => \"CREATE TABLE IF NOT EXISTS subtasks (\n 543→                id TEXT PRIMARY KEY,\n 544→                task_id TEXT NOT NULL,\n 545→     