 => basename(DB_FILE),\n 792→            'column' => 'priority',\n 793→        ], 'failed', [\n 794→            'reason' => 'priority_schema_exception',\n 795→            'message' => $exception->getMessage(),\n 796→        ]);\n 797→        throw $exception;\n 798→    }\n 799→}\n 800→\n 801→function upsertSystemSetting(PDO $pdo, string $key, string $value): void\n 802→{\n 803→    $statement = $pdo->prepare(\n 804→        \"INSERT INTO system_settings (setting_key, setting_value, created_at, updated_at)\n 805→        VALUES (:setting_key, :setting_value, datetime('now', 'localtime'), datetime('now', 'localtime'))\n 806→        ON CONFLICT(setting_key) DO UPDATE SET\n 807→            setting_value = excluded.setting_value,\n 808→            updated_at = datetime('now', 'localtime')\"\n 809→    );\n 810→    $statement->execute([\n 811→        ':setting_key' => $key,\n 812→        ':setting_value' => $value,\n 813→    ]);\n 814→}\n 815→\n 816→function getSystemSetting(PDO $pdo, string $key): ?string\n 817→{\n 818→    $statement = $pdo->prepare('SELECT setting_value FROM system_settings WHERE setting_key = :setting_key LIMIT 1');\n 819→    $statement->execute([':setting_key' => $key]);\n 820→    $value = $statement->fetchColumn();\n 821→\n 822→    return is_string($value) ? $value : null;\n 823→}\n 824→\n 825→function migrateLegacyTasksJson(PDO $pdo): void\n 826→{\n 827→    if (getSystemSetting($pdo, 'legacy_json_migrated') === '1') {\n 828→        return;\n 829→    }\n 830→\n 831→    writeDebugLog('database_legacy_json_migration', [\n 832→        'data_file' => basename(DATA_FILE),\n 833→        'database_file' => basename(DB_FILE),\n 834→    ], 'started');\n 835→\n 836→    $migratedCount = 0;\n 837→    $skippedCount = 0;\n 838→\n 839→    try {\n 840→        if (file_exists(DATA_FILE)) {\n 841→            $rawJson = file_get_contents(DATA_FILE);\n 842→            if ($rawJson === false) {\n 843→                throw new RuntimeException('旧 JSON 数据文件读取失败。');\n 844→            }\n 845→\n 846→            $trimmedJson = trim($rawJson);\n 847→            if ($trimmedJson !== '') {\n 848→                $decoded = json_decode($trimmedJson, true);\n 849→                if (!is_array($decoded)) {\n 850→                    throw new RuntimeException('旧 JSON 数据格式无效：' . json_last_error_msg());\n 851→                }\n 852→\n 853→                $statement = $pdo->prepare(\n 854→                    \"INSERT OR IGNORE INTO tasks\n 855→                    (id, title, content, status, priority, category_id, due_at, archived_at, deleted_at, created_at, updated_at)\n 856→                    VALUES\n 857→                    (:id, :title, :content, :status, :priority, NULL, NULL, NULL, NULL, :created_at, :updated_at)\"\n 858→                );\n 859→\n 860→                foreach ($decoded as $index => $legacyTask) {\n 861→                    if (!is_array($legacyTask)) {\n 862→                        $skippedCount++;\n 863→                        continue;\n 864→                    }\n 865→\n 866→                    $task = normalizeTask($legacyTask, (int) $index);\n 867→                    $statement->execute([\n 868→                        ':id' => $task['id'],\n 869→                        ':title' => $task['title'],\n 870→                        ':content' => $task['content'],\n 871→                        ':status' => normalizeTaskStatus($task['status']),\n 872→                        ':priority' => '中',\n 873→                        ':created_at' => $task['created_at'],\n 874→                        ':updated_at' => $task['updated_at'],\n 875→                    ]);\n 876→\n 877→                    if ($statement->rowCount() > 0) {\n 878→                        $migratedCount++;\n 879→                    } else {\n 880→                        $skippedCount++;\n 881→                    }\n 882→                }\n 883→            }\n 884→        }\n 885→\n 886→        upsertSystemSetting($pdo, 'legacy_json_migrated', '1');\n 887→        writeDebugLog('database_legacy_json_migration', [\n 888→            'data_file' => basename(DATA_FILE),\n 889→            'database_file' => basename(DB_FILE),\n 890→        ], 'success', [\n 891→            'migrated_count' => $migratedCount,\n 892→            'skipped_count' => $skippedCount,\n 893→        ]);\n 894→    } catch (Throwable $exception) {\n 895→        writeDebugLog('database_legacy_json_migration', [\n 896→            'data_file' => basename(DATA_FILE),\n 897→            'database_file' => basename(DB_FILE),\n 898→        ], 'failed', [\n 899→            'reason' => 'migration_exception',\n 900→            'message' => $exception->getMessage(),\n 901→            'migrated_count' => $migratedCount,\n 902→            'skipped_count' => $skippedCount,\n 903→        ]);\n 904→        throw $exception;\n 905→    }\n 906→}\n 907→\n 908→function migrateTaskStatuses(PDO $pdo): void\n 909→{\n 910→    if (getSystemSetting($pdo, 'task_status_migrated_v2') === '1') {\n 911→        return;\n 912→    }\n 913→\n 914→    writeDebugLog('task_status_migration', [\n 915→        'database_file' => basename(DB_FILE),\n 916→        'allowed_statuses' => ALLOWED_STATUSES,\n 917→        'legacy_statuses' => array_keys(LEGACY_STATUS_MAP),\n 918→    ], 'started');\n 919→\n 920→    try {\n 921→        $statement = $pdo->query('SELECT id, status, archived_at FROM tasks WHERE deleted_at IS NULL');\n 922→        $rows = $statement !== false ? $statement->fetchAll() : [];\n 923→        $updatedCount = 0;\n 924→        $invalidCount = 0;\n 925→        $now = date('Y-m-d H:i:s');\n 926→        $updateStatement = $pdo->prepare(\n 927→            'UPDATE tasks\n 928→            SET status = :status,\n 929→                archived_at = :archived_at,\n 930→                updated_at = :updated_at\n 931→            WHERE id = :id'\n 932→        );\n 933→\n 934→        foreach ($rows as $row) {\n 935→            if (!is_array($row)) {\n 936→                continue;\n 937→            }\n 938→\n 939→            $taskId = isset($row['id']) && is_string($row['id']) ? $row['id'] : '';\n 940→            $rawStatus = isset($row['status']) && is_string($row['status']) ? trim($row['status']) : '';\n 941→            $normalizedStatus = normalizeTaskStatus($rawStatus);\n 942→            $archivedAt = isset($row['archived_at']) && is_string($row['archived_at']) ? trim($row['archived_at']) : '';\n 943→\n 944→            if ($taskId === '') {\n 945→                continue;\n 946→            }\n 947→\n 948→            if ($rawStatus !== $normalizedStatus) {\n 949→                $invalidCount++;\n 950→                writeDebugLog('task_status_read_exception', [\n 951→                    'task_id' => $taskId,\n 952→                    'raw_status' => $rawStatus,\n 953→                ], 'failed', [\n 954→                    'reason' => 'status_outside_allowed_enum',\n 955→                    'normalized_status' => $normalizedStatus,\n 956→                    'allowed_statuses' => ALLOWED_STATUSES,\n 957→                ]);\n 958→            }\n 959→\n 960→            $targetArchivedAt = $normalizedStatus === '已归档'\n 961→                ? ($archivedAt !== '' ? $archivedAt : $now)\n 962→                : null;\n 963→\n 964→            if ($rawStatus !== $normalizedStatus || ($normalizedStatus !== '已归档' && $archivedAt !== '') || ($normalizedStatus === '已归档' && $archivedAt === '')) {\n 965→                $updateStatement->execute([\n 966→                    ':status' => $normalizedStatus,\n 967→                    ':archived_at' => $targetArchivedAt,\n 968→                    ':updated_at' => $now,\n 969→                    ':id' => $taskId,\n 970→                ]);\n 971→                $updatedCount += $updateStatement->rowCount();\n 972→            }\n 973→        }\n 974→\n 975→        upsertSystemSetting($pdo, 'task_status_migrated_v2', '1');\n 976→        writeDebugLog('task_status_migration', [\n 977→            'database_file' => basename(DB_FILE),\n 978→        ], 'success', [\n 979→            'scanned_count' => count($rows),\n 980→            'updated_count' => $updatedCount,\n 981→            'invalid_status_count' => $invalidCount,\n 982→            'allowed_statuses' => ALLOWED_STATUSES,\n 983→        ]);\n 984→    } catch (Throwable $exception) {\n 985→        writeDebugLog('task_status_migration', [\n 986→            'database_file' => basename(DB_FILE),\n 987→        ], 'failed', [\n 988→            'reason' => 'status_migration_exception',\n 989→            'message' => $exception->getMessage(),\n 990→        ]);\n 991→        throw $exception;\n 992→    }\n 993→}\n 994→\n 995→function migrateTaskPriorities(PDO $pdo): void\n 996→{\n 997→    if (getSystemSetting($pdo, 'task_priority_migrated_v1') === '1') {\n 998→        return;\n 999→    }\n1000→\n1001→    writeDebugLog('task_priority_migration', [\n1002→        'database_file' => basename(DB_FILE),\n1003→        'allowed_priorities' => ALLOWED_PRIORITIES,\n1004→        'default_priority' => DEFAULT_TASK_PRIORITY,\n1005→    ], 'started');\n1006→\n1007→    try {\n1008→        $statement = $pdo->query('SELECT id, priority FROM tasks WHERE deleted_at IS NULL');\n1009→        $rows = $statement !== false ? $statement->fetchAll() : [];\n1010→        $updatedCount = 0;\n1011→        $invalidCount = 0;\n1012→        $now = date('Y-m-d H:i:s');\n1013→        $updateStatement = $pdo->prepare(\n1014→            'UPDATE tasks\n1015→            SET priority = :priority,\n1016→                updated_at = :updated_at\n1017→            WHERE id = :id'\n1018→        );\n1019→\n1020→        foreach ($rows as $row) {\n1021→            if (!is_array($row)) {\n1022→                continue;\n1023→            }\n1024→\n1025→            $taskId = isset($row['id']) && is_string($row['id']) ? $row['id'] : '';\n1026→            $rawPriority = isset($row['priority']) && is_string($row['priority']) ? trim($row['priority']) : '';\n1027→            $normalizedPriority = normalizeTaskPriority($rawPriority);\n1028→\n1029→            if ($taskId === '') {\n1030→                continue;\n1031→            }\n1032→\n1033→            if ($rawPriority !== $normalizedPriority) {\n1034→                $invalidCount++;\n1035→                writeDebugLog('task_priority_read_exception', [\n1036→                    'task_id' => $taskId,\n1037→                    'raw_priority' => $rawPriority,\n1038→                ], 'failed', [\n1039→                    'reason' => 'priority_outside_allowed_enum',\n1040→                    'normalized_priority' => $normalizedPriority,\n1041→                    'allowed_priorities' => ALLOWED_PRIORITIES,\n1042→                ]);\n1043→\n1044→                $updateStatement->execute([\n1045→                    ':priority' => $normalizedPriority,\n1046→                    ':updated_at' => $now,\n1047→                    ':id' => $taskId,\n1048→                ]);\n1049→                $updatedCount += $updateStatement->rowCount();\n1050→            }\n1051→        }\n1052→\n1053→        upsertSystemSetting($pdo, 'task_priority_migrated_v1', '1');\n1054→        writeDebugLog('task_priority_migration', [\n1055→            'database_file' => basename(DB_FILE),\n1056→        ], 'success', [\n1057→            'scanned_count' => count($rows),\n1058→            'updated_count' => $updatedCount,\n1059→            'invalid_priority_count' => $invalidCount,\n1060→            'allowed_priorities' => ALLOWED_PRIORITIES,\n1061→        ]);\n1062→    } catch (Throwable $exception) {\n1063→        writeDebugLog('task_priority_migration', [\n1064→            'database_file' => basename(DB_FILE),\n1065→        ], 'failed', [\n1066→            'reason' => 'priority_migration_exception',\n1067→            'message' => $exception->getMessage(),\n1068→        ]);\n1069→        throw $exception;\n1070→    }\n1071→}\n1072→\n1073→function normalizeFilterParameters(array $query): array\n1074→{\n1075→    $rawKeyword = isset($query['keyword']) && is_string($query['keyword']) ? $query['keyword'] : '';\n1076→    $rawStatus = isset($query['status']) && is_string($query['status']) ? $query['status'] : '';\n1077→    $rawPriority = isset($query['priority']) && is_string($query['priority']) ? $query['priority'] : '';\n1078→    $rawTagId = isset($query['tag_id']) && is_string($query['tag_id']) ? $query['tag_id'] : '';\n1079→    $keyword = trim($rawKeyword);\n1080→    $status = trim($rawStatus);\n1081→    $priority = trim($rawPriority);\n1082→    $tagId = trim($rawTagId);\n1083→    $errors = [];\n1084→\n1085→    if (stringLength($keyword) > MAX_SEARCH_KEYWORD_LENGTH) {\n1086→        $errors['keyword'] = '关键词不能超过 ' . MAX_SEARCH_KEYWORD_LENGTH . ' 个字符，已自动截断后搜索。';\n1087→        if (function_exists('mb_substr')) {\n1088→            $keyword = mb_substr($keyword, 0, MAX_SEARCH_KEYWORD_LENGTH, 'UTF-8');\n1089→        } else {\n1090→            $keyword = substr($keyword, 0, MAX_SEARCH_KEYWORD_LENGTH);\n1091→        }\n1092→    }\n1093→\n1094→    if ($status !== '' && !isAllowedTaskStatus($status)) {\n1095→        $errors['status'] = '状态筛选参数无效，已忽略该条件。';\n1096→        $status = '';\n1097→    }\n1098→\n1099→    if ($priority !== '' && !isAllowedTaskPriority($priority)) {\n1100→        $errors['priority'] = '优先级筛选参数无效，已忽略该条件。';\n1101→        $priority = '';\n1102→    }\n1103→\n1104→    if ($tagId !== '' && !preg_match('/^tag-\\d+-[a-f0-9]+$/', $tagId)) {\n1105→        $errors['tag_id'] = '标签筛选参数无效，已忽略该条件。';\n1106→        $tagId = '';\n1107→    }\n1108→\n1109→    return [\n1110→        'keyword' => $keyword,\n1111→        'status' => $status,\n1112→        'priority' => $priority,\n1113→        'tag_id' => $tagId,\n1114→        'errors' => $errors,\n1115→        'raw_keyword_length' => stringLength($rawKeyword),\n1116→        'raw_status' => $rawStatus,\n1117→        'raw_priority' => $rawPriority,\n1118→        'raw_tag_id' => $rawTagId,\n1119→    ];\n1120→}\n1121→\n1122→function filterTasks(array $tasks, string $keyword, string $status, string $priority, string $tagId = ''): array\n1123→{\n1124→    if ($keyword === '' && $status === '' && $priority === '' && $tagId === '') {\n1125→        return $tasks;\n1126→    }\n1127→\n1128→    $filteredTasks = [];\n1129→    foreach ($tasks as $task) {\n1130→        $matchesKeyword = $keyword === ''\n1131→            || stringContainsInsensitive((string) ($task['title'] ?? ''), $keyword)\n1132→            || stringContainsInsensitive((string) ($task['content'] ?? ''), $keyword);\n1133→        $matchesStatus = $status === '' || (string) ($task['status'] ?? '') === $status;\n1134→        $matchesPriority = $priority === '' || normalizeTaskPriority((string) ($task['priority'] ?? '')) === $priority;\n1135→        $matchesTag = $tagId === '' || in_array($tagId, $task['tag_ids'] ?? [], true);\n1136→\n1137→        if ($matchesKeyword && $matchesStatus && $matchesPriority && $matchesTag) {\n1138→            $filteredTasks[] = $task;\n1139→        }\n1140→    }\n1141→\n1142→    return $filteredTasks;\n1143→}\n1144→\n1145→function normalizeSortParameters(array $query): array\n1146→{\n1147→    $rawSortBy = isset($query['sort_by']) && is_string($query['sort_by']) ? trim($query['sort_by']) : '';\n1148→    $rawSortOrder = isset($query['sort_order']) && is_string($query['sort_order']) ? trim($query['sort_order']) : '';\n1149→    $sortBy = $rawSortBy;\n1150→    $sortOrder = $rawSortOrder;\n1151→    $errors = [];\n1152→\n1153→    if ($rawSortBy !== '' && !in_array($rawSortBy, ALLOWED_SORT_FIELDS, true)) {\n1154→        $errors['sort_by'] = '排序字段参数无效，已使用默认排序。';\n1155→        $sortBy = DEFAULT_SORT_FIELD;\n1156→        writeDebugLog('task_sort_parameter_exception', [\n1157→            'submitted_sort_by' => $rawSortBy,\n1158→        ], 'failed', [\n1159→            'reason' => 'invalid_sort_field',\n1160→            'allowed_fields' => ALLOWED_SORT_FIELDS,\n1161→            'default_field_applied' => DEFAULT_SORT_FIELD,\n1162→        ]);\n1163→    }\n1164→\n1165→    if ($rawSortOrder !== '' && !in_array($rawSortOrder, ALLOWED_SORT_ORDERS, true)) {\n1166→        $errors['sort_order'] = '排序方向参数无效，已使用默认排序。';\n1167→        $sortOrder = DEFAULT_SORT_ORDER;\n1168→        writeDebugLog('task_sort_parameter_exception', [\n1169→            'submitted_sort_order' => $rawSortOrder,\n1170→        ], 'failed', [\n1171→            'reason' => 'invalid_sort_order',\n1172→            'allowed_orders' => ALLOWED_SORT_ORDERS,\n1173→            'default_order_applied' => DEFAULT_SORT_ORDER,\n1174→        ]);\n1175→    }\n1176→\n1177→    if ($sortBy === '') {\n1178→        $sortBy = DEFAULT_SORT_FIELD;\n1179→    }\n1180→    if ($sortOrder === '') {\n1181→        $sortOrder = DEFAULT_SORT_ORDER;\n1182→    }\n1183→\n1184→    return [\n1185→        'sort_by' => $sortBy,\n1186→        'sort_order' => $sortOrder,\n1187→        'errors' => $errors,\n1188→        'raw_sort_by' => $rawSortBy,\n1189→        'raw_sort_order' => $rawSortOrder,\n1190→    ];\n1191→}\n1192→\n1193→function normalizePaginationParameters(array $query): array\n1194→{\n1195→    $rawPage = isset($query['page']) && is_string($query['page']) ? trim($query['page']) : '';\n1196→    $rawPageSize = isset($query['page_size']) && is_string($query['page_size']) ? trim($query['page_size']) : '';\n1197→    $page = DEFAULT_PAGE_NUMBER;\n1198→    $pageSize = DEFAULT_PAGE_SIZE;\n1199→    $errors = [];\n1200→\n1201→    if ($rawPage !== '') {\n1202→        $parsedPage = filter_var($rawPage, FILTER_VALIDATE_INT, [\n1203→            'options' => ['min_range' => 1],\n1204→        ]);\n1205→        if ($parsedPage === false) {\n1206→            $errors['page'] = '页码参数无效，已重置为第1页。';\n1207→            writeDebugLog('pagination_parameter_exception', [\n1208→                'submitted_page' => $rawPage,\n1209→            ], 'failed', [\n1210→                'reason' => 'invalid_page_number',\n1211→                'allowed_range' => '>= 1',\n1212→                'default_applied' => DEFAULT_PAGE_NUMBER,\n1213→            ]);\n1214→            $page = DEFAULT_PAGE_NUMBER;\n1215→        } else {\n1216→            $page = $parsedPage;\n1217→        }\n1218→    }\n1219→\n1220→    if ($rawPageSize !== '') {\n1221→        $parsedPageSize = filter_var($rawPageSize, FILTER_VALIDATE_INT, [\n1222→            'options' => ['min_range' => MIN_PAGE_SIZE, 'max_range' => MAX_PAGE_SIZE],\n1223→        ]);\n1224→        if ($parsedPageSize === false) {\n1225→            $errors['page_size'] = '每页数量参数无效，已使用默认值' . DEFAULT_PAGE_SIZE . '。';\n1226→            writeDebugLog('pagination_parameter_exception', [\n1227→                'submitted_page_size' => $rawPageSize,\n1228→            ], 'failed', [\n1229→                'reason' => 'invalid_page_size',\n1230→                'allowed_range' => MIN_PAGE_SIZE . ' - ' . MAX_PAGE_SIZE,\n1231→                'default_applied' => DEFAULT_PAGE_SIZE,\n1232→            ]);\n1233→            $pageSize = DEFAULT_PAGE_SIZE;\n1234→        } else {\n1235→            $pageSize = $parsedPageSize;\n1236→        }\n1237→    }\n1238→\n1239→    return [\n1240→        'page' => $page,\n1241→        'page_size' => $pageSize,\n1242→        'errors' => $errors,\n1243→        'raw_page' => $rawPage,\n1244→        'raw_page_size' => $rawPageSize,\n1245→    ];\n1246→}\n1247→\n1248→function calculatePagination(int $totalCount, int $page, int $pageSize): array\n1249→{\n1250→    $totalPages = $pageSize > 0 ? (int) ceil($totalCount / $pageSize) : 1;\n1251→    if ($totalPages < 1) {\n1252→        $totalPages = 1;\n1253→    }\n1254→    if ($page > $totalPages) {\n1255→        $page = $totalPages;\n1256→    }\n1257→    $offset = ($page - 1) * $pageSize;\n1258→    $hasNextPage = $page < $totalPages;\n1259→    $hasPrevPage = $page > 1;\n1260→\n1261→    return [\n1262→        'total_count' => $totalCount,\n1263→        'total_pages' => $totalPages,\n1264→        'current_page' => $page,\n1265→        'page_size' => $pageSize,\n1266→        'offset' => $offset,\n1267→        'has_next_page' => $hasNextPage,\n1268→        'has_prev_page' => $hasPrevPage,\n1269→        'is_first_page' => $page === 1,\n1270→        'is_last_page' => $page === $totalPages,\n1271→    ];\n1272→}\n1273→\n1274→function sortTasks(array $tasks, string $sortBy, string $sortOrder): array\n1275→{\n1276→    if (empty($tasks) || $sortBy === '') {\n1277→        return $tasks;\n1278→    }\n1279→\n1280→    $isAsc = $sortOrder === 'asc';\n1281→\n1282→    $priorityWeight = ['高' => 1, '中' => 2, '低' => 3];\n1283→    $statusWeight = ['未开始' => 1, '进行中' => 2, '已完成' => 3, '已归档' => 4];\n1284→\n1285→    usort($tasks, function ($a, $b) use ($sortBy, $isAsc, $priorityWeight, $statusWeight) {\n1286→        $valueA = null;\n1287→        $valueB = null;\n1288→\n1289→        switch ($sortBy) {\n1290→            case 'created_at':\n1291→                $valueA = strtotime($a['created_at'] ?? '1970-01-01 00:00:00');\n1292→                $valueB = strtotime($b['created_at'] ?? '1970-01-01 00:00:00');\n1293→                break;\n1294→            case 'updated_at':\n1295→                $valueA = strtotime($a['updated_at'] ?? '1970-01-01 00:00:00');\n1296→                $valueB = strtotime($b['updated_at'] ?? '1970-01-01 00:00:00');\n1297→                break;\n1298→            case 'due_at':\n1299→                $dueA = normalizeStoredDueAt($a['due_at'] ?? '');\n1300→                $dueB = normalizeStoredDueAt($b['due_at'] ?? '');\n1301→                if ($dueA === '' && $dueB === '') {\n1302→                    $valueA = PHP_INT_MAX;\n1303→                    $valueB = PHP_INT_MAX;\n1304→                } elseif ($dueA === '') {\n1305→                    $valueA = PHP_INT_MAX;\n1306→                    $valueB = strtotime($dueB);\n1307→                } elseif ($dueB === '') {\n1308→                    $valueA = strtotime($dueA);\n1309→                    $valueB = PHP_INT_MAX;\n1310→                } else {\n1311→                    $valueA = strtotime($dueA);\n1312→                    $valueB = strtotime($dueB);\n1313→                }\n1314→                break;\n1315→            case 'priority':\n1316→                $pA = normalizeTaskPriority($a['priority'] ?? '中');\n1317→                $pB = normalizeTaskPriority($b['priority'] ?? '中');\n1318→                $valueA = $priorityWeight[$pA] ?? 4;\n1319→                $valueB = $priorityWeight[$pB] ?? 4;\n1320→                break;\n1321→            case 'status':\n1322→                $sA = normalizeTaskStatus($a['status'] ?? '未开始');\n1323→                $sB = normalizeTaskStatus($b['status'] ?? '未开始');\n1324→                $valueA = $statusWeight[$sA] ?? 5;\n1325→                $valueB = $statusWeight[$sB] ?? 5;\n1326→                break;\n1327→            case 'title':\n1328→                $valueA = $a['title'] ?? '';\n1329→                $valueB = $b['title'] ?? '';\n1330→                $cmp = strcasecmp($valueA, $valueB);\n1331→                return $isAsc ? $cmp : -$cmp;\n1332→            default:\n1333→                return 0;\n1334→        }\n1335→\n1336→        if ($valueA === $valueB) {\n1337→            return 0;\n1338→        }\n1339→\n1340→        return $isAsc ? ($valueA > $valueB ? 1 : -1) : ($valueA > $valueB ? -1 : 1);\n1341→    });\n1342→\n1343→    return $tasks;\n1344→}\n1345→\n1346→function normalizeTagName(string $name): string\n1347→{\n1348→    $normalized = preg_replace('/\\s+/u', ' ', trim($name));\n1349→    return is_string($normalized) ? $normalized : trim($name);\n1350→}\n1351→\n1352→function createTagId(): string\n1353→{\n1354→    try {\n1355→        return 'tag-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n1356→    } catch (Throwable $exception) {\n1357→        return 'tag-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n1358→    }\n1359→}\n1360→\n1361→function loadTags(): array\n1362→{\n1363→    writeDebugLog('tag_list_load', [\n1364→        'database_file' => basename(DB_FILE),\n1365→    ], 'started');\n1366→\n1367→    try {\n1368→        $pdo = getDatabaseConnection();\n1369→        $statement = $pdo->query(\n1370→            \"SELECT t.id,\n1371→                    t.name,\n1372→                    t.color,\n1373→                    t.created_at,\n1374→                    t.updated_at,\n1375→                    COUNT(DISTINCT tt.task_id) AS task_count\n1376→            FROM tags t\n1377→            LEFT JOIN task_tags tt ON tt.tag_id = t.id\n1378→            LEFT JOIN tasks ta ON ta.id = tt.task_id AND ta.deleted_at IS NULL\n1379→            GROUP BY t.id, t.name, t.color, t.created_at, t.updated_at\n1380→            ORDER BY t.name COLLATE NOCASE ASC\"\n1381→        );\n1382→        $rows = $statement !== false ? $statement->fetchAll() : [];\n1383→        $tags = [];\n1384→\n1385→        foreach ($rows as $row) {\n1386→            if (!is_array($row)) {\n1387→                continue;\n1388→            }\n1389→\n1390→            $tags[] = [\n1391→                'id' => isset($row['id']) && is_string($row['id']) ? trim($row['id']) : '',\n1392→                'name' => isset($row['name']) && is_string($row['name']) ? trim($row['name']) : '',\n1393→                'color' => isset($row['color']) && is_string($row['color']) && trim($row['color']) !== '' ? trim($row['color']) : '#667085',\n1394→                'created_at' => isset($row['created_at']) && is_string($row['created_at']) ? trim($row['created_at']) : '',\n1395→                'updated_at' => isset($row['updated_at']) && is_string($row['updated_at']) ? trim($row['updated_at']) : '',\n1396→                'task_count' => isset($row['task_count']) ? (int) $row['task_count'] : 0,\n1397→            ];\n1398→        }\n1399→\n1400→        writeDebugLog('tag_list_load', [\n1401→            'database_file' => basename(DB_FILE),\n1402→        ], 'success', [\n1403→            'tag_count' => count($tags),\n1404→        ]);\n1405→\n1406→        return $tags;\n1407→    } catch (Throwable $exception) {\n1408→        writeDebugLog('tag_list_