\n1729→            'task_id' => $taskId,\n1730→            'tag_ids' => $tagIds,\n1731→        ], 'success', [\n1732→            'tag_count' => count($tagIds),\n1733→            'database_file' => basename(DB_FILE),\n1734→        ]);\n1735→\n1736→        return true;\n1737→    } catch (Throwable $exception) {\n1738→        writeDebugLog('tag_assign_exception', [\n1739→            'task_id' => $taskId,\n1740→            'tag_ids' => $tagIds,\n1741→        ], 'failed', [\n1742→            'reason' => 'database_write_exception',\n1743→            'message' => $exception->getMessage(),\n1744→            'database_file' => basename(DB_FILE),\n1745→        ]);\n1746→        return false;\n1747→    }\n1748→}\n1749→\n1750→function removeTagsFromTask(string $taskId): bool\n1751→{\n1752→    writeDebugLog('tag_remove', [\n1753→        'task_id' => $taskId,\n1754→    ], 'started');\n1755→\n1756→    try {\n1757→        $pdo = getDatabaseConnection();\n1758→        $deleteStatement = $pdo->prepare('DELETE FROM task_tags WHERE task_id = :task_id');\n1759→        $deleteStatement->execute([':task_id' => $taskId]);\n1760→        $changedRows = $deleteStatement->rowCount();\n1761→        $deleteStatement->closeCursor();\n1762→\n1763→        writeDebugLog('tag_remove', [\n1764→            'task_id' => $taskId,\n1765→        ], 'success', [\n1766→            'removed_count' => $changedRows,\n1767→            'database_file' => basename(DB_FILE),\n1768→        ]);\n1769→\n1770→        return true;\n1771→    } catch (Throwable $exception) {\n1772→        writeDebugLog('tag_remove_exception', [\n1773→            'task_id' => $taskId,\n1774→        ], 'failed', [\n1775→            'reason' => 'database_write_exception',\n1776→            'message' => $exception->getMessage(),\n1777→            'database_file' => basename(DB_FILE),\n1778→        ]);\n1779→        return false;\n1780→    }\n1781→}\n1782→\n1783→function normalizeCategoryName(string $name): string\n1784→{\n1785→    $normalized = preg_replace('/\\s+/u', ' ', trim($name));\n1786→    return is_string($normalized) ? $normalized : trim($name);\n1787→}\n1788→\n1789→function createCategoryId(): string\n1790→{\n1791→    try {\n1792→        return 'category-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n1793→    } catch (Throwable $exception) {\n1794→        return 'category-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n1795→    }\n1796→}\n1797→\n1798→function loadCategories(): array\n1799→{\n1800→    writeDebugLog('category_list_load', [\n1801→        'database_file' => basename(DB_FILE),\n1802→    ], 'started');\n1803→\n1804→    try {\n1805→        $pdo = getDatabaseConnection();\n1806→        $statement = $pdo->query(\n1807→            \"SELECT c.id,\n1808→                    c.name,\n1809→                    c.color,\n1810→                    c.sort_order,\n1811→                    c.created_at,\n1812→                    c.updated_at,\n1813→                    COUNT(t.id) AS task_count,\n1814→                    SUM(CASE WHEN t.deleted_at IS NULL THEN 1 ELSE 0 END) AS active_task_count\n1815→            FROM categories c\n1816→            LEFT JOIN tasks t ON t.category_id = c.id\n1817→            GROUP BY c.id, c.name, c.color, c.sort_order, c.created_at, c.updated_at\n1818→            ORDER BY c.sort_order ASC, c.name COLLATE NOCASE ASC\"\n1819→        );\n1820→        $rows = $statement !== false ? $statement->fetchAll() : [];\n1821→        $categories = [];\n1822→\n1823→        foreach ($rows as $row) {\n1824→            if (!is_array($row)) {\n1825→                continue;\n1826→            }\n1827→\n1828→            $categories[] = [\n1829→                'id' => isset($row['id']) && is_string($row['id']) ? trim($row['id']) : '',\n1830→                'name' => isset($row['name']) && is_string($row['name']) ? trim($row['name']) : '',\n1831→                'color' => isset($row['color']) && is_string($row['color']) && trim($row['color']) !== '' ? trim($row['color']) : '#2563eb',\n1832→                'sort_order' => isset($row['sort_order']) ? (int) $row['sort_order'] : 0,\n1833→                'created_at' => isset($row['created_at']) && is_string($row['created_at']) ? trim($row['created_at']) : '',\n1834→                'updated_at' => isset($row['updated_at']) && is_string($row['updated_at']) ? trim($row['updated_at']) : '',\n1835→                'task_count' => isset($row['task_count']) ? (int) $row['task_count'] : 0,\n1836→                'active_task_count' => isset($row['active_task_count']) ? (int) $row['active_task_count'] : 0,\n1837→            ];\n1838→        }\n1839→\n1840→        writeDebugLog('category_list_load', [\n1841→            'database_file' => basename(DB_FILE),\n1842→        ], 'success', [\n1843→            'category_count' => count($categories),\n1844→        ]);\n1845→\n1846→        return $categories;\n1847→    } catch (Throwable $exception) {\n1848→        writeDebugLog('category_list_load_exception', [\n1849→            'database_file' => basename(DB_FILE),\n1850→        ], 'failed', [\n1851→            'reason' => 'database_query_exception',\n1852→            'message' => $exception->getMessage(),\n1853→        ]);\n1854→        return [];\n1855→    }\n1856→}\n1857→\n1858→function findCategoryById(array $categories, string $categoryId): ?array\n1859→{\n1860→    foreach ($categories as $category) {\n1861→        if (($category['id'] ?? '') === $categoryId) {\n1862→            return $category;\n1863→        }\n1864→    }\n1865→\n1866→    return null;\n1867→}\n1868→\n1869→function categoryNameExists(PDO $pdo, string $name, string $excludeCategoryId = ''): bool\n1870→{\n1871→    $statement = $pdo->prepare(\n1872→        \"SELECT id FROM categories\n1873→        WHERE lower(name) = lower(:name)\n1874→            AND (:exclude_id = '' OR id <> :exclude_id)\n1875→        LIMIT 1\"\n1876→    );\n1877→    $statement->execute([\n1878→        ':name' => $name,\n1879→        ':exclude_id' => $excludeCategoryId,\n1880→    ]);\n1881→    $existingId = $statement->fetchColumn();\n1882→    $statement->closeCursor();\n1883→\n1884→    return is_string($existingId) && $existingId !== '';\n1885→}\n1886→\n1887→function validateCategoryInput(string $name, string $excludeCategoryId = ''): array\n1888→{\n1889→    $errors = [];\n1890→    $normalizedName = normalizeCategoryName($name);\n1891→\n1892→    if ($normalizedName === '') {\n1893→        $errors['category_name'] = '分类名称不能为空。';\n1894→    } elseif (stringLength($normalizedName) > MAX_CATEGORY_NAME_LENGTH) {\n1895→        $errors['category_name'] = '分类名称不能超过 ' . MAX_CATEGORY_NAME_LENGTH . ' 个字符。';\n1896→    } else {\n1897→        try {\n1898→            $pdo = getDatabaseConnection();\n1899→            if (categoryNameExists($pdo, $normalizedName, $excludeCategoryId)) {\n1900→                $errors['category_name'] = '分类名称已存在，请使用不同名称。';\n1901→            }\n1902→        } catch (Throwable $exception) {\n1903→            $errors['category_name'] = '分类校验失败，请稍后重试。';\n1904→            writeDebugLog('category_validation_exception', [\n1905→                'category_id' => $excludeCategoryId,\n1906→                'name_length' => stringLength($normalizedName),\n1907→            ], 'failed', [\n1908→                'reason' => 'database_query_exception',\n1909→                'message' => $exception->getMessage(),\n1910→            ]);\n1911→        }\n1912→    }\n1913→\n1914→    return [\n1915→        'valid' => $errors === [],\n1916→        'name' => $normalizedName,\n1917→        'errors' => $errors,\n1918→    ];\n1919→}\n1920→\n1921→function validateTaskCategoryId(string $categoryId, array $categories, string $formAction, string $taskId = ''): array\n1922→{\n1923→    $trimmedCategoryId = trim($categoryId);\n1924→    if ($trimmedCategoryId === '') {\n1925→        writeDebugLog('task_category_validation', [\n1926→            'task_id' => $taskId,\n1927→            'category_id' => '',\n1928→            'form_action' => $formAction,\n1929→        ], 'success', [\n1930→            'result' => 'empty_category_allowed',\n1931→        ]);\n1932→\n1933→        return [\n1934→            'valid' => true,\n1935→            'category_id' => '',\n1936→            'error' => '',\n1937→        ];\n1938→    }\n1939→\n1940→    $category = findCategoryById($categories, $trimmedCategoryId);\n1941→    if ($category === null) {\n1942→        writeDebugLog('task_category_validation', [\n1943→            'task_id' => $taskId,\n1944→            'category_id' => $trimmedCategoryId,\n1945→            'form_action' => $formAction,\n1946→        ], 'failed', [\n1947→            'reason' => 'category_not_found',\n1948→            'database_write_blocked' => true,\n1949→        ]);\n1950→\n1951→        return [\n1952→            'valid' => false,\n1953→            'category_id' => '',\n1954→            'error' => '请选择有效的任务分类。',\n1955→        ];\n1956→    }\n1957→\n1958→    writeDebugLog('task_category_validation', [\n1959→        'task_id' => $taskId,\n1960→        'category_id' => $trimmedCategoryId,\n1961→        'form_action' => $formAction,\n1962→    ], 'success', [\n1963→        'category_name' => (string) $category['name'],\n1964→    ]);\n1965→\n1966→    return [\n1967→        'valid' => true,\n1968→        'category_id' => $trimmedCategoryId,\n1969→        'error' => '',\n1970→    ];\n1971→}\n1972→\n1973→function saveNewCategory(string $name): string\n1974→{\n1975→    $categoryId = createCategoryId();\n1976→    writeDebugLog('category_create', [\n1977→        'category_id' => $categoryId,\n1978→        'name_length' => stringLength($name),\n1979→    ], 'started');\n1980→\n1981→    try {\n1982→        $pdo = getDatabaseConnection();\n1983→        $now = date('Y-m-d H:i:s');\n1984→        $sortOrderStatement = $pdo->query('SELECT COALESCE(MAX(sort_order), 0) + 1 FROM categories');\n1985→        $sortOrder = $sortOrderStatement !== false ? (int) $sortOrderStatement->fetchColumn() : 1;\n1986→        if ($sortOrderStatement !== false) {\n1987→            $sortOrderStatement->closeCursor();\n1988→        }\n1989→\n1990→        $statement = $pdo->prepare(\n1991→            \"INSERT INTO categories (id, name, color, sort_order, created_at, updated_at)\n1992→            VALUES (:id, :name, '#2563eb', :sort_order, :created_at, :updated_at)\"\n1993→        );\n1994→        $statement->execute([\n1995→            ':id' => $categoryId,\n1996→            ':name' => $name,\n1997→            ':sort_order' => $sortOrder,\n1998→            ':created_at' => $now,\n1999→            ':updated_at' => $now,\n2000→        ]);"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_3s1hby3vn74w_1","__timestamp":"2026-05-31T18:34:32.754Z","_requestId":"7522d5d27e0f45f68e669cc4fbeb84da"}

