t_json TEXT NOT NULL DEFAULT '{}',\n 577→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 578→            )\",\n 579→            'reminders' => \"CREATE TABLE IF NOT EXISTS reminders (\n 580→                id TEXT PRIMARY KEY,\n 581→                task_id TEXT NOT NULL,\n 582→                remind_at TEXT NOT NULL,\n 583→                status TEXT NOT NULL DEFAULT 'pending',\n 584→                delivered_at TEXT NULL,\n 585→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 586→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 587→                FOREIGN KEY (task_id) REFERENCES tasks(id) ON UPDATE CASCADE ON DELETE CASCADE\n 588→            )\",\n 589→            'system_settings' => \"CREATE TABLE IF NOT EXISTS system_settings (\n 590→                setting_key TEXT PRIMARY KEY,\n 591→                setting_value TEXT NOT NULL,\n 592→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 593→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 594→            )\",\n 595→        ];\n 596→\n 597→        foreach ($statements as $tableName => $sql) {\n 598→            writeDebugLog('database_table_create', [\n 599→                'table' => $tableName,\n 600→                'database_file' => basename(DB_FILE),\n 601→            ], 'started');\n 602→            $pdo->exec($sql);\n 603→            writeDebugLog('database_table_create', [\n 604→                'table' => $tableName,\n 605→                'database_file' => basename(DB_FILE),\n 606→            ], 'success');\n 607→        }\n 608→\n 609→        $indexes = [\n 610→            'idx_tasks_status' => 'CREATE INDEX IF NOT EXISTS idx_tasks_status ON tasks(status)',\n 611→            'idx_tasks_created_at' => 'CREATE INDEX IF NOT EXISTS idx_tasks_created_at ON tasks(created_at)',\n 612→            'idx_tasks_updated_at' => 'CREATE INDEX IF NOT EXISTS idx_tasks_updated_at ON tasks(updated_at)',\n 613→            'idx_tasks_category_id' => 'CREATE INDEX IF NOT EXISTS idx_tasks_category_id ON tasks(category_id)',\n 614→            'idx_task_tags_tag_id' => 'CREATE INDEX IF NOT EXISTS idx_task_tags_tag_id ON task_tags(tag_id)',\n 615→            'idx_subtasks_task_id' => 'CREATE INDEX IF NOT EXISTS idx_subtasks_task_id ON subtasks(task_id)',\n 616→            'idx_comments_task_id' => 'CREATE INDEX IF NOT EXISTS idx_comments_task_id ON comments(task_id)',\n 617→            'idx_attachments_task_id' => 'CREATE INDEX IF NOT EXISTS idx_attachments_task_id ON attachments(task_id)',\n 618→            'idx_reminders_task_id' => 'CREATE INDEX IF NOT EXISTS idx_reminders_task_id ON reminders(task_id)',\n 619→            'idx_reminders_remind_at' => 'CREATE INDEX IF NOT EXISTS idx_reminders_remind_at ON reminders(remind_at)',\n 620→        ];\n 621→\n 622→        foreach ($indexes as $indexName => $sql) {\n 623→            $pdo->exec($sql);\n 624→            writeDebugLog('database_index_create', [\n 625→                'index' => $indexName,\n 626→                'database_file' => basename(DB_FILE),\n 627→            ], 'success');\n 628→        }\n 629→\n 630→        upsertSystemSetting($pdo, 'schema_version', '1');\n 631→        $pdo->commit();\n 632→        $GLOBALS['suppressDatabaseDebugLog'] = false;\n 633→\n 634→        writeDebugLog('database_schema_initialize', [\n 635→            'database_file' => basename(DB_FILE),\n 636→            'table_count' => count($statements),\n 637→            'index_count' => count($indexes),\n 638→        ], 'success');\n 639→    } catch (Throwable $exception) {\n 640→        if ($pdo->inTransaction()) {\n 641→            $pdo->rollBack();\n 642→        }\n 643→        $GLOBALS['suppressDatabaseDebugLog'] = false;\n 644→\n 645→        writeDebugLog('database_schema_initialize', [\n 646→            'database_file' => basename(DB_FILE),\n 647→        ], 'failed', [\n 648→            'reason' => 'schema_exception',\n 649→            'message' => $exception->getMessage(),\n 650→        ]);\n 651→        throw $exception;\n 652→    }\n 653→}\n 654→\n 655→function ensureTaskCategorySchema(PDO $pdo): void\n 656→{\n 657→    writeDebugLog('task_category_schema_check', [\n 658→        'database_file' => basename(DB_FILE),\n 659→        'column' => 'category_id',\n 660→    ], 'started');\n 661→\n 662→    try {\n 663→        $columnsStatement = $pdo->query('PRAGMA table_info(tasks)');\n 664→        $columns = $columnsStatement !== false ? $columnsStatement->fetchAll() : [];\n 665→        $hasCategoryColumn = false;\n 666→\n 667→        foreach ($columns as $column) {\n 668→            if (is_array($column) && isset($column['name']) && (string) $column['name'] === 'category_id') {\n 669→                $hasCategoryColumn = true;\n 670→                break;\n 671→            }\n 672→        }\n 673→\n 674→        if (!$hasCategoryColumn) {\n 675→            $pdo->exec('ALTER TABLE tasks ADD COLUMN category_id TEXT NULL');\n 676→            writeDebugLog('task_category_schema_alter', [\n 677→                'database_file' => basename(DB_FILE),\n 678→                'column' => 'category_id',\n 679→            ], 'success');\n 680→        }\n 681→\n 682→        $pdo->exec('CREATE INDEX IF NOT EXISTS idx_tasks_category_id ON tasks(category_id)');\n 683→        writeDebugLog('task_category_schema_check', [\n 684→            'database_file' => basename(DB_FILE),\n 685→            'column' => 'category_id',\n 686→            'index' => 'idx_tasks_category_id',\n 687→        ], 'success', [\n 688→            'column_added' => !$hasCategoryColumn,\n 689→            'reference_policy' => 'delete_blocked_when_referenced',\n 690→        ]);\n 691→    } catch (Throwable $exception) {\n 692→        writeDebugLog('task_category_schema_check', [\n 693→            'database_file' => basename(DB_FILE),\n 694→            'column' => 'category_id',\n 695→        ], 'failed', [\n 696→            'reason' => 'category_schema_exception',\n 697→            'message' => $exception->getMessage(),\n 698→        ]);\n 699→        throw $exception;\n 700→    }\n 701→}\n 702→\n 703→function ensureTaskDeadlineSchema(PDO $pdo): void\n 704→{\n 705→    writeDebugLog('task_due_at_schema_check', [\n 706→        'database_file' => basename(DB_FILE),\n 707→        'column' => 'due_at',\n 708→    ], 'started');\n 709→\n 710→    try {\n 711→        $columnsStatement = $pdo->query('PRAGMA table_info(tasks)');\n 712→        $columns = $columnsStatement !== false ? $columnsStatement->fetchAll() : [];\n 713→        $hasDueAtColumn = false;\n 714→\n 715→        foreach ($columns as $column) {\n 716→            if (is_array($column) && isset($column['name']) && (string) $column['name'] === 'due_at') {\n 717→                $hasDueAtColumn = true;\n 718→                break;\n 719→            }\n 720→        }\n 721→\n 722→        if (!$hasDueAtColumn) {\n 723→            $pdo->exec('ALTER TABLE tasks ADD COLUMN due_at TEXT NULL');\n 724→            writeDebugLog('task_due_at_schema_alter', [\n 725→                'database_file' => basename(DB_FILE),\n 726→                'column' => 'due_at',\n 727→            ], 'success');\n 728→        }\n 729→\n 730→        $pdo->exec('CREATE INDEX IF NOT EXISTS idx_tasks_due_at ON tasks(due_at)');\n 731→        writeDebugLog('task_due_at_schema_check', [\n 732→            'database_file' => basename(DB_FILE),\n 733→            'column' => 'due_at',\n 734→            'index' => 'idx_tasks_due_at',\n 735→        ], 'success', [\n 736→            'column_added' => !$hasDueAtColumn,\n 737→            'min_due_at' => MIN_DUE_AT,\n 738→            'max_due_at' => MAX_DUE_AT,\n 739→        ]);\n 740→    } catch (Throwable $exception) {\n 741→        writeDebugLog('task_due_at_schema_check', [\n 742→            'database_file' => basename(DB_FILE),\n 743→            'column' => 'due_at',\n 744→        ], 'failed', [\n 745→      