ion/zip',\n  45→    'application/x-rar-compressed',\n  46→    'application/msword',\n  47→    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',\n  48→    'application/vnd.ms-excel',\n  49→    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n  50→];\n  51→\n  52→date_default_timezone_set('Asia/Shanghai');\n  53→\n  54→function writeDebugLog(string $operation, array $parameters, string $status, array $context = []): void\n  55→{\n  56→    $logDirectory = dirname(LOG_FILE);\n  57→    if (!is_dir($logDirectory)) {\n  58→        mkdir($logDirectory, 0775, true);\n  59→    }\n  60→\n  61→    $entry = [\n  62→        'timestamp' => date('Y-m-d H:i:s'),\n  63→        'operation' => $operation,\n  64→        'parameters' => $parameters,\n  65→        'status' => $status,\n  66→        'context' => $context,\n  67→    ];\n  68→\n  69→    file_put_contents(\n  70→        LOG_FILE,\n  71→        json_encode($entry, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL,\n  72→        FILE_APPEND | LOCK_EX\n  73→    );\n  74→    persistDebugLogToDatabase($entry);\n  75→}\n  76→\n  77→function persistDebugLogToDatabase(array $entry): void\n  78→{\n  79→    if (!empty($GLOBALS['isPersistingDebugLog']) || !empty($GLOBALS['suppressDatabaseDebugLog']) || !extension_loaded('pdo_sqlite')) {\n  80→        return;\n  81→    }\n  82→\n  83→    $GLOBALS['isPersistingDebugLog'] = true;\n  84→\n  85→    try {\n  86→        $dataDirectory = dirname(DB_FILE);\n  87→        if (!is_dir($dataDirectory) && !mkdir($dataDirectory, 0775, true) && !is_dir($dataDirectory)) {\n  88→            return;\n  89→        }\n  90→\n  91→        $pdo = new PDO('sqlite:' . DB_FILE);\n  92→        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n  93→        $pdo->exec('PRAGMA busy_timeout = 5000');\n  94→        $pdo->exec(\"CREATE TABLE IF NOT EXISTS operation_logs (\n  95→            id INTEGER PRIMARY KEY AUTOINCREMENT,\n  96→            operation TEXT NOT NULL,\n  97→            parameters_json TEXT NOT NULL DEFAULT '{}',\n  98→            status TEXT NOT NULL,\n  99→            context_json TEXT NOT NULL DEFAULT '{}',\n 100→            created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 101→        )\");\n 102→\n 103→        $parametersJson = json_encode($entry['parameters'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n 104→        $contextJson = json_encode($entry['context'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n 105→        $statement = $pdo->prepare(\n 106→            'INSERT INTO operation_logs (operation, parameters_json, status, context_json, created_at)\n 107→            VALUES (:operation, :parameters_json, :status, :context_json, :created_at)'\n 108→        );\n 109→        $statement->execute([\n 110→            ':operation' => (string) ($entry['operation'] ?? 'unknown'),\n 111→            ':parameters_json' => is_string($parametersJson) ? $parametersJson : '{}',\n 112→            ':status' => (string) ($entry['status'] ?? 'unknown'),\n 113→            ':context_json' => is_string($contextJson) ? $contextJson : '{}',\n 114→            ':created_at' => (string) ($entry['timestamp'] ?? date('Y-m-d H:i:s')),\n 115→        ]);\n 116→    } catch (Throwable $exception) {\n 117→        $GLOBALS['lastDebugLogDatabaseError'] = $exception->getMessage();\n 118→    } finally {\n 119→        $GLOBALS['isPersistingDebugLog'] = false;\n 120→    }\n 121→}\n 122→\n 123→function escapeHtml(string $value): string\n 124→{\n 125→    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n 126→}\n 127→\n 128→function normalizeTaskStatus(string $status, string $fallback = '未开始'): string\n 129→{\n 130→    $trimmedStatus = trim($status);\n 131→    if (isset(LEGACY_STATUS_MAP[$trimmedStatus])) {\n 132→        return LEGACY_STATUS_MAP[$trimmedStatus];\n 133→    }\n 134→\n 135→    if (in_array($trimmedStatus, ALLOWED_STATUSES, true)) {\n 136→        return $trimmedStatus;\n 137→    }\n 138→\n 139→    return in_array($fallback, ALLOWED_STATUSES, true) ? $fallback : '未开始';\n 140→}\n 141→\n 142→function isAllowedTaskStatus(string $status): bool\n 143→{\n 144→    return in_array(trim($status), ALLOWED_STATUSES, true);\n 145→}\n 146→\n 147→function normalizeTaskPriority(string $priority, string $fallback = DEFAULT_TASK_PRIORITY): string\n 148→{\n 149→    $trimmedPriority = trim($priority);\n 150→    if (in_array($trimmedPriority, ALLOWED_PRIORITIES, true)) {\n 151→        return $trimmedPriority;\n 152→    }\n 153→\n 154→    return in_array($fallback, ALLOWED_PRIORITIES, true) ? $fallback : DEFAULT_TASK_PRIORITY;\n 155→}\n 156→\n 157→function isAllowedTaskPriority(string $priority): bool\n 158→{\n 159→    return in_array(trim($priority), ALLOWED_PRIORITIES, true);\n 160→}\n 161→\n 162→function getPriorityBadgeClass(string $priority): string\n 163→{\n 164→    $normalizedPriority = normalizeTaskPriority($priority);\n 165→    if ($normalizedPriority === '高') {\n 166→        return 'priority-high';\n 167→    }\n 168→    if ($normalizedPriority === '低') {\n 169→        return 'priority-low';\n 170→    }\n 171→\n 172→    return 'priority-medium';\n 173→}\n 174→\n 175→function normalizeStoredDueAt($dueAt): string\n 176→{\n 177→    if (!is_string($dueAt)) {\n 178→        return '';\n 179→    }\n 180→\n 181→    $trimmedDueAt = trim($dueAt);\n 182→    if ($trimmedDueAt === '') {\n 183→        return '';\n 184→    }\n 185→\n 186→    $dateTime = DateTimeImmutable::createFromFormat('Y-m-d H:i:s', $trimmedDueAt);\n 187→    $dateErrors = DateTimeImmutable::getLastErrors();\n 188→    if ($dateTime instanceof DateTimeImmutable && $dateErrors === false) {\n 189→        return $dateTime->format('Y-m-d H:i:s');\n 190→    }\n 191→\n 192→    $timestamp = strtotime($trimmedDueAt);\n 193→    if ($timestamp === false) {\n 194→        return '';\n 195→    }\n 196→\n 197→    return date('Y-m-d H:i:s', $timestamp);\n 198→}\n 199→\n 200→function validateDueAtInput(string $dueAtInput): array\n 201→{\n 202→    $trimmedDueAt = trim($dueAtInput);\n 203→    if ($trimmedDueAt === '') {\n 204→        writeDebugLog('task_due_at_validation', [\n 205→            'submitted_due_at' => $dueAtInput,\n 206→        ], 'success', [\n 207→            'result' => 'empty_due_at_allowed',\n 208→            'normalized_due_at' => '',\n 209→        ]);\n 210→        return [\n 211→            'valid' => true,\n 212→            'normalized' => '',\n 213→            'error' => '',\n 214→            'reason' => 'empty_due_at_allowed',\n 215→        ];\n 216→    }\n 217→\n 218→    $dateTime = DateTimeImmutable::createFromFormat('Y-m-d\\TH:i', $trimmedDueAt);\n 219→    $dateErrors = DateTimeImmutable::getLastErrors();\n 220→    if (!$dateTime instanceof DateTimeImmutable || $dateErrors !== false) {\n 221→        writeDebugLog('task_due_at_validation', [\n 222→            'submitted_due_at' => $dueAtInput,\n 223→        ], 'failed', [\n 224→            'reason' => 'invalid_datetime_format',\n 225→            'expected_format' => 'Y-m-dTH:i',\n 226→            'database_write_blocked' => true,\n 227→        ]);\n 228→        return [\n 229→            'valid' => false,\n 230→            'normalized' => '',\n 231→            'error' => '截止日期时间格式无效，请使用页面日期时间控件选择。',\n 232→            'reason' => 'invalid_datetime_format',\n 233→        ];\n 234→    }\n 235→\n 236→    $minDateTime = new DateTimeImmutable(MIN_DUE_AT);\n 237→    $maxDateTime = new DateTimeImmutable(MAX_DUE_AT);\n 238→    if ($dateTime < $minDateTime || $dateTime > $maxDateTime) {\n 239→        writeDebugLog('task_due_at_validation', [\n 240→            'submitted_due_at' => $dueAtInput,\n 241→            'normalized_due_at' => $dateTime->format('Y-m-d H:i:s'),\n 242→        ], 'failed', [\n 243→            'reason' => 'datetime_out_of_allowed_range',\n 244→            'min_due_at' => MIN_DUE_AT,\n 245→            'max_due_at' => MAX_DUE_AT,\n 246→            'database_write_blocked' => true,\n 247→        ]);\n 248→        return [\n 249→            'valid' => false,\n 250→            'normalized' => '',\n 251→            'error' => '截止日期时间必须在 2000-01-01 00:00 到 2100-12-31 23:59 之间。',\n 252→            'reason' => 'datetime_out_of_allowed_range',\n 253→        ];\n 254→    }\n 255→\n 256→    $normalizedDueAt = $dateTime->format('Y-m-d H:i:s');\n 257→    writeDebugLog('task_due_at_validation', [\n 258→        'submitted_due_at' => $dueAtInput,\n 259→        'normalized_due_at' => $normalizedDueAt,\n 260→    ], 'success', [\n 261→        'result' => 'valid_due_at',\n 262→        'min_due_at' => MIN_DUE_AT,\n 263→        'max_due_at' => MAX_DUE_AT,\n 264→    ]);\n 265→\n 266→    return [\n 267→        'valid' => true,\n 268→        'normalized' => $normalizedDueAt,\n 269→        'error' => '',\n 270→        'reason' => 'valid_due_at',\n 271→    ];\n 272→}\n 273→\n 274→function formatDueAtForInput(string $dueAt): string\n 275→{\n 276→    $normalizedDueAt = normalizeStoredDueAt($dueAt);\n 277→    if ($normalizedDueAt === '') {\n 278→        return '';\n 279→    }\n 280→\n 281→    $timestamp = strtotime($normalizedDueAt);\n 282→    return $timestamp === false ? '' : date('Y-m-d\\TH:i', $timestamp);\n 283→}\n 284→\n 285→function buildDueAtState(array $task, string $source): array\n 286→{\n 287→    $taskId = isset($task['id']) && is_string($task['id']) ? $task['id'] : '';\n 288→    $dueAt = normalizeStoredDueAt($task['due_at'] ?? '');\n 289→    $nowTimestamp = time();\n 290→    $todayStart = strtotime(date('Y-m-d 00:00:00', $nowTimestamp));\n 291→    $todayEnd = strtotime(date('Y-m-d 23:59:59', $nowTimestamp));\n 292→\n 293→    if ($dueAt === '') {\n 294→        writeDebugLog('task_due_at_status_calculate', [\n 295→            'task_id' => $taskId,\n 296→            'due_at' => '',\n 297→            'source' => $source,\n 298→        ], 'success', [\n 299→            'result_status' => '未设置',\n 300→            'now' => date('Y-m-d H:i:s', $nowTimesta