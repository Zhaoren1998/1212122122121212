9→\n 360→function normalizeTask(array $task, int $index): array\n 361→{\n 362→    $createdAt = isset($task['created_at']) && is_string($task['created_at']) && trim($task['created_at']) !== ''\n 363→        ? trim($task['created_at'])\n 364→        : '1970-01-01 00:00:00';\n 365→    $updatedAt = isset($task['updated_at']) && is_string($task['updated_at']) && trim($task['updated_at']) !== ''\n 366→        ? trim($task['updated_at'])\n 367→        : $createdAt;\n 368→\n 369→    $rawStatus = isset($task['status']) && is_string($task['status']) && trim($task['status']) !== ''\n 370→        ? trim($task['status'])\n 371→        : '未开始';\n 372→    $rawPriority = isset($task['priority']) && is_string($task['priority']) && trim($task['priority']) !== ''\n 373→        ? trim($task['priority'])\n 374→        : DEFAULT_TASK_PRIORITY;\n 375→\n 376→    return [\n 377→        'id' => isset($task['id']) && is_string($task['id']) && trim($task['id']) !== ''\n 378→            ? trim($task['id'])\n 379→            : 'task-' . $index,\n 380→        'title' => isset($task['title']) && is_string($task['title'])\n 381→            ? $task['title']\n 382→            : '未命名任务',\n 383→        'content' => isset($task['content']) && is_string($task['content'])\n 384→            ? $task['content']\n 385→            : '',\n 386→        'status' => normalizeTaskStatus($rawStatus),\n 387→        'priority' => normalizeTaskPriority($rawPriority),\n 388→        'category_id' => isset($task['category_id']) && is_string($task['category_id'])\n 389→            ? trim($task['category_id'])\n 390→            : '',\n 391→        'category_name' => isset($task['category_name']) && is_string($task['category_name'])\n 392→            ? trim($task['category_name'])\n 393→            : '',\n 394→        'due_at' => normalizeStoredDueAt($task['due_at'] ?? ''),\n 395→        'created_at' => $createdAt,\n 396→        'updated_at' => $updatedAt,\n 397→        'archived_at' => isset($task['archived_at']) && is_stri