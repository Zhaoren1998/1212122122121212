) ? normalizeTaskStatus($task['status']) : '未开始';\n2786→        if (!isset($counts[$status])) {\n2787→            $counts[$status] = 0;\n2788→        }\n2789→        $counts[$status]++;\n2790→    }\n2791→\n2792→    return $counts;\n2793→}\n2794→\n2795→function findTaskById(array $tasks, string $taskId): ?array\n2796→{\n2797→    foreach ($tasks as $task) {\n2798→        if (($task['id'] ?? '') === $taskId) {\n2799→            return $task;\n2800→        }\n2801→    }\n2802→\n2803→    return null;\n2804→}\n2805→\n2806→function loadSubtasksForTask(PDO $pdo, string $taskId): array\n2807→{\n2808→    writeDebugLog('task_subtasks_load', [\n2809→        'task_id' => $taskId,\n2810→    ], 'started');\n2811→\n2812→    try {\n2813→        $statement = $pdo->prepare(\n2814→            \"SELECT id, task_id, title, is_completed, sort_order, created_at, updated_at\n2815→            FROM subtasks\n2816→            WHERE task_id = :task_id\n2817→            ORDER BY sort_order ASC, created_at ASC\"\n2818→        );\n2819→        $statement->execute([':task_id' => $taskId]);\n2820→        $rows = $statement->fetchAll();\n2821→        $statement->closeCursor();\n2822→\n2823→        $subtasks = [];\n2824→        foreach ($rows as $row) {\n2825→            if (!is_array($row)) {\n2826→                continue;\n2827→            }\n2828→            $subtasks[] = [\n2829→                'id' => isset($row['id']) && is_string($row['id']) ? trim($row['id']) : '',\n2830→                'task_id' => isset($row['task_id']) && is_string($row['task_id']) ? trim($row['task_id']) : '',\n2831→                'title' => isset($row['title']) && is_string($row['title']) ? trim($row['title']) : '',\n2832→                'is_completed' => isset($row['is_completed']) ? (int) $row['is_completed'] : 0,\n2833→                'sort_order' => isset($row['sort_order']) ? (int) $row['sort_order'] : 0,\n2834→                'created_at' => isset($row['created_at']) && is_string($row['created_at']) ? trim($row['created_at']) : '',\n2835→                'updated_at' => isset($row['updated_at']) && is_string($row['updated_at']) ? trim($row['updated_at']) : '',\n2836→            ];\n2837→        }\n2838→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_yunbzi2x7do6_1","__timestamp":"2026-05-31T18:59:05.158Z","_requestId":"4e97997ff9814e8097f04bbc877f282d"}

