   'reason' => 'stored_due_at_unparseable',\n 319→            'result_status' => '无效日期',\n 320→            'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 321→        ]);\n 322→        return [\n 323→            'label' => '无效日期',\n 324→            'class' => 'due-invalid',\n 325→            'description' => '截止时间格式异常',\n 326→            'datetime' => $dueAt,\n 327→        ];\n 328→    }\n 329→\n 330→    if ($dueTimestamp < $nowTimestamp) {\n 331→        $label = '已逾期';\n 332→        $class = 'due-overdue';\n 333→    } elseif ($todayStart !== false && $todayEnd !== false && $dueTimestamp >= $todayStart && $dueTimestamp <= $todayEnd) {\n 334→        $label = '今日到期';\n 335→        $class = 'due-today';\n 336→    } else {\n 337→        $label = '未到期';\n 338→        $class = 'due-future';\n 339→    }\n 340→\n 341→    writeDebugLog('task_due_at_status_calculate', [\n 342→        'task_id' => $taskId,\n 343→        'due_at' => $dueAt,\n 344→        'source' => $source,\n 345→    ], 'success', [\n 346→        'result_status' => $label,\n 347→        'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 348→        'due_timestamp' => $dueTimestamp,\n 349→        'has_due_at' => true,\n 350→    ]);\n 351→\n 352→    return [\n 353→        'label' => $label,\n 354→        'class' => $class,\n 355→        'description' => formatDateTime($dueAt),\n 356→        'datetime' => $dueAt,\n 357→    ];\n 358→}\n 359→\n 360→function normalizeTask(array $task, int $index): array\n 361→{\n 362→    $createdAt = isset($task['created_at']) && is_string($task['created_at']) && trim($task['created_at']) !== ''\n 363→        ? trim($task['created_at'])\n 364→        : '1970-01-01 00:00:00';\n 365→    $updatedAt = isset($task['updated_at']) && is_string($task['updated_at']) && trim($task['updated_at']) !== ''\n 366→        ? trim($task['updated_at'])\n 367→        : $createdAt;\n 368→\n 369→    $rawStatus = isset($task['status']) && is_string($task['status']) && trim($task['status']) !== ''\n 370→"}],"is