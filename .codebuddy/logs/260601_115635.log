!is_array($legacyTask)) {\n2053→                        $skippedCount++;\n2054→                        continue;\n2055→                    }\n2056→\n2057→                    $task = normalizeTask($legacyTask, (int) $index);\n2058→                    $statement->execute([\n2059→                        ':id' => $task['id'],\n2060→                        ':title' => $task['title'],\n2061→                        ':content' => $task['content'],\n2062→                        ':status' => normalizeTaskStatus($task['status']),\n2063→                        ':priority' => '中',\n2064→                        ':created_at' => $task['created_at'],\n2065→                        ':updated_at' => $task['updated_at'],\n2066→                    ]);\n2067→\n2068→                    if ($statement->rowCount() > 0) {\n2069→                        $migratedCount++;\n2070→                    } else {\n2071→                        $skippedCount++;\n2072→                    }\n2073→                }\n2074→            }\n2075→        }\n2076→\n2077→        upsertSystemSetting($pdo, 'legacy_json_migrated', '1');\n2078→        writeDebugLog('database_legacy_json_migration', [\n2079→            'data_file' => basename(DATA_FILE),\n2080→            'database_file' => basename(DB_FILE),\n2081→        ], 'success', [\n2082→            'migrated_count' => $migratedCount,\n2083→            'skipped_count' => $skippedCount,\n2084→        ]);\n2085→    } catch (Throwable $exception) {\n2086→        writeDebugLog('database_legacy_json_migration', [\n2087→            'data_file' => basename(DATA_FILE),\n2088→            'database_file' => basename(DB_FILE),\n2089→        ], 'failed', [\n2090→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_7u9g7j1ze9gt_1","__timestamp":"2026-06-01T03:58:58.130Z","_requestId":"a8e0b3f3c43743b1b62656910799ac4c"}

