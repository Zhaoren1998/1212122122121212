column' => 'due_at',\n 700→    ], 'started');\n 701→\n 702→    try {\n 703→        $columnsStatement = $pdo->query('PRAGMA table_info(tasks)');\n 704→        $columns = $columnsStatement !== false ? $columnsStatement->fetchAll() : [];\n 705→        $hasDueAtColumn = false;\n 706→\n 707→        foreach ($columns as $column) {\n 708→            if (is_array($column) && isset($column['name']) && (string) $column['name'] === 'due_at') {\n 709→                $hasDueAtColumn = true;\n 710→                break;\n 711→            }\n 712→        }\n 713→\n 714→        if (!$hasDueAtColumn) {\n 715→            $pdo->exec('ALTER TABLE tasks ADD COLUMN due_at TEXT NULL');\n 716→            writeDebugLog('task_due_at_schema_alter', [\n 717→                'database_file' => basename(DB_FILE),\n 718→                'column' => 'due_at',\n 719→            ], 'success');\n 720→        }\n 721→\n 722→        $pdo->exec('CREATE INDEX IF NOT EXISTS idx_tasks_due_at ON tasks(due_at)');\n 723→        writeDebugLog('task_due_at_schema_check', [\n 724→            'database_file' => basename(DB_FILE),\n 725→            'column' => 'due_at',\n 726→            'index' => 'idx_tasks_due_at',\n 727→        ], 'success', [\n 728→            'column_added' => !$hasDueAtColumn,\n 729→            'min_due_at' => MIN_DUE_AT,\n 730→            'max_due_at' => MAX_DUE_AT,\n 731→        ]);\n 732→    } catch (Throwable $exception) {\n 733→        writeDebugLog('task_due_at_schema_check', [\n 734→            'database_file' => basename(DB_FILE),\n 735→            'column' => 'due_at',\n 736→        ], 'failed', [\n 737→            'reason' => 'due_at_schema_exception',\n 738→            'message' => $exception->getMessage(),\n 739→        ]);\n 740→        throw $exception;\n 741→    }\n 742→}\n 743→\n 744→function ensureTaskPrioritySchema(PDO $pdo): void\n 745→{\n 746→    writeDebugLog('task_priority_schema_check', [\n 747→        'database_file' => basename(DB_FILE),\n 748→        'column' => 'priority',\n 749→    ], 'started');\n 750→\n 751→    try {\n 752→        $columnsStatement = $pdo->query('PRAGMA table_info(tasks)');\n 753→        $columns = $columnsStatement !== false ? $columnsStatement->fetchAll() : [];\n 754→        $hasPriorityColumn = false;\n 755→\n 756→        foreach ($columns as $column) {\n 757→            if (is_array($column) && isset($column['name']) && (string) $column['name'] === 'priority') {\n 758→                $hasPriorityColumn = true;\n 759→                break;\n 760→            }\n 761→        }\n 762→\n 763→        if (!$hasPriorityColumn) {\n 764→            $pdo->exec(\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT '\" . DEFAULT_TASK_PRIORITY . \"'\");\n 765→            writeDebugLog('task_priority_schema_alter', [\n 766→                'database_file' => basename(DB_FILE),\n 767→                'column' => 'priority',\n 768→                'default_priority' => DEFAULT_TASK_PRIORITY,\n 769→            ], 'success');\n 770→        }\n 771→\n 772→        $pdo->exec('CREATE INDEX IF NOT EXISTS idx_tasks_priority ON tasks(priority)');\n 773→        writeDebugLog('task_priority_schema_check', [\n 774→            'database_file' => basename(DB_FILE),\n 775→            'column' => 'priority',\n 776→            'index' => 'idx_tasks_priority',\n 777→        ], 'success', [\n 778→            'column_added' => !$hasPriorityColumn,\n 779→            'allowed_priorities' => ALLOWED_PRIORITIES,\n 780→        ]);\n 781→    } catch (Throwable $exception) {\n 782→        writeDebugLog('task_priority_schema_check', [\n 783→            'database_file' => basename(DB_FILE),\n 784→            'column' => 'priority',\n 785→        ], 'failed', [\n 786→            'reason' => 'priority_schema_exception',\n 787→            'message' => $exception->getMessage(),\n 788→        ]);\n 789→        throw $exception;\n 790→    }\n 791→}\n 792→\n 793→function upsertSystemSetting(PDO $pdo, string $key, string $value): void\n 794→{\n 795→    $statement = $pdo->prepare(\n 796→        \"INSERT INTO system_settings (setting_key, setting_value, created_at, updated_at)\n 797→        VALUES (:setting_key, :setting_value, datetime('now', 'localtime'), datetime('now', 'localtime'))\n 798→        ON CONFLICT(setting_key) DO UPDATE SET\n 799→            setting_value = excluded.setting_value,\n 800→            updated_at = datetime('now', 'localtime')\"\n 801→    );\n 802→    $statement->execute([\n 803→        ':setting_key' => $key,\n 804→        ':setting_value' => $value,\n 805→    ]);\n 806→}\n 807→\n 808→function getSystemSetting(PDO $pdo, string $key): ?string\n 809→{\n 810→    $statement = $pdo->prepare('SELECT setting_value FROM system_settings WHERE setting_key = :setting_key LIMIT 1');\n 811→    $statement->execute([':setting_key' => $key]);\n 812→    $value = $statement->fetchColumn();\n 813→\n 814→    return is_string($value) ? $value : null;\n 815→}\n 816→\n 817→function migrateLegacyTasksJson(PDO $pdo): void\n 818→{\n 819→    if (getSystemSetting($pdo, 'legacy_json_migrated') === '1') {\n 820→        return;\n 821→    }\n 822→\n 823→    writeDebugLog('database_legacy_json_migration', [\n 824→        'data_file' => basename(DATA_FILE),\n 825→        'database_file' => basename(DB_FILE),\n 826→    ], 'started');\n 827→\n 828→    $migratedCount = 0;\n 829→    $skippedCount = 0;\n 830→\n 831→    try {\n 832→        if (file_exists(DATA_FILE)) {\n 833→            $rawJson = file_get_contents(DATA_FILE);\n 834→            if ($rawJson === false) {\n 835→                throw new RuntimeException('旧 JSON 数据文件读取失败。');\n 836→            }\n 837→\n 838→            $trimmedJson = trim($rawJson);\n 839→            if ($trimmedJson !== '') {\n 840→                $decoded = json_decode($trimmedJson, true);\n 841→                if (!is_array($decoded)) {\n 842→                    throw new RuntimeException('旧 JSON 数据格式无效：' . json_last_error_msg());\n 843→                }\n 844→\n 845→                $statement = $pdo->prepare(\n 846→                    \"INSERT OR IGNORE INTO tasks\n 847→                    (id, title, content, status, priority, category_id, due_at, archived_at, deleted_at, created_at, updated_at)\n 848→                    VALUES\n 849→                    (:id, :title, :content, :status, :priority, NULL, NULL, NULL, NULL, :created_at, :updated_at)\"\n 850→                );\n 851→\n 852→                foreach ($decoded as $index => $legacyTask) {\n 853→                    if (!is_array($legacyTask)) {\n 854→                        $skippedCount++;\n 855→                        continue;\n 856→                    }\n 857→\n 858→                    $task = normalizeTask($legacyTask, (int) $index);\n 859→                    $statement->execute([\n 860→                        ':id' => $task['id'],\n 861→                        ':title' => $task['title'],\n 862→                        ':content' => $task['content'],\n 863→                        ':status' => normalizeTaskStatus($task['status']),\n 864→                        ':priority' => '中',\n 865→                        ':created_at' => $task['created_at'],\n 866→                        ':updated_at' => $task['updated_at'],\n 867→                    ]);\n 868→\n 869→                    if ($statement->rowCount() > 0) {\n 870→                        $migratedCount++;\n 871→                    } else {\n 872→                        $skippedCount++;\n 873→                    }\n 874→                }\n 875→            }\n 876→        }\n 877→\n 878→        upsertSystemSetting($pdo, 'legacy_json_migrated', '1');\n 879→        writeDebugLog('database_legacy_json_migration', [\n 880→            'data_file' => basename(DATA_FILE),\n 881→            'database_file' => basename(DB_FILE),\n 882→        ], 'success', [\n 883→            'migrated_count' => $migratedCount,\n 884→            'skipped_count' => $skippedCount,\n 885→        ]);\n 886→    } catch (Throwable $exception) {\n 887→        writeDebugLog('database_legacy_json_migration', [\n 888→            'data_file' => basename(DATA_FILE),\n 889→            'database_file' => basename(DB_FILE),\n 890→        ], 'failed', [\n 891→            'reason' => 'migration_exception',\n 892→            'message' => $exception->getMessage(),\n 893→            'migrated_count' => $migratedCount,\n 894→            'skipped_count' => $skippedCount,\n 895→        ]);\n 896→        throw $exception;\n 897→    }\n 898→}\n 899→\n 900→function migrateTaskStatuses(PDO $pdo): void\n 901→{\n 902→    if (getSystemSetting($pdo, 'task_status_migrated_v2') === '1') {\n 903→        return;\n 904→    }\n 905→\n 906→    writeDebugLog('task_status_migration', [\n 907→        'database_file' => basename(DB_FILE),\n 908→        'allowed_statuses' => ALLOWED_STATUSES,\n 909→        'legacy_statuses' => array_keys(LEGACY_STATUS_MAP),\n 910→    ], 'started');\n 911→\n 912→    try {\n 913→        $statement = $pdo->query('SELECT id, status, archived_at FROM tasks WHERE deleted_at IS NULL');\n 914→        $rows = $statement !== false ? $statement->fetchAll() : [];\n 915→        $updatedCount = 0;\n 916→        $invalidCount = 0;\n 917→        $now = date('Y-m-d H:i:s');\n 918→        $updateStatement = $pdo->prepare(\n 919→            'UPDATE tasks\n 920→            SET status = :status,\n 921→                archived_at = :archived_at,\n 922→                updated_at = :updated_at\n 923→            WHERE id = :id'\n 924→        );\n 925→\n 926→        foreach ($rows as $row) {\n 927→            if (!is_array($row)) {\n 928→                continue;\n 929→            }\n 930→\n 931→            $taskId = isset($row['id']) && is_string($row['id']) ? $row['id'] : '';\n 932→            $rawStatus = isset($row['status']) && is_string($row['status']) ? trim($row['status']) : '';\n 933→            $normalizedStatus = normalizeTaskStatus($rawStatus);\n 934→            $archivedAt = isset($row['archived_at']) && is_string($row['archived_at']) ? trim($row['archived_at']) : '';\n 935→\n 936→            if ($taskId === '') {\n 937→                continue;\n 938→            }\n 939→\n 940→            if ($rawStatus !== $normalizedStatus) {\n 941→                $invalidCount++;\n 942→                writeDebugLog('task_status_read_exception', [\n 943→                    'task_id' => $taskId,\n 944→                    'raw_status' => $rawStatus,\n 945→                ], 'failed', [\n 946→                    'reason' => 'status_outside_allowed_enum',\n 947→                    'normalized_status' => $normalizedStatus,\n 948→                    'allowed_statuses' => ALLOWED_STATUSES,\n 949→                ]);\n 950→            }\n 951→\n 952→            $targetArchivedAt = $normalizedStatus === '已归档'\n 953→                ? ($archivedAt !== '' ? $archivedAt : $now)\n 954→                : null;\n 955→\n 956→            if ($rawStatus !== $normalizedStatus || ($normalizedStatus !== '已归档' && $archivedAt !== '') || ($normalizedStatus === '已归档' && $archivedAt === '')) {\n 957→                $updateStatement->execute([\n 958→                    ':status' => $normalizedStatus,\n 959→                    ':archived_at' => $targetArchivedAt,\n 960→                    ':updated_at' => $now,\n 961→                    ':id' => $taskId,\n 962→                ]);\n 963→                $updatedCount += $updateStatement->rowCount();\n 964→            }\n 965→        }\n 966→\n 967→        upsertSystemSetting($pdo, 'task_status_migrated_v2', '1');\n 968→        writeDebugLog('task_status_migration', [\n 969→            'database_file' => basename(DB_FILE),\n 970→        ], 'success', [\n 971→            'scanned_count' => count($rows),\n 972→            'updated_count' => $updatedCount,\n 973→            'invalid_status_count' => $invalidCount,\n 974→            'allowed_statuses' => ALLOWED_STATUSES,\n 975→        ]);\n 976→    } catch (Throwable $exception) {\n 977→        writeDebugLog('task_status_migration', [\n 978→            'database_file' => basename(DB_FILE),\n 979→        ], 'failed', [\n 980→            'reason' => 'status_migration_exception',\n 981→            'message' => $exception->getMessage(),\n 982→        ]);\n 983→        throw $exception;\n 984→    }\n 985→}\n 986→\n 987→function migrateTaskPriorities(PDO $pdo): void\n 988→{\n 989→    if (getSystemSetting($pdo, 'task_priority_migrated_v1') === '1') {\n 990→        return;\n 991→    }\n 992→\n 993→    writeDebugLog('task_priority_migration', [\n 994→        'database_file' => basename(DB_FILE),\n 995→        'allowed_priorities' => ALLOWED_PRIORITIES,\n 996→        'default_priority' => DEFAULT_TASK_PRIORITY,\n 997→    ], 'started');\n 998→\n 999→    try {\n1000→        $statement = $pdo->query('SELECT id, priority FROM tasks WHERE deleted_at IS NULL');\n1001→        $rows = $statement !== false ? $statement->fetchAll() : [];\n1002→        $updatedCount = 0;\n1003→        $invalidCount = 0;\n1004→        $now = date('Y-m-d H:i:s');\n1005→        $updateStatement = $pdo->prepare(\n1006→            'UPDATE tasks\n1007→            SET priority = :priority,\n1008→                updated_at = :updated_at\n1009→            WHERE id = :id'\n1010→        );\n1011→\n1012→        foreach ($rows as $row) {\n1013→            if (!is_array($row)) {\n1014→                continue;\n1015→            }\n1016→\n1017→            $taskId = isset($row['id']) && is_string($row['id']) ? $row['id'] : '';\n1018→            $rawPriority = isset($row['priority']) && is_string($row['priority']) ? trim($row['priority']) : '';\n1019→            $normalizedPriority = normalizeTaskPriority($rawPriority);\n1020→\n1021→            if ($taskId === '') {\n1022→                continue;\n1023→            }\n1024→\n1025→            if ($rawPriority !== $normalizedPriority) {\n1026→                $invalidCount++;\n1027→                writeDebugLog('task_priority_read_exception', [\n1028→                    'task_id' => $taskId,\n1029→                    'raw_priority' => $rawPriority,\n1030→                ], 'failed', [\n1031→                    'reason' => 'priority_outside_allowed_enum',\n1032→                    'normalized_priority' => $normalizedPriority,\n1033→                    'allowed_priorities' => ALLOWED_PRIORITIES,\n1034→                ]);\n1035→\n1036→                $updateStatement->execute([\n1037→                    ':priority' => $normalizedPriority,\n1038→                    ':updated_at' => $now,\n1039→                    ':id' => $taskId,\n1040→                ]);\n1041→                $updatedCount += $updateStatement->rowCount();\n1042→            }\n1043→        }\n1044→\n1045→        upsertSystemSetting($pdo, 'task_priority_migrated_v1', '1');\n1046→        writeDebugLog('task_priority_migration', [\n1047→            'database_file' => basename(DB_FILE),\n1048→        ], 'success', [\n1049→            'scanned_count' => count($rows),\n1050→            'updated_count' => $updatedCount,\n1051→            'invalid_priority_count' => $invalidCount,\n1052→            'allowed_priorities' => ALLOWED_PRIORITIES,\n1053→        ]);\n1054→    } catch (Throwable $exception) {\n1055→        writeDebugLog('task_priority_migration', [\n1056→            'database_file' => basename(DB_FILE),\n1057→        ], 'failed', [\n1058→            'reason' => 'priority_migration_exception',\n1059→            'message' => $exception->getMessage(),\n1060→        ]);\n1061→        throw $exception;\n1062→    }\n1063→}\n1064→\n1065→function normalizeFilterParameters(array $query): array\n1066→{\n1067→    $rawKeyword = isset($query['keyword']) && is_string($query['keyword']) ? $query['keyword'] : '';\n1068→    $rawStatus = isset($query['status']) && is_string($query['status']) ? $query['status'] : '';\n1069→    $rawPriority = isset($query['priority']) && is_string($query['priority']) ? $query['priority'] : '';\n1070→    $rawTagId = isset($query['tag_id']) && is_string($query['tag_id']) ? $query['tag_id'] : '';\n1071→    $keyword = trim($rawKeyword);\n1072→    $status = trim($rawStatus);\n1073→    $priority = trim($rawPriority);\n1074→    $tagId = trim($rawTagId);\n1075→    $errors = [];\n1076→\n1077→    if (stringLength($keyword) > MAX_SEARCH_KEYWORD_LENGTH) {\n1078→        $errors['keyword'] = '关键词不能超过 ' . MAX_SEARCH_KEYWORD_LENGTH . ' 个字符，已自动截断后搜索。';\n1079→        if (function_exists('mb_substr')) {\n1080→            $keyword = mb_substr($keyword, 0, MAX_SEARCH_KEYWORD_LENGTH, 'UTF-8');\n1081→        } else {\n1082→            $keyword = substr($keyword, 0, MAX_SEARCH_KEYWORD_LENGTH);\n1083→        }\n1084→    }\n1085→\n1086→    if ($status !== '' && !isAllowedTaskStatus($status)) {\n1087→        $errors['status'] = '状态筛选参数无效，已忽略该条件。';\n1088→        $status = '';\n1089→    }\n1090→\n1091→    if ($priority !== '' && !isAllowedTaskPriority($priority)) {\n1092→        $errors['priority'] = '优先级筛选参数无效，已忽略该条件。';\n1093→        $priority = '';\n1094→    }\n1095→\n1096→    if ($tagId !== '' && !preg_match('/^tag-\\d+-[a-f0-9]+$/', $tagId)) {\n1097→        $errors['tag_id'] = '标签筛选参数无效，已忽略该条件。';\n1098→        $tagId = '';\n1099→    }\n1100→\n1101→    return [\n1102→        'keyword' => $keyword,\n1103→        'status' => $status,\n1104→        'priority' => $priority,\n1105→        'tag_id' => $tagId,\n1106→        'errors' => $errors,\n1107→        'raw_keyword_length' => stringLength($rawKeyword),\n1108→        'raw_status' => $rawStatus,\n1109→        'raw_priority' => $rawPriority,\n1110→        'raw_tag_id' => $rawTagId,\n1111→    ];\n1112→}\n1113→\n1114→function filterTasks(array $tasks, string $keyword, string $status, string $priority, string $tagId = ''): array\n1115→{\n1116→    if ($keyword === '' && $status === '' && $priority === '' && $tagId === '') {\n1117→        return $tasks;\n1118→    }\n1119→\n1120→    $filteredTasks = [];\n1121→    foreach ($tasks as $task) {\n1122→        $matchesKeyword = $keyword === ''\n1123→            || stringContainsInsensitive((string) ($task['title'] ?? ''), $keyword)\n1124→            || stringContainsInsensitive((string) ($task['content'] ?? ''), $keyword);\n1125→        $matchesStatus = $status === '' || (string) ($task['status'] ?? '') === $status;\n1126→        $matchesPriority = $priority === '' || normalizeTaskPriority((string) ($task['priority'] ?? '')) === $priority;\n1127→        $matchesTag = $tagId === '' || in_array($tagId, $task['tag_ids'] ?? [], true);\n1128→\n1129→        if ($matchesKeyword && $matchesStatus && $matchesPriority && $matchesTag) {\n1130→            $filteredTasks[] = $task;\n1131→        }\n1132→    }\n1133→\n1134→    return $filteredTasks;\n1135→}\n1136→\n1137→function normalizeTagName(string $name): string\n1138→{\n1139→    $normalized = preg_replace('/\\s+/u', ' ', trim($name));\n1140→    return is_string($normalized) ? $normalized : trim($name);\n1141→}\n1142→\n1143→function createTagId(): string\n1144→{\n1145→    try {\n1146→        return 'tag-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n1147→    } catch (Throwable $exception) {\n1148→        return 'tag-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n1149→    }\n1150→}\n1151→\n1152→function loadTags(): array\n1153→{\n1154→    writeDebugLog('tag_list_load', [\n1155→        'database_file' => basename(DB_FILE),\n1156→    ], 'started');\n1157→\n1158→    try {\n1159→        $pdo = getDatabaseConnection();\n1160→        $statement = $pdo->query(\n1161→            \"SELECT t.id,\n1162→                    t.name,\n1163→                    t.color,\n1164→                    t.created_at,\n1165→                    t.updated_at,\n1166→                    COUNT(DISTINCT tt.task_id) AS task_count\n1167→            FROM tags t\n1168→            LEFT JOIN task_tags tt ON tt.tag_id = t.id\n1169→            LEFT JOIN tasks ta ON ta.id = tt.task_id AND ta.deleted_at IS NULL\n1170→            GROUP BY t.id, t.name, t.color, t.created_at, t.updated_at\n1171→            ORDER BY t.name COLLATE NOCASE ASC\"\n1172→