og('task_category_assign', [\n2303→            'task_id' => $taskId,\n2304→            'previous_category_id' => $previousCategoryId,\n2305→            'category_id' => $categoryId,\n2306→            'form_action' => 'edit',\n2307→        ], 'success', [\n2308→            'changed' => $previousCategoryId !== $categoryId,\n2309→            'has_category' => $categoryId !== '',\n2310→            'database_file' => basename(DB_FILE),\n2311→            'updated_at' => $updatedAt,\n2312→        ]);\n2313→\n2314→        writeDebugLog('task_due_at_save', [\n2315→            'task_id' => $taskId,\n2316→            'due_at' => $dueAt,\n2317→            'form_action' => 'edit',\n2318→        ], 'success', [\n2319→            'database_file' => basename(DB_FILE),\n2320→            'previous_due_at' => normalizeStoredDueAt($existingTask['due_at'] ?? ''),\n2321→            'changed' => normalizeStoredDueAt($existingTask['due_at'] ?? '') !== $dueAt,\n2322→            'saved_value' => $dueAt !== '' ? $dueAt : null,\n2323→            'updated_at' => $updatedAt,\n2324→        ]);\n2325→\n2326→        writeDebugLog('task_priority_update', [\n2327→            'task_id' => $taskId,\n2328→            'previous_priority' => normalizeTaskPriority((string) ($existingTask['priority'] ?? DEFAULT_TASK_PRIORITY)),\n2329→            'new_priority' => $priority,\n2330→        ], 'success', [\n2331→            'changed' => normalizeTaskPriority((string) ($existingTask['priority'] ?? DEFAULT_TASK_PRIORITY)) !== $priority,\n2332→            'updated_at' => $updatedAt,\n2333→            'allowed_priorities' => ALLOWED_PRIORITIES,\n2334→        ]);\n2335→\n2336→        return 'success';\n2337→    } catch (Throwable $exception) {\n2338→        writeDebugLog('task_edit_save_exception', [\n2339→            'task_id' => $taskId,\n2340→            'title_length' => stringLength($title),\n2341→            'content_length' => stringLength($content),\n2342→            'status' => $status,\n2343→            '