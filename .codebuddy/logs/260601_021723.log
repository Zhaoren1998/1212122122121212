DueAt);\n 253→    return $timestamp === false ? '' : date('Y-m-d\\TH:i', $timestamp);\n 254→}\n 255→\n 256→function buildDueAtState(array $task, string $source): array\n 257→{\n 258→    $taskId = isset($task['id']) && is_string($task['id']) ? $task['id'] : '';\n 259→    $dueAt = normalizeStoredDueAt($task['due_at'] ?? '');\n 260→    $nowTimestamp = time();\n 261→    $todayStart = strtotime(date('Y-m-d 00:00:00', $nowTimestamp));\n 262→    $todayEnd = strtotime(date('Y-m-d 23:59:59', $nowTimestamp));\n 263→\n 264→    if ($dueAt === '') {\n 265→        writeDebugLog('task_due_at_status_calculate', [\n 266→            'task_id' => $taskId,\n 267→            'due_at' => '',\n 268→            'source' => $source,\n 269→        ], 'success', [\n 270→            'result_status' => '未设置',\n 271→            'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 272→            'has_due_at' => false,\n 273→        ]);\n 274→        return [\n 275→            'label' => '未设置',\n 276→            'class' => 'due-none',\n 277→            'description' => '未设置截止时间',\n 278→            'datetime' => '',\n 279→        ];\n 280→    }\n 281→\n 282→    $dueTimestamp = strtotime($dueAt);\n 283→    if ($dueTimestamp === false) {\n 284→        writeDebugLog('task_due_at_status_calculate', [\n 285→            'task_id' => $taskId,\n 286→            'due_at' => $dueAt,\n 287→            'source' => $source,\n 288→        ], 'failed', [\n 289→            'reason' => 'stored_due_at_unparseable',\n 290→            'result_status' => '无效日期',\n 291→            'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 292→        ]);\n 293→        return [\n 294→            'label' => '无效日期',\n 295→            'class' => 'due-invalid',\n 296→            'description' => '截止时间格式异常',\n 297→            'datetime' => $dueAt,\n 298→        ];\n 299→    }\n 300→\n 301→    if ($dueTimestamp < $nowTimestamp) {\n 302→        $label = '已逾期';\n 303→        $class = 'due-overdue';\n 304→    } elseif ($todayStart !== false && $todayEnd !== false && $dueTimestamp >= $todayStart && $dueTimestamp <= $todayEnd) {\n 305→        $label = '今日到期';\n 306→        $class = 'due-today';\n 307→    } else {\n 308→        $label = '未到期';\n 309→        $class = 'due-future';\n 310→    }\n 311→\n 312→    writeDebugLog('task_due_at_status_calculate', [\n 313→        'task_id' => $taskId,\n 314→        'due_at' => $dueAt,\n 315→        'source' => $source,\n 316→    ], 'success', [\n 317→        'result_status' => $label,\n 318→        'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 319→        'due_timestamp' => $dueTimestamp,\n 320→        'has_due_at' => true,\n 321→    ]);\n 322→\n 323→    return [\n 324→        'label' => $label,\n 325→        'class' => $class,\n 326→        'description' => formatDateTime($dueAt),\n 327→        'datetime' => $dueAt,\n 328→    ];\n 329→}\n 330→\n 331→function normalizeTask(array $task, int $index): array\n 332→{\n 333→    $createdAt = isset($task['created_at']) && is_string($task['created_at']) && trim($task['created_at']) !== ''\n 334→        ? trim($task['created_at'])\n 335→        : '1970-01-01 00:00:00';\n 336→    $updatedAt = isset($task['updated_at']) && is_string($task['updated_at']) && trim($task['updated_at']) !== ''\n 337→        ? trim($task['updated_at'])\n 338→        : $createdAt;\n 339→\n 340→    $rawStatus = isset($task['status']) && is_string($task['status']) && trim($task['status']) !== ''\n 341→        ? trim($task['status'])\n 342→        : '未开始';\n 343→    $rawPriority = isset($task['priority']) && is_string($task['priority']) && trim($task['priority']) !== ''\n 344→        ? trim($task['priority'])\n 345→        : DEFAULT_TASK_PRIORITY;\n 346→\n 347→    return [\n 348→        'id' => isset($task['id']) && is_string($task['id']) && trim($task['id']) !== ''\n 349→            ? trim($task['id'])\n 350→            : 'task-' . $index,\n 351→        'title' => isset($task['title']) && is_string($task['title'])\n 352→            ? $task['title']\n 353→            : '未命名任务',\n 354→        'content' => isset($task['content']) && is_string($task['content'])\n 355→            ? $task['content']\n 356→            : '',\n 357→        'status' => normalizeTaskStatus($rawStatus),\n 358→        'priority' => normalizeTaskPriority($rawPriority),\n 359→        'category_id' => isset($task['category_id']) && is_string($task['category_id'])\n 360→            ? trim($task['category_id'])\n 361→            : '',\n 362→        'category_name' => isset($task['category_name']) && is_string($task['category_name'])\n 363→            ? trim($task['category_name'])\n 364→            : '',\n 365→        'due_at' => normalizeStoredDueAt($task['due_at'] ?? ''),\n 366→        'created_at' => $createdAt,\n 367→        'updated_at' => $updatedAt,\n 368→        'archived_at' => isset($task['archived_at']) && is_string($task['archived_at'])\n 369→            ? trim($task['archived_at'])\n 370→            : '',\n 371→    ];\n 372→}\n 373→\n 374→function stringLength(string $value): int\n 375→{\n 376→    if (function_exists('mb_strlen')) {\n 377→        return mb_strlen($value, 'UTF-8');\n 378→    }\n 379→\n 380→    return strlen($value);\n 381→}\n 382→\n 383→function normalizeSearchText(string $value): string\n 384→{\n 385→    $normalized = preg_replace('/\\s+/u', ' ', trim($value));\n 386→    if (!is_string($normalized)) {\n 387→        $normalized = trim($value);\n 388→    }\n 389→\n 390→    return function_exists('mb_strtolower') ? mb_strtolower($normalized, 'UTF-8') : strtolower($normalized);\n 391→}\n 392→\n 393→function stringContainsInsensitive(string $haystack, string $needle): bool\n 394→{\n 395→    if ($needle === '') {\n 396→        return true;\n 397→    }\n 398→\n 399→    $normalizedHaystack = normalizeSearchText($haystack);\n 400→    $normalizedNeedle = normalizeSearchText($needle);\n 401→\n 402→    if (function_exists('mb_strpos')) {\n 403→        return mb_strpos($normalizedHaystack, $normalizedNeedle, 0, 'UTF-8') !== false;\n 40