$categoryId,\n1796→            'name_length' => stringLength($name),\n1797→        ], 'success', [\n1798→            'sort_order' => $sortOrder,\n1799→            'database_file' => basename(DB_FILE),\n1800→            'created_at' => $now,\n1801→        ]);\n1802→\n1803→        return 'success';\n1804→    } catch (Throwable $exception) {\n1805→        writeDebugLog('category_create', [\n1806→            'category_id' => $categoryId,\n1807→            'name_length' => stringLength($name),\n1808→        ], 'failed', [\n1809→            'reason' => 'database_write_exception',\n1810→            'message' => $exception->getMessage(),\n1811→            'database_file' => basename(DB_FILE),\n1812→        ]);\n1813→        return 'exception';\n1814→    }\n1815→}\n1816→\n1817→function saveUpdatedCategory(string $categoryId, string $name): string\n1818→{\n1819→    writeDebugLog('category_update', [\n1820→        'category_id' => $categoryId,\n1821→        'name_length' => stringLength($name),\n1822→    ], 'started');\n1823→\n1824→    try {\n1825→        $pdo = getDatabaseConnection();\n1826→        $existingStatement = $pdo->prepare('SELECT id, name FROM categories WHERE id = :id LIMIT 1');\n1827→        $existingStatement->execute([':id' => $categoryId]);\n1828→        $existingCategory = $existingStatement->fetch();\n1829→        $existingStatement->closeCursor();\n1830→\n1831→        if (!is_array($existingCategory)) {\n1832→            writeDebugLog('category_update', [\n1833→                'category_id' => $categoryId,\n1834→                'name_length' => stringLength($name),\n1835→            ], 'failed', [\n1836→                'reason' => $categoryId === '' ? 'empty_category_id' : 'missing_category',\n1837→            ]);\n1838→            return 'not_found';\n1839→        }\n1840→\n1841→        $updatedAt = date('Y-m-d H:i:s');\n1842→        $statement = $pdo->prepare(\n1843→            \"UPDATE categories\n1844→            SET name = :name,\n1845→               