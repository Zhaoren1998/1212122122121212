ategoryId,\n1896→            ], 'failed', [\n1897→                'reason' => $categoryId === '' ? 'empty_category_id' : 'missing_category',\n1898→            ]);\n1899→            return 'not_found';\n1900→        }\n1901→\n1902→        $countStatement = $pdo->prepare(\n1903→            'SELECT COUNT(*) AS total_count,\n1904→                    SUM(CASE WHEN deleted_at IS NULL THEN 1 ELSE 0 END) AS active_count\n1905→            FROM tasks\n1906→            WHERE category_id = :category_id'\n1907→        );\n1908→        $countStatement->execute([':category_id' => $categoryId]);\n1909→        $usage = $countStatement->fetch();\n1910→        $countStatement->closeCursor();\n1911→        $totalReferenceCount = is_array($usage) && isset($usage['total_count']) ? (int) $usage['total_count'] : 0;\n1912→        $activeReferenceCount = is_array($usage) && isset($usage['active_count']) ? (int) $usage['active_count'] : 0;\n1913→\n1914→        if ($totalReferenceCount > 0) {\n1915→            writeDebugLog('category_reference_delete_protected', [\n1916→                'category_id' => $categoryId,\n1917→                'category_name' => (string) $existingCategory['name'],\n1918→            ], 'failed', [\n1919→                'reason' => 'category_is_referenced_by_tasks',\n1920→                'reference_count' => $totalReferenceCount,\n1921→                'active_reference_count' => $activeReferenceCount,\n1922→                'delete_blocked' => true,\n1923→                'database_integrity_preserved' => true,\n1924→            ]);\n1925→            return 'in_use';\n1926→        }\n1927→\n1928→        $deleteStatement = $pdo->prepare('DELETE FROM categories WHERE id = :id');\n1929→        $deleteStatement->execute([':id' => $categoryId]);\n1930→        $changedRows = $deleteStatement->rowCount();\n1931→        $deleteStatement->closeCursor();\n1932→\n1933→        writeDebugLog('category_delete', [\n1934→            'category_id' => $categoryId,\n1935→            'categ