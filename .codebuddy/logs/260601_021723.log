tent, string $status, string $priority, string $dueAtInput, string $categoryId, array $categories, string $formAction, string $taskId = ''): array\n2039→{\n2040→    $errors = [];\n2041→    $trimmedTitle = trim($title);\n2042→    $trimmedContent = trim($content);\n2043→\n2044→    if ($trimmedTitle === '') {\n2045→        $errors['title'] = '任务标题不能为空。';\n2046→    } elseif (stringLength($trimmedTitle) > MAX_TITLE_LENGTH) {\n2047→        $errors['title'] = '任务标题不能超过 ' . MAX_TITLE_LENGTH . ' 个字符。';\n2048→    }\n2049→\n2050→    if (stringLength($trimmedContent) > MAX_CONTENT_LENGTH) {\n2051→        $errors['content'] = '任务内容不能超过 ' . MAX_CONTENT_LENGTH . ' 个字符。';\n2052→    }\n2053→\n2054→    if (!isAllowedTaskStatus($status)) {\n2055→        $errors['status'] = '请选择有效的任务状态。';\n2056→    }\n2057→\n2058→    if (!isAllowedTaskPriority($priority)) {\n2059→        $errors['priority'] = '请选择有效的任务优先级。';\n2060→    }\n2061→\n2062→    $dueAtValidation = validateDueAtInput($dueAtInput);\n2063→    if (!$dueAtValidation['valid']) {\n2064→        $errors['due_at'] = $dueAtValidation['error'];\n2065→    }\n2066→\n2067→    $categoryValidation = validateTaskCategoryId($categoryId, $categories, $formAction, $taskId);\n2068→    if (!$categoryValidation['valid']) {\n2069→        $errors['category_id'] = $categoryValidation['error'];\n2070→    }\n2071→\n2072→    return $errors;\n2073→}\n2074→\n2075→function buildStatusCounts(array $tasks): array\n2076→{\n2077→    $counts = [];\n2078→    foreach (ALLOWED_STATUSES as $status) {\n2079→        $counts[$status] = 0;\n2080→    }\n2081→\n2082→    foreach ($tasks as $task) {\n2083→        $status = isset($task['status']) && is_string($task['status']) ? normalizeTaskStatus($task['status']) : '未开始';\n2084→        if (!isset($counts[$status])) {\n2085→            $counts[$status] = 0;\n2086→        }\n2087→        $counts[$status]++;\n2088→    }\n2089→\n2090→    return $counts;\n2091→}\n2092→\n2093→function findTaskById(array $tasks, string $taskId): ?array\n2094→{\n2095→    foreach ($tasks as $task) {\n2096→        if (($task['id'] ?? '') === $taskId) {\n2097→            return $task;\n2098→        }\n2099→    }\n2100→\n2101→    return null;\n2102→}\n2103→\n2104→function createTaskId(): string\n2105→{\n2106→    try {\n2107→        return 'task-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n2108→    } catch (Throwable $exception) {\n2109→        return 'task-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n2110→    }\n2111→}\n2112→\n2113→function saveNewTask(array $task): bool\n2114→{\n2115→    try {\n2116→        $pdo = getDatabaseConnection();\n2117→        $now = date('Y-m-d H:i:s');\n2118→        $createdAt = isset($task['created_at']) && is_string($task['created_at']) && trim($task['created_at']) !== ''\n2119→            ? trim($task['created_at'])\n2120→            : $now;\n2121→        $updatedAt = isset($task['updated_at']) && is_string($task['updated_at']) && trim($task['updated_at']) !== ''\n2122→            ? trim($task['updated_at'])\n2123→            : $createdAt;\n2124→        $archivedAt = (string) $task['status'] === '已归档' ? $updatedAt : null;\n2125→        $priority = normalizeTaskPriority((string) ($task['priority'] ?? DEFAULT_TASK_PRIORITY));\n2126→        $dueAt = normalizeStoredDueAt($task['due_at'] ?? '');\n2127→        $categoryId = isset($task['category_id']) && is_string($task['category_id']) && trim($task['category_id']) !== ''\n2128→            ? trim($task['category_id'])\n2129→            : null;\n2130→        $statement = $pdo->prepare(\n2131→            \"INSERT INTO tasks\n2132→            (id, title, content, status, priority, category_id, due_at, archived_at, deleted_at, created_at, updated_at)\n2133→            VALUES\n2134→            (:id, :title, :content, :status, :priority, :category_id, :due_at, :archived_at, NULL, :created_at, :updated_at)\"\n2135→        );\n2136→\n2137→        $statement->execute([\n2138→            ':id' => (string) $task['id'],\