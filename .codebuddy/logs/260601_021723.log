sistDebugLogToDatabase(array $entry): void\n  49→{\n  50→    if (!empty($GLOBALS['isPersistingDebugLog']) || !empty($GLOBALS['suppressDatabaseDebugLog']) || !extension_loaded('pdo_sqlite')) {\n  51→        return;\n  52→    }\n  53→\n  54→    $GLOBALS['isPersistingDebugLog'] = true;\n  55→\n  56→    try {\n  57→        $dataDirectory = dirname(DB_FILE);\n  58→        if (!is_dir($dataDirectory) && !mkdir($dataDirectory, 0775, true) && !is_dir($dataDirectory)) {\n  59→            return;\n  60→        }\n  61→\n  62→        $pdo = new PDO('sqlite:' . DB_FILE);\n  63→        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n  64→        $pdo->exec('PRAGMA busy_timeout = 5000');\n  65→        $pdo->exec(\"CREATE TABLE IF NOT EXISTS operation_logs (\n  66→            id INTEGER PRIMARY KEY AUTOINCREMENT,\n  67→            operation TEXT NOT NULL,\n  68→            parameters_json TEXT NOT NULL DEFAULT '{}',\n  69→            status TEXT NOT NULL,\n  70→            context_json TEXT NOT NULL DEFAULT '{}',\n  71→            created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n  72→        )\");\n  73→\n  74→        $parametersJson = json_encode($entry['parameters'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n  75→        $contextJson = json_encode($entry['context'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n  76→        $statement = $pdo->prepare(\n  77→            'INSERT INTO operation_logs (operation, parameters_json, status, context_json, created_at)\n  78→            VALUES (:operation, :parameters_json, :status, :context_json, :created_at)'\n  79→        );\n  80→        $statement->execute([\n  81→            ':operation' => (string) ($entry['operation'] ?? 'unknown'),\n  82→            ':parameters_json' => is_string($parametersJson) ? $parametersJson : '{}',\n  83→            ':status' => (string) ($entry['status'] ?? 'unknown'),\n  84→            ':context_json' => is_string($contextJson) ? $contextJson : '{}',\n  85→            ':created_at' => (string) ($entry['timestamp'] ?? date('Y-m-d H:i:s')),\n  86→        ]);\n  87→    } catch (Throwable $exception) {\n  88→        $GLOBALS['lastDebugLogDatabaseError'] = $exception->getMessage();\n  89→    } finally {\n  90→        $GLOBALS['isPersistingDebugLog'] = false;\n  91→    }\n  92→}\n  93→\n  94→function escapeHtml(string $value): string\n  95→{\n  96→    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n  97→}\n  98→\n  99→function normalizeTaskStatus(string $status, string $fallback = '未开始'): string\n 100→{\n 101→    $trimmedStatus = trim($status);\n 102→    if (isset(LEGACY_STATUS_MAP[$trimmedStatus])) {\n 103→        return LEGACY_STATUS_MAP[$trimmedStatus];\n 104→    }\n 105→\n 106→    if (in_array($trimmedStatus, ALLOWED_STATUSES, true)) {\n 107→        return $trimmedStatus;\n 108→    }\n 109→\n 110→    return in_array($fallback, ALLOWED_STATUSES, true) ? $fallback : '未开始';\n 111→}\n 112→\n 113→function isAllowedTaskStatus(string $status): bool\n 114→{\n 115→    return in_array(trim($status), ALLOWED_STATUSES, true);\n 116→}\n 117→\n 118→function normalizeTaskPriority(string $priority, string $fallback = DEFAULT_TASK_PRIORITY): string\n 119→{\n 120→    $trimmedPriority = trim($priority);\n 121→    if (in_array($trimmedPriority, ALLOWED_PRIORITIES, true)) {\n 122→        return $trimmedPriority;\n 123→    }\n 124→\n 125→    return in_array($fallback, ALLOWED_PRIORITIES, true) ? $fallback : DEFAULT_TASK_PRIORITY;\n 126→}\n 127→\n 128→function isAllowedTaskPriority(string $priority): bool\n 129→{\n 130→    return in_array(trim($priority), ALLOWED_PRIORITIES, true);\n 131→}\n 132→\n 133→function getPriorityBadgeClass(string $priority): string\n 134→{\n 135→    $normalizedPriority = normalizeTaskPriority($priority);\n 136→    if ($normalizedPriority === '高') {\n 137→        return 'priority-high';\n 138→    }\n 139→    if ($normalizedPriority === '低') {\n 140→        return 'priority-low';\n 14