hivePreviousStatus = isset($existingTask['archive_previous_status']) && is_string($existingTask['archive_previous_status'])\n5795→            ? trim($existingTask['archive_previous_status'])\n5796→            : '';\n5797→        $archivedAt = $status === '已归档' ? ($currentArchivedAt !== '' ? $currentArchivedAt : $updatedAt) : null;\n5798→        $archivePreviousStatus = null;\n5799→        if ($status === '已归档') {\n5800→            $archivePreviousStatus = $previousStatus === '已归档'\n5801→                ? ($currentArchivePreviousStatus !== '' ? normalizeTaskStatus($currentArchivePreviousStatus) : '未开始')\n5802→                : $previousStatus;\n5803→        }\n5804→        $previousRepeatRule = isset($existingTask['repeat_rule']) && is_string($existingTask['repeat_rule']) ? trim($existingTask['repeat_rule']) : '';\n5805→        $updateStatement = $pdo->prepare(\n5806→            \"UPDATE tasks\n5807→            SET title = :title,\n5808→                content = :content,\n5809→                status = :status,\n5810→                priority = :priority,\n5811→                category_id = :category_id,\n5812→                due_at = :due_at,\n5813→                repeat_rule = :repeat_rule,\n5814→                archived_at = :archived_at,\n5815→                archive_previous_status = :archive_previous_status,\n5816→                updated_at = :updated_at\n5817→            WHERE id = :id\n5818→                AND deleted_at IS NULL\"\n5819→        );\n5820→        $updateStatement->execute([\n5821→            ':title' => $title,\n5822→            ':content' => $content,\n5823→            ':status' => $status,\n5824→            ':priority' => $priority,\n5825→            ':category_id' => $categoryId !== '' ? $categoryId : null,\n5826→            ':due_at' => $dueAt !== '' ? $dueAt : null,\n5827→            ':repeat_rule' => $repeatRule !== '' ? $repeatRule : null,\n5828→            ':archived_at' => $archivedAt,\n5829→            ':archive_previous_status' => $archivePreviousStatus,\n5830→            ':updated_at' => $updatedAt,\n5831→            ':id' => $taskId,\n5832→        ]);\n5833→        $changedRows = $updateStatement->rowCount();\n5834→        $updateStatement->closeCursor();\n5835→\n5836→        $countStatement = $pdo->query('SELECT COUNT(*) FROM tasks WHERE deleted_at IS NULL');\n5837→        $taskCount = $countStatement !== false ? (int) $countStatement->fetchColumn() : 0;\n5838→        if ($countStatement !== false) {\n5839→            $countStatement->closeCursor();\n5840→        }\n5841→\n5842→        writeDebugLog('task_edit_save_success', [\n5843→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_t75qb87jf9f3_1","__timestamp":"2026-06-01T03:36:10.179Z","_requestId":"4b732ce9b35e469fa430352cde009a98"}

