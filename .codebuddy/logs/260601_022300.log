xistingTask = $existingStatement->fetch();\n2351→        $existingStatement->closeCursor();\n2352→\n2353→        if (!is_array($existingTask)) {\n2354→            writeDebugLog('task_edit_not_found', [\n2355→                'task_id' => $taskId,\n2356→                'title_length' => stringLength($title),\n2357→                'content_length' => stringLength($content),\n2358→                'status' => $status,\n2359→                'priority' => $priority,\n2360→                'category_id' => $categoryId,\n2361→                'due_at' => $dueAt,\n2362→            ], 'failed', [\n2363→                'stage' => 'save',\n2364→            ]);\n2365→            return 'not_found';\n2366→        }\n2367→\n2368→        $updatedAt = date('Y-m-d H:i:s');\n2369→        $currentArchivedAt = isset($existingTask['archived_at']) && is_string($existingTask['archived_at'])\n2370→            ? trim($existingTask['archived_at'])\n2371→            : '';\n2372→        $archivedAt = $status === '已归档' ? ($currentArchivedAt !== '' ? $currentArchivedAt : $updatedAt) : null;\n2373→        $updateStatement = $pdo->prepare(\n2374→            \"UPDATE tasks\n2375→            SET title = :title,\n2376→                content = :content,\n2377→                status = :status,\n2378→                priority = :priority,\n2379→                category_id = :category_id,\n2380→                due_at = :due_at,\n2381→                archived_at = :archived_at,\n2382→                updated_at = :updated_at\n2383→            WHERE id = :id\n2384→                AND deleted_at IS NULL\"\n2385→        );\n2386→        $updateStatement->execute([\n2387→            ':title' => $title,\n2388→            ':content' => $content,\n2389→            ':status' => $status,\n2390→            ':priority' => $priority,\n2391→            ':category_id' => $categoryId !== '' ? $categoryId : null,\n2392→            ':due_at' => $dueAt !== '' ? $dueAt : null,\n2393→            ':archived_at' => $archivedAt,\n2394→            ':updated_at' => $updatedAt,\n2395→            ':id' => $taskId,\n2396→        ]);\n2397→        $updateStatement->closeCursor();\n2398→\n2399→        $countStatement = $pdo->query('SELECT COUNT(*) FROM tasks WHERE deleted_at IS NULL');\n2400→        $taskCount = $countStatement !== false ? (int) $countStatement->fetchColumn() : 0;\n2401→        if ($countStatement !== false) {\n2402→            $countStatement->closeCursor();\n2403→        }\n2404→\n2405→        writeDebugLog('task_edit_save_success', [\n2406→            'task_id' => $taskId,\n2407→            'title_length' => stringLength($title),\n2408→            'content_length' => stringLength($content),\n2409→            'status' => $status,\n2410→            'priority' => $priority,\n2411→            'category_id' => $categoryId,\n2412→            'due_at' => $dueAt,\n2413→        ], 'success', [\n2414→            'task_count' => $taskCount,\n2415→            'database_file' => basename(DB_FILE),\n2416→            'previous_status' => (string) $existingTask['status'],\n2417→            'previous_priority' => normalizeTaskPriority((string) ($existingTask['priority'] ?? DEFAULT_TASK_PRIORITY)),\n2418→            'previous_category_id' => isset($existingTask['category_id']) && is_string($existingTask['category_id']) ? trim($existingTask['category_id']) : '',\n2419→            'previous_due_at' => normalizeStoredDueAt($existingTask['due_at'] ?? ''),\n2420→            'created_at' => (string) $existingTask['created_at'],\n2421→            'updated_at' => $updatedAt,\n2422→            'archived_at' => $archivedAt,\n2423→        ]);\n2424→\n2425→        $previousCategoryId = isset($existingTask['category_id']) && is_string($existingTask['category_id']) ? trim($existingTask['category_id']) : '';\n2426→        writeDebugLog('task_category_assign', [\n2427→            'task_id' => $taskId,\n2428→            'previous_category_id' => $previousCategoryId,\n2429→            'category_id' => $categoryId,\n2430→            'form_action' => 'edit',\n2431→        ], 'success', [\n2432→            'changed' => $previousCategoryId !== $categoryId,\n2433→            'has_category' => $categoryId !== '',\n2434→            'database_file' => basename(DB_FILE),\n2435→            'updated_at' => $updatedAt,\n2436→        ]);\n2437→\n2438→        writeDebugLog('task_due_at_save', [\n2439→            'task_id' => $taskId,\n2440→            'due_at' => $dueAt,\n2441→            'form_action' => 'edit',\n2442→        ], 'success', [\n2443→            'database_file' => basename(DB_FILE),\n2444→            'previous_due_at' => normalizeStoredDueAt($existingTask['due_at'] ?? ''),\n2445→            'changed' => normalizeStoredDueAt($existingTask['due_at'] ?? '') !== $dueAt,\n2446→            'saved_value' => $dueAt !== '' ? $dueAt : null,\n2447→            'updated_at' => $updatedAt,\n2448→        ]);\n2449→\n2450→        writeDebugLog('task_priority_update', [\n2451→            'task_id' => $taskId,\n2452→            'previous_priority' => normalizeTaskPriority((string) ($existingTask['priority'] ?? DEFAULT_TASK_PRIORITY)),\n2453→            'new_priority' => $priority,\n2454→        ], 'success', [\n2455→            'changed' => normalizeTaskPriority((string) ($existingTask['priority'] ?? DEFAULT_TASK_PRIORITY)) !== $priority,\n2456→            'updated_at' => $updatedAt,\n2457→            'allowed_priorities' => ALLOWED_PRIORITIES,\n2458→        ]);\n2459→\n2460→        return 'success';\n2461→    } catch (Throwable $exception) {\n2462→        writeDebugLog('task_edit_save_exception', [\n2463→            'task_id' => $taskId,\n2464→            'title_length' => stringLength($title),\n2465→            'content_length' => stringLength($content),\n2466→            'status' => $status,\n2467→            'priority' => $priority,\n2468→            'category_id' => $categoryId,\n2469→            'due_at' => $dueAt,\n2470→        ], 'failed', [\n2471→            'reason' => 'database_write_exception',\n2472→            'message' => $exception->getMessage(),\n2473→            'database_file' => basename(DB_FILE),\n2474→        ]);\n2475→        return 'exception';\n2476→    }\n2477→}\n2478→\n2479→function updateTaskStatus(string $taskId, string $status): string\n2480→{\n2481→    if (!isAllowedTaskStatus($status)) {\n2482→        writeDebugLog('task_status_invalid_submit', [\n2483→            'task_id' => $taskId,\n2484→            'submitted_status' => $status,\n2485→        ], 'failed', [\n2486→            'reason' => 'status_outside_allowed_enum',\n2487→            'allowed_statuses' => ALLOWED_STATUSES,\n2488→        ]);\n2489→        return 'invalid_status';\n2490→    }\n2491→\n2492→    try {\n2493→        $pdo = getDatabaseConnection();\n2494→        $existingStatement = $pdo->prepare('SELECT id, title, status, archived_at, updated_at FROM tasks WHERE id = :id AND deleted_at IS NULL LIMIT 1');\n2495→        $existingStatement->execute([':id' => $taskId]);\n2496→        $existingTask = $existingStatement->fetch();\n2497→\n2498→        if (!is_array($existingTask)) {\n2499→            writeDebugLog('task_status_not_found', [\n2500→                'task_id' => $taskId,\n2501→                'submitted_status' => $status,\n2502→            ], 'failed', [\n2503→                'reason' => $taskId === '' ? 'empty_task_id' : 'missing_task',\n2504→            ]);\n2505→            return 'not_found';\n2506→        }\n2507→\n2508→        $previousStatus = isset($existingTask['status']) && is_string($existingTask['status']) ? trim($existingTask['status']) : '';\n2509→        if (!isAllowedTaskStatus($previousStatus)) {\n2510→            writeDebugLog('task_status_read_exception', [\n2511→                'task_id' => $taskId,\n2512→                'raw_status' => $previousStatus,\n2513→            ], 'failed', [\n2514→                'reason' => 'status_outside_allowed_enum_before_change',\n2515→                'normalized_status' => normalizeTaskStatus($previousStatus),\n2516→                'allowed_statuses' => ALLOWED_STATUSES,\n2517→            ]);\n2518→        }\n2519→\n2520→        $updatedAt = date('Y-m-d H:i:s');\n2521→        $currentArchivedAt = isset($existingTask['archived_at']) && is_string($existingTask['archived_at'])\n2522→            ? trim($existingTask['archived_at'])\n2523→            : '';\n2524→        $archivedAt = $status === '已归档' ? ($currentArchivedAt !== '' ? $currentArchivedAt : $updatedAt) : null;\n2525→        $statement = $pdo->prepare(\n2526→            'UPDATE tasks\n2527→            SET status = :status,\n2528→                archived_at = :archived_at,\n2529→                updated_at = :updated_at\n2530→            WHERE id = :id\n2531→                AND deleted_at IS NULL'\n2532→        );\n2533→        $statement->execute([\n2534→            ':status' => $status,\n2535→            ':archived_at' => $archivedAt,\n2536→            ':updated_at' => $updatedAt,\n2537→            ':id' => $taskId,\n2538→        ]);\n2539→\n2540→        writeDebugLog('task_status_change_success', [\n2541→            'task_id' => $taskId,\n2542→            'previous_status' => normalizeTaskStatus($previousStatus),\n2543→            'new_status' => $status,\n2544→        ], 'success', [\n2545→            'title_length' => stringLength((string) $existingTask['title']),\n2546→            'database_file' => basename(DB_FILE),\n2547→            'updated_at' => $updatedAt,\n2548→            'archived_at' => $archivedAt,\n2549→            'changed_rows' => $statement->rowCount(),\n2550→        ]);\n2551→\n2552→        return 'success';\n2553→    } catch (Throwable $exception) {\n2554→        writeDebugLog('task_status_change_exception', [\n2555→            'task_id' => $taskId,\n2556→            'submitted_status' => $status,\n2557→        ], 'failed', [\n2558→            'reason' => 'database_write_exception',\n2559→            'message' => $exception->getMessage(),\n2560→            'database_file' => bas