 t.id,\n2088→                    t.title,\n2089→                    t.content,\n2090→                    t.status,\n2091→                    t.priority,\n2092→                    t.category_id,\n2093→                    c.name AS category_name,\n2094→                    t.due_at,\n2095→                    t.archived_at,\n2096→                    t.created_at,\n2097→                    t.updated_at\n2098→            FROM tasks t\n2099→            LEFT JOIN categories c ON c.id = t.category_id\n2100→            WHERE t.deleted_at IS NULL\n2101→            ORDER BY CASE priority WHEN '高' THEN 1 WHEN '中' THEN 2 WHEN '低' THEN 3 ELSE 4 END ASC,\n2102→                datetime(t.created_at) DESC,\n2103→                t.id DESC\"\n2104→        );\n2105→        $rows = $statement !== false ? $statement->fetchAll() : [];\n2106→        $tasks = [];\n2107→        foreach ($rows as $index => $row) {\n2108→            if (is_array($row)) {\n2109→                $rawStatus = isset($row['status']) && is_string($row['status']) ? trim($row['status']) : '';\n2110→                if (!isAllowedTaskStatus($rawStatus)) {\n2111→                    writeDebugLog('task_status_read_exception', [\n2112→                        'task_id' => isset($row['id']) && is_string($row['id']) ? $row['id'] : '',\n2113→                        'raw_status' => $rawStatus,\n2114→                    ], 'failed', [\n2115→                        'reason' => 'status_outside_allowed_enum_on_read',\n2116→                        'normalized_status' => normalizeTaskStatus($rawStatus),\n2117→                        'allowed_statuses' => ALLOWED_STATUSES,\n2118→                    ]);\n2119→                }\n2120→                $rawPriority = isset($row['priority']) && is_string($row['priority']) ? trim($row['priority']) : '';\n2121→                if (!isAllowedTaskPriority($rawPriority)) {\n2122→                    writeDebugLog('task_priority_read_exception', [\n2123→                        'task_id' => isset($row['id']) && is_string($row['id']) ? $row['id'] : '',\n2124→                        'raw_priority' => $rawPriority,\n2125→                    ], 'failed', [\n2126→                        'reason' => 'priority_outside_allowed_enum_on_read',\n2127→                        'normalized_priority' => normalizeTaskPriority($rawPriority),\n2128→                        'allowed_priorities' => ALLOWED_PRIORITIES,\n2129→                    ]);\n2130→                }\n2131→                $task = normalizeTask($row, (int) $index);\n2132→                $taskId = $task['id'];\n2133→                $task['tag_ids'] = loadTagIdsForTask($pdo, $taskId);\n2134→                $task['tags'] = loadTagsForTask($pdo, $taskId);\n2135→                $tasks[] = $task;\n2136→            }\n2137→        }\n2138→\n2139→        if (count($tasks) === 0) {\n2140→            writeDebugLog('task_list_empty_data', ['database_file' => basename(DB_FILE)], 'success', [\n2141→                'reason' => 'no_database_rows',\n2142→                'task_count' => 0,\n2143→            ]);\n2144→        }\n2145→\n2146→        writeDebugLog('task_list_load', ['database_file' => basename(DB_FILE)], 'success', [\n2147→            'task_count' => count($tasks),\n2148→            'sort' => 'priority_then_created_at_desc',\n2149→        ]);\n2150→\n2151→        return $tasks;\n2152→    } catch (Throwable $exception) {\n2153→        setDatabaseErrorMessage('数据库读取失败，系统已保留页面可用性，请稍后重试或查看日志。');\n2154→        writeDebugLog('task_list_read_exception', ['database_file' => basename(DB_FILE)], 'failed', [\n2155→            'reason' => 'database_query_exception',\n2156→            'message' => $exception->getMessage(),\n2157→        ]);\n2158→        return [];\n2159→    }\n2160→}\n2161→\n2162→function validateTaskInput(string $title, string $content, string $status, string $priority, string $dueAtInput, string $categoryId, array $categories, string $formAction, string $taskId = ''): array\n2163→{\n2164→    $errors = [];\n2165→    $trimmedTitle = trim($title);\n2166→    $trimmedContent = trim($content);\n2167→\n2168→    if ($trimmedTitle === '') {\n2169→        $errors['title'] = '任务标题不能为空。';\n2170→    } elseif (stringLength($trimmedTitle) > MAX_TITLE_LENGTH) {\n2171→        $errors['title'] = '任务标题不能超过 ' . MAX_TITLE_LENGTH . ' 个字符。';\n2172→    }\n2173→\n2174→    if (stringLength($trimmedContent) > MAX_CONTENT_LENGTH) {\n2175→        $errors['content'] = '任务内容不能超过 ' . MAX_CONTENT_LENGTH . ' 个字符。';\n2176→    }\n2177→\n2178→    if (!isAllowedTaskStatus($status)) {\n2179→        $errors['status'] = '请选择有效的任务状态。';\n2180→    }\n2181→\n2182→    if (!isAllowedTaskPriority($priority)) {\n2183→        $errors['priority'] = '请选择有效的任务优先级。';\n2184→    }\n2185→\n2186→    $dueAtValidation = validateDueAtInput($dueAtInput);\n2187→    if (!$dueAtValidation['valid']) {\n2188→        $errors['due_at'] = $dueAtValidation['error'];\n2189→    }\n2190→\n2191→    $categoryValidation = validateTaskCategoryId($categoryId, $categories, $formAction, $taskId);\n2192→    if (!$categoryValidation['valid']) {\n2193→        $errors['category_id'] = $categoryValidation['error'];\n2194→    }\n2195→\n2196→    return $errors;\n2197→}\n2198→\n2199→function buildStatusCounts(array $tasks): array\n2200→{\n2201→    $counts = [];\n2202→    foreach (ALLOWED_STATUSES as $status) {\n2203→        $counts[$status] = 0;\n2204→    }\n2205→\n2206→    foreach ($tasks as $task) {\n2207→        $status = isset($task['status']) && is_string($task['status']) ? normalizeTaskStatus($task['status']) : '未开始';\n2208→        if (!isset($counts[$status])) {\n2209→            $counts[$status] = 0;\n2210→        }\n2211→        $counts[$status]++;\n2212→    }\n2213→\n2214→    return $counts;\n2215→}\n2216→\n2217→function findTaskById(array $tasks, string $taskId): ?array\n2218→{\n2219→    foreach ($tasks as $task) {\n2220→        if (($task['id'] ?? '') === $taskId) {\n2221→            return $task;\n2222→        }\n2223→    }\n2224→\n2225→    return null;\n2226→}\n2227→\n2228→function createTaskId(): string\n2229→{\n2230→    try {\n2231→        return 'task-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n2232→    } catch (Throwable $exception) {\n2233→        return 'task-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n2234→    }\n2235→}\n2236→\n2237→function saveNewTask(array $task): bool\n2238→{\n2239→    try {\n2240→        $pdo = getDatabaseConnection();\n2241→        $now = date('Y-m-d H:i:s');\n2242→        $createdAt = isset($task['created_at']) && is_string($task['created_at']) && trim($task['created_at']) !== ''\n2243→            ? trim($task['created_at'])\n2244→            : $now;\n2245→        $updatedAt = isset($task['updated_at']) && is_string($task['updated_at']) && trim($task['updated_at']) !== ''\n2246→            ? trim($task['updated_at'])\n2247→            : $createdAt;\n2248→        $archivedAt = (string) $task['status'] === '已归档' ? $updatedAt : null;\n2249→        $priority = normalizeTaskPriority((string) ($task['priority'] ?? DEFAULT_TASK_PRIORITY));\n2250→        $dueAt = normalizeStoredDueAt($task['due_at'] ?? '');\n2251→        $categoryId = isset($task['category_id']) && is_string($task['category_id']) && trim($task['category_id']) !== ''\n2252→            ? trim($task['category_id'])\n2253→            : null;\n2254→        $statement = $pdo->prepare(\n2255→            \"INSERT INTO tasks\n2256→            (id, title, content, status, priority, category_id, due_at, archived_at, deleted_at, created_at, updated_at)\n2257→            VALUES\n2258→            (:id, :title, :content, :status, :priority, :category_id, :due_at, :archived_at, NULL, :created_at, :updated_at)\"\n2259→        );\n2260→\n2261→        $statement->execute([\n2262→            ':id' => (string) $task['id'],\n2263→            ':title' => (string) $task['title'],\n2264→            ':content' => (string) $task['content'],\n2265→            ':status' => (string) $task['status'],\n2266→      