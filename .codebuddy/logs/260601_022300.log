ema_exception',\n 791→            'message' => $exception->getMessage(),\n 792→        ]);\n 793→        throw $exception;\n 794→    }\n 795→}\n 796→\n 797→function upsertSystemSetting(PDO $pdo, string $key, string $value): void\n 798→{\n 799→    $statement = $pdo->prepare(\n 800→        \"INSERT INTO system_settings (setting_key, setting_value, created_at, updated_at)\n 801→        VALUES (:setting_key, :setting_value, datetime('now', 'localtime'), datetime('now', 'localtime'))\n 802→        ON CONFLICT(setting_key) DO UPDATE SET\n 803→            setting_value = excluded.setting_value,\n 804→            updated_at = datetime('now', 'localtime')\"\n 805→    );\n 806→    $statement->execute([\n 807→        ':setting_key' => $key,\n 808→        ':setting_value' => $value,\n 809→    ]);\n 810→}\n 811→\n 812→function getSystemSetting(PDO $pdo, string $key): ?string\n 813→{\n 814→    $statement = $pdo->prepare('SELECT setting_value FROM system_settings WHERE setting_key = :setting_key LIMIT 1');\n 815→    $statement->execute([':setting_key' => $key]);\n 816→    $value = $statement->fetchColumn();\n 817→\n 818→    return is_string($value) ? $value : null;\n 819→}\n 820→\n 821→function migrateLegacyTasksJson(PDO $pdo): void\n 822→{\n 823→    if (getSystemSetting($pdo, 'legacy_json_migrated') === '1') {\n 824→        return;\n 825→    }\n 826→\n 827→    writeDebugLog('database_legacy_json_migration', [\n 828→        'data_file' => basename(DATA_FILE),\n 829→        'database_file' => basename(DB_FILE),\n 830→    ], 'started');\n 831→\n 832→    $migratedCount = 0;\n 833→    $skippedCount = 0;\n 834→\n 835→    try {\n 836→        if (file_exists(DATA_FILE)) {\n 837→            $rawJson = file_get_contents(DATA_FILE);\n 838→            if ($rawJson === false) {\n 839→                throw new RuntimeException('旧 JSON 数据文件读取失败。');\n 840→            }\n 841→\n 842→            $trimmedJson = trim($rawJson);\n 843→            if ($trimmedJson !== '') {\n 844→                $decoded = json_decode($trimmedJson, true);\n 845→                if (!is_array($decoded)) {\n 846→                    throw new RuntimeException('旧 JSON 数据格式无效：' . json_last_error_msg());\n 847→                }\n 848→\n 849→                $statement = $pdo->prepare(\n 850→                    \"INSERT OR IGNORE INTO tasks\n 851→                    (id, title, content, status, priority, category_id, due_at, archived_at, deleted_at, created_at, updated_at)\n 852→                    VALUES\n 853→                    (:id, :title, :content, :status, :priority, NULL, NULL, NULL, NULL, :created_at, :updated_at)\"\n 854→                );\n 855→\n 856→                foreach ($decoded as $index => $legacyTask) {\n 857→                    if (!is_array($legacyTask)) {\n 858→                        $skippedCount++;\n 859→                        continue;\n 860→                    }\n 861→\n 862→                    $task = normalizeTask($legacyTask, (int) $index);\n 863→                    $statement->execute([\n 864→                        ':id' => $task['id'],\n 865→                        ':title' => $task['title'],\n 866→                        ':content' => $task['content'],\n 867→                        ':status' => normalizeTaskStatus($task['status']),\n 868→                        ':priority' => '中',\n 869→                        ':created_at' => $task['created_at'],\n 870→                        ':updated_at' => $task['updated_at'],\n 871→                    ]);\n 872→\n 873→                    if ($statement->rowCount() > 0) {\n 874→                        $migratedCount++;\n 875→                    } else {\n 876→                        $skippedCount++;\n 877→                    }\n 878→                }\n 879→            }\n 880→        }\n 881→\n 882→        upsertSystemSetting($pdo, 'legacy_json_migrated', '1');\n 883→        writeDebugLog('database_legacy_json_migration', [\n 884→            'data_file' => basename(DATA_FILE),\n 885→            'database_file' => basename(DB_FILE),\n 886→        ], 'success', [\n 887→            'migrated_count' => $migratedCount,\n 888→            'skipped_count' => $skippedCount,\n 889→        ]);\n 890→    } catch (Throwable $exception) {\n 891→        writeDebugLog('database_legacy_json_migration', [\n 892→            'data_file' => basename(DATA_FILE),\n 893→            'database_file' => basename(DB_FILE),\n 894→        ], 'failed', [\n 895→            'reason' => 'migration_exception',\n 896→            'message' => $exception->getMessage(),\n 897→            'migrated_count' => $migratedCount,\n 898→            'skipped_count' => $skippedCount,\n 899→        ]);\n 900→        throw $exception;\n 901→    }\n 902→}\n 903→\n 904→function migrateTaskStatuses(PDO $pdo): void\n 905→{\n 906→    if (getSystemSetting($pdo, 'task_status_migrated_v2') === '1') {\n 907→        return;\n 908→    }\n 909→\n 910→    writeDebugLog('task_status_migration', [\n 911→        'database_file' => basename(DB_FILE),\n 912→        'allowed_statuses' => ALLOWED_STATUSES,\n 913→        'legacy_statuses' => array_keys(LEGACY_STATUS_MAP),\n 914→    ], 'started');\n 915→\n 916→    try {\n 917→        $statement = $pdo->query('SELECT id, status, archived_at FROM tasks WHERE deleted_at IS NULL');\n 918→        $rows = $statement !== false ? $statement->fetchAll() : [];\n 919→        $updatedCount = 0;\n 920→        $invalidCount = 0;\n 921→        $now = date('Y-m-d H:i:s');\n 922→        $updateStatement = $pdo->prepare(\n 923→            'UPDATE tasks\n 924→            SET status = :status,\n 925→                archived_at = :archived_at,\n 926→                updated_at = :updated_at\n 927→            WHERE id = :id'\n 928→        );\n 929→\n 930→        foreach ($rows as $row) {\n 931→            if (!is_array($row)) {\n 932→                continue;\n 933→            }\n 934→\n 935→            $taskId = isset($row['id']) && is_string($row['id']) ? $row['id'] : '';\n 936→            $rawStatus = isset($row['status']) && is_string($row['status']) ? trim($row['status']) : '';\n 937→            $normalizedStatus = normalizeTaskStatus($rawStatus);\n 938→            $archivedAt = isset($row['archived_at']) && is_string($row['archived_at']) ? trim($row['archived_at']) : '';\n 939→\n 940→            if ($taskId === '') {\n 941→                continue;\n 942→            }\n 943→\n 944→            if ($rawStatus !== $normalizedStatus) {\n 945→                $invalidCount++;\n 946→                writeDebugLog('task_status_read_exception', [\n 947→                    'task_id' => $taskId,\n 948→                    'raw_status' => $rawStatus,\n 949→                ], 'failed', [\n 950→                    'reason' => 'status_outside_allowed_enum',\n 951→                    'normalized_status' => $normalizedStatus,\n 952→                    'allowed_statuses' => ALLOWED_STATUSES,\n 953→                ]);\n 954→            }\n 955→\n 956→            $targetArchivedAt = $normalizedStatus === '已归档'\n 957→                ? ($archivedAt !== '' ? $archivedAt : $now)\n 958→                : null;\n 959→\n 960→            if ($rawStatus !== $normalizedStatus || ($normalizedStatus !== '已归档' && $archivedAt !== '') || ($normalizedStatus === '已归档' && $archivedAt === '')) {\n 961→                $updateStatement->execute([\n 962→                    ':status' => $normalizedStatus,\n 963→                    ':archived_at' => $targetArchivedAt,\n 964→                    ':updated_at' => $now,\n 965→                    ':id' => $taskId,\n 966→                ]);\n 967→                $updatedCount += $updateStatement->rowCount();\n 968→            }\n 969→        }\n 970→\n 971→        upsertSystemSetting($pdo, 'task_status_migrated_v2', '1');\n 972→        writeDebugLog('task_status_migration', [\n 973→            'database_file' => basename(DB_FILE),\n 974→        ], 'success', [\n 975→            'scanned_count' => count($rows),\n 976→            'updated_count' => $updatedCount,\n 977→            'invalid_status_count' => $invalidCount,\n 978→            'allowed_statuses' => ALLOWED_STATUSES,\n 979→        ]);\n 980→    } catch (Throwable $exception) {\n 981→        writeDebugLog('task_status_migration', [\n 982→            'database_file' => basename(DB_FILE),\n 983→        ], 'failed', [\n 984→            'reason' => 'status_migration_exception',\n 985→            'message' => $exception->getMessage(),\n 986→        ]);\n 987→        throw $exception;\n 988→    }\n 989→}\n 990→\n 991→function migrateTaskPriorities(PDO $pdo): void\n 992→{\n 993→    if (getSystemSetting($pdo, 'task_priority_migrated_v1') === '1') {\n 994→        return;\n 995→    }\n 996→\n 997→    writeDebugLog('task_priority_migration', [\n 998→        'database_file' => basename(DB_FILE),\n 999→        'allowed_priorities' => ALLOWED_PRIORITIES,\n1000→        'default_priority' => DEFAULT_TASK_PRIORITY,\n1001→    ], 'started');\n1002→\n1003→    try {\n1004→        $statement = $pdo->query('SELECT id, priority FROM tasks WHERE deleted_at IS NULL');\n1005→        $rows = $statement !== false ? $statement->fetchAll() : [];\n1006→        $updatedCount = 0;\n1007→        $invalidCount = 0;\n1008→        $now = date('Y-m-d H:i:s');\n1009→        $updateStatement = $pdo->prepare(\n1010→            'UPDATE tasks\n1011→            SET priority = :priority,\n1012→                updated_at = :updated_at\n1013→            WHERE id = :id'\n1014→        );\n1015→\n1016→        foreach ($rows as $row) {\n1017→            if (!is_array($row)) {\n1018→                continue;\n1019→            }\n1020→\n1021→            $taskId = isset($row['id']) && is_string($row['id']) ? $row['id'] : '';\n1022→            $rawPriority = isset($row['priority']) && is_string($row['priority']) ? trim($row['priority']) : '';\n1023→            $normalizedPriority = normalizeTaskPriority($rawPriority);\n1024→\n1025→            if ($taskId === '') {\n1026→                continue;\n1027→            }\n1028→\n1029→            if ($rawPriority !== $normalizedPriority) {\n1030→                $invalidCount++;\n1031→                writeDebugLog('task_priority_read_exception', [\n1032→                    'task_id' => $taskId,\n1033→                    'raw_priority' => $rawPriority,\n1034→                ], 'failed', [\n1035→                    'reason' => 'priority_outside_allowed_enum',\n1036→                    'normalized_priority' => $normalizedPriority,\n1037→                    'allowed_priorities' => ALLOWED_PRIORITIES,\n1038→                ]);\n1039→\n1040→                $updateStatement->execute([\n1041→                    ':priority' => $normalizedPriority,\n1042→                    ':updated_at' => $now,\n1043→                    ':id' => $taskId,\n1044→                ]);\n1045→                $updatedCount += $updateStatement->rowCount();\n1046→            }\n1047→        }\n1048→\n1049→        upsertSystemSetting($pdo, 'task_priority_migrated_v1', '1');\n1050→        writeDebugLog('task_priority_migration', [\n1051→            'database_file' => basename(DB_FILE),\n1052→        ], 'success', [\n1053→            'scanned_count' => count($rows),\n1054→            'updated_count' => $updatedCount,\n1055→            'invalid_priority_count' => $invalidCount,\n1056→            'allowed_priorities' => ALLOWED_PRIORITIES,\n1057→        ]);\n1058→    } catch (Throwable $exception) {\n1059→        writeDebugLog('task_priority_migration', [\n1060→            'database_file' => basename(DB_FILE),\n1061→        ], 'failed', [\n1062→            'reason' => 'priority_migration_exception',\n1063→            'message' => $exception->getMessage(),\n1064→        ]);\n1065→        throw $exception;\n1066→    }\n1067→}\n1068→\n1069→function normalizeFilterParameters(array $query): array\n1070→{\n1071→    $rawKeyword = isset($query['keyword']) && is_string($query['keyword']) ? $query['keyword'] : '';\n1072→    $rawStatus = isset($query['status']) && is_string($query['status']) ? $query['status'] : '';\n1073→    $rawPriority = isset($query['priority']) && is_string($query['priority']) ? $query['priority'] : '';\n1074→    $rawTagId = isset($query['tag_id']) && is_string($query['tag_id']) ? $query['tag_id'] : '';\n1075→    $keyword = trim($rawKeyword);\n1076→    $status = trim($rawStatus);\n1077→    $priority = trim($rawPriority);\n1078→    $tagId = trim($rawTagId);\n1079→    $errors = [];\n1080→\n1081→    if (stringLength($keyword) > MAX_SEARCH_KEYWORD_LENGTH) {\n1082→        $errors['keyword'] = '关键词不能超过 ' . MAX_SEARCH_KEYWORD_LENGTH . ' 个字符，已自动截断后搜索。';\n1083→        if (function_exists('mb_substr')) {\n1084→            $keyword = mb_substr($keyword, 0, MAX_SEARCH_KEYWORD_LENGTH, 'UTF-8');\n1085→        } else {\n1086→            $keyword = substr($keyword, 0, MAX_SEARCH_KEYWORD_LENGTH);\n1087→        }\n1088→    }\n1089→\n1090→    if ($status !== '' && !isAllowedTaskStatus($status)) {\n1091→        $errors['status'] = '状态筛选参数无效，已忽略该条件。';\n1092→        $status = '';\n1093→    }\n1094→\n1095→    if ($priority !== '' && !isAllowedTaskPriority($priority)) {\n1096→        $errors['priority'] = '优先级筛选参数无效，已忽略该条件。';\n1097→        $priority = '';\n1098→    }\n1099→\n1100→    if ($tagId !== '' && !preg_match('/^tag-\\d+-[a-f0-9]+$/', $tagId)) {\n1101→        $errors['tag_id'] = '标签筛选参数无效，已忽略该条件。';\n1102→        $tagId = '';\n1103→    }\n1104→\n1105→    return [\n1106→        'keyword' => $keyword,\n1107→        'status' => $status,\n1108→        'priority' => $priority,\n1109→        'tag_id' => $tagId,\n1110→        'errors' => $errors,\n1111→        'raw_keyword_length' => stringLength($rawKeyword),\n1112→        'raw_status' => $rawStatus,\n1113→        'raw_priority' => $rawPriority,\n1114→        'raw_tag_id' => $rawTagId,\n1115→    ];\n1116→}\n1117→\n1118→function filterTasks(array $tasks, string $keyword, string $status, string $priority, string $tagId = ''): array\n1119→{\n1120→    if ($keyword === '' && $status === '' && $priority === '' && $tagId === '') {\n1121→        return $tasks;\n1122→    }\n1123→\n1124→    $filteredTasks = [];\n1125→    foreach ($tasks as $task) {\n1126→        $matchesKeyword = $keyword === ''\n1127→            || stringContainsInsensitive((string) ($task['title'] ?? ''), $keyword)\n1128→            || stringContainsInsensitive((string) ($task['content'] ?? ''), $keyword);\n1129→        $matchesStatus = $status === '' || (string) ($task['status'] ?? '') === $status;\n1130→        $matchesPriority = $priority === '' || normalizeTaskPriority((string) ($task['priority'] ?? '')) === $priority;\n1131→        $matchesTag = $tagId === '' || in_array($tagId, $task['tag_ids'] ?? [], true);\n1132→\n1133→        if ($matchesKeyword && $matchesStatus && $matchesPriority && $matchesTag) {\n1134→            $filteredTasks[] = $task;\n1135→        }\n1136→    }\n1137→\n1138→    return $filteredTasks;\n1139→}\n1140→\n1141→function normalizeSortParameters(array $query): array\n1142→{\n1143→    $rawSortBy = isset($query['sort_by']) && is_string($query['sort_by']) ? trim($query['sort_by']) : '';\n1144→    $rawSortOrder = isset($query['sort_order']) && is_string($query['sort_order']) ? trim($query['sort_order']) : '';\n1145→    $sortBy = $rawSortBy;\n1146→    $sortOrder = $rawSortOrder;\n1147→    $errors = [];\n1148→\n1149→    if ($rawSortBy !== '' && !in_array($rawSortBy, ALLOWED_SORT_FIELDS, true)) {\n1150→        $errors['sort_by'] = '排序字段参数无效，已使用默认排序。';\n1151→        $sortBy = DEFAULT_SORT_FIELD;\n1152→        writeDebugLog('task_sort_parameter_exception', [\n1153→            'submitted_sort_by' => $rawSortBy,\n1154→        ], 'failed', [\n1155→            'reason' => 'invalid_sort_field',\n1156→            'allowed_fields' => ALLOWED_SORT_FIELDS,\n1157→            'default_field_applied' => DEFAULT_SORT_FIELD,\n1158→        ]);\n1159→    }\n1160→\n1161→    if ($rawSortOrder !== '' && !in_array($rawSortOrder, ALLOWED_SORT_ORDERS, true)) {\n1162→        $errors['sort_order'] = '排序方向参数无效，已使用默认排序。';\n1163→        $sortOrder = DEFAULT_SORT_ORDER;\n1164→        writeDebugLog('task_sort_parameter_exception', [\n1165→            'submitted_sort_order' => $rawSortOrder,\n1166→        ], 'failed', [\n1167→            'reason' => 'invalid_sort_order',\n1168→            'allowed_orders' => ALLOWED_SORT_ORDERS,\n1169→            'default_order_applied' => DEFAULT_SORT_ORDER,\n1170→        ]);\n1171→    }\n1172→\n1173→    if ($sortBy === '') {\n1174→        $sortBy = DEFAULT_SORT_FIELD;\n1175→    }\n1176→    if ($sortOrder === '') {\n1177→        $sortOrder = DEFAULT_SORT_ORDER;\n1178→    }\n1179→\n1180→    return [\n1181→        'sort_by' => $sortBy,\n1182→        'sort_order' => $sortOrder,\n1183→        'errors' => $errors,\n1184→        'raw_sort_by' => $rawSortBy,\n1185→        'raw_sort_order' => $rawSortOrder,\n1186→    ];\n1187→}\n1188→\n1189→function sortTasks(array $tasks, string $sortBy, string $sortOrder): array\n1190→{\n1191→    if (empty($tasks) || $sortBy === '') {\n1192→        return $tasks;\n1193→    }\n1194→\n1195→    $isAsc = $sortOrder === 'asc';\n1196→\n1197→    $priorityWeight = ['高' => 1, '中' => 2, '低' => 3];\n1198→    $statusWeight = ['未开始' => 1, '进行中' => 2, '已完成' => 3, '已归档' => 4];\n1199→\n1200→    usort($tasks, function ($a, $b) use ($sortBy, $isAsc, $priorityWeight, $statusWeight) {\n1201→        $valueA = null;\n1202→        $valueB = null;\n1203→\n1204→        switch ($sortBy) {\n1205→            case 'created_at':\n1206→                $valueA = strtotime($a['created_at'] ?? '1970-01-01 00:00:00');\n1207→                $valueB = strtotime($b['created_at'] ?? '1970-01-01 00:00:00');\n1208→                break;\n1209→            case 'updated_at':\n1210→                $valueA = strtotime($a['updated_at'] ?? '1970-01-01 00:00:00');\n1211→                $valueB = strtotime($b['updated_at'] ?? '1970-01-01 00:00:00');\n1212→                break;\n1213→            case 'due_at':\n1214→                $dueA = normalizeStoredDueAt($a['due_at'] ?? '');\n1215→                $dueB = normalizeStoredDueAt($b['due_at'] ?? '');\n1216→                if ($dueA === '' && $dueB === '') {\n1217→                    $valueA = PHP_INT_MAX;\n1218→                    $valueB = PHP_INT_MAX;\n1219→                } elseif ($dueA === '') {\n1220→                    $valueA = PHP_INT_MAX;\n1221→                    $valueB = strtotime($dueB);\n1222→                } elseif ($dueB === '') {\n1223→                    $valueA = strtotime($dueA);\n1224→                    $valueB = PHP_INT_MAX;\n1225→                } else {\n1226→                    $valueA = strtotime($dueA);\n1227→                    $valueB = strtotime($dueB);\n1228→                }\n1229→                break;\n1230→            case 'priority':\n1231→                $pA = normalizeTaskPriority($a['priority'] ?? '中');\n1232→                $pB = normalizeTaskPriority($b['priority'] ?? '中');\n1233→                $valueA = $priorityWeight[$pA] ?? 4;\n1234→                $valueB = $priorityWeight[$pB] ?? 4;\n1235→                break;\n1236→            case 'status':\n1237→                $sA = normalizeTaskStatus($a['status'] ?? '未开始');\n1238→                $sB = normalizeTaskStatus($b['status'] ?? '未开始');\n1239→                $valueA = $statusWeight[$sA] ?? 5;\n1240→                $valueB = $statusWeight[$sB] ?? 5;\n1241→                break;\n1242→            case 'title':\n1243→                $valueA = $a['title'] ?? '';\n1244→                $valueB = $b['title'] ?? '';\n1245→                $cmp = strcasecmp($valueA, $valueB);\n1246→                return $isAsc ? $cmp : -$cmp;\n1247→            default:\n1248→                return 0;\n1249→        }\n1250→\n1251→        if ($valueA === $valueB) {\n1252→            return 0;\n1253→        }\n1254→\n1255→        return $isAsc ? ($valueA > $valueB ? 1 : -1) : ($valueA > $valueB ? -1 : 1);\n1256→    });\n1257→\n1258→    return $tasks;\n1259→}\n1260→\n1261→function normalizeTagName(string $name): strin