  45→        LOG_FILE,\n  46→        json_encode($entry, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL,\n  47→        FILE_APPEND | LOCK_EX\n  48→    );\n  49→    persistDebugLogToDatabase($entry);\n  50→}\n  51→\n  52→function persistDebugLogToDatabase(array $entry): void\n  53→{\n  54→    if (!empty($GLOBALS['isPersistingDebugLog']) || !empty($GLOBALS['suppressDatabaseDebugLog']) || !extension_loaded('pdo_sqlite')) {\n  55→        return;\n  56→    }\n  57→\n  58→    $GLOBALS['isPersistingDebugLog'] = true;\n  59→\n  60→    try {\n  61→        $dataDirectory = dirname(DB_FILE);\n  62→        if (!is_dir($dataDirectory) && !mkdir($dataDirectory, 0775, true) && !is_dir($dataDirectory)) {\n  63→            return;\n  64→        }\n  65→\n  66→        $pdo = new PDO('sqlite:' . DB_FILE);\n  67→        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n  68→        $pdo->exec('PRAGMA busy_timeout = 5000');\n  69→        $pdo->exec(\"CREATE TABLE IF NOT EXISTS operation_logs (\n  70→            id INTEGER PRIMARY KEY AUTOINCREMENT,\n  71→            operation TEXT NOT NULL,\n  72→            parameters_json TEXT NOT NULL DEFAULT '{}',\n  73→            status TEXT NOT NULL,\n  74→            context_json TEXT NOT NULL DEFAULT '{}',\n  75→            created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n  76→        )\");\n  77→\n  78→        $parametersJson = json_encode($entry['parameters'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n  79→        $contextJson = json_encode($entry['context'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n  80→        $statement = $pdo->prepare(\n  81→            'INSERT INTO operation_logs (operation, parameters_json, status, context_json, created_at)\n  82→            VALUES (:operation, :parameters_json, :status, :context_json, :created_at)'\n  83→        );\n  84→        $statement->execute([\n  85→            ':operation' => (string) ($entry['operation'] ?? 'unknown'),\n  86→            ':parameters_json' => is_string($parametersJson) ? $parametersJson : '{}',\n  87→            ':status' => (string) ($entry['status'] ?? 'unknown'),\n  88→            ':context_json' => is_string($contextJson) ? $contextJson : '{}',\n  89→            ':created_at' => (string) ($entry['timestamp'] ?? date('Y-m-d H:i:s')),\n  90→        ]);\n  91→    } catch (Throwable $exception) {\n  92→        $GLOBALS['lastDebugLogDatabaseError'] = $exception->getMessage();\n  93→    } finally {\n  94→        $GLOBALS['isPersistingDebugLog'] = false;\n  95→    }\n  96→}\n  97→\n  98→function escapeHtml(string $value): string\n  99→{\n 100→    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n 101→}\n 102→\n 103→function normalizeTaskStatus(string $status, string $fallback = '未开始'): string\n 104→{\n 105→    $trimmedStatus = trim($status);\n 106→    if (isset(LEGACY_STATUS_MAP[$trimmedStatus])) {\n 107→        return LEGACY_STATUS_MAP[$trimmedStatus];\n 108→    }\n 109→\n 110→    if (in_array($trimmedStatus, ALLOWED_STATUSES, true)) {\n 111→        return $trimmedStatus;\n 112→    }\n 113→\n 114→    return in_array($fallback, ALLOWED_STATUSES, true) ? $fallback : '未开始';\n 115→}\n 116→\n 117→function isAllowedTaskStatus(string $status): bool\n 118→{\n 119→    return in_array(trim($status), ALLOWED_STATUSES, true);\n 120→}\n 121→\n 122→function normalizeTaskPriority(string $priority, string $fallback = DEFAULT_TASK_PRIORITY): string\n 123→{\n 124→    $trimmedPriority = trim($priority);\n 125→    if (in_array($trimmedPriority, ALLOWED_PRIORITIES, true)) {\n 126→        return $trimmedPriority;\n 127→    }\n 128→\n 129→    return in_array($fallback, ALLOWED_PRIORITIES, true) ? $fallback : DEFAULT_TASK_PRIORITY;\n 130→}\n 131→\n 132→function isAllowedTaskPriority(string $priority): bool\n 133→{\n 134→    return in_array(trim($priority), ALLOWED_PRIORITIES, true);\n 135→}\n 136→\n 137→function getPriorityBadgeClass(string $priority): string\n 138→{\n 139→    $normalizedPriority = normalizeTaskPriority($priority);\n 140→    if ($normalizedPriority === '高') {\n 141→        return 'priority-high';\n 142→    }\n 143→    if ($normalizedPriority === '低') {\n 144→        return 'priority-low';\n 145→    }\n 146→\n 147→    return 'priority-medium';\n 148→}\n 149→\n 150→function normalizeStoredDueAt($dueAt): string\n 151→{\n 152→    if (!is_string($dueAt)) {\n 153→        return '';\n 154→    }\n 155→\n 156→    $trimmedDueAt = trim($dueAt);\n 157→    if ($trimmedDueAt === '') {\n 158→        return '';\n 159→    }\n 160→\n 161→    $dateTime = DateTimeImmutable::createFromFormat('Y-m-d H:i:s', $trimmedDueAt);\n 162→    $dateErrors = DateTimeImmutable::getLastErrors();\n 163→    if ($dateTime instanceof DateTimeImmutable && $dateErrors === false) {\n 164→        return $dateTime->format('Y-m-d H:i:s');\n 165→    }\n 166→\n 167→    $timestamp = strtotime($trimmedDueAt);\n 168→    if ($timestamp === false) {\n 169→        return '';\n 170→    }\n 171→\n 172→    return date('Y-m-d H:i:s', $timestamp);\n 173→}\n 174→\n 175→function validateDueAtInput(string $dueAtInput): array\n 176→{\n 177→    $trimmedDueAt = trim($dueAtInput);\n 178→    if ($trimmedDueAt === '') {\n 179→        writeDebugLog('task_due_at_validation', [\n 180→            'submitted_due_at' => $dueAtInput,\n 181→        ], 'success', [\n 182→            'result' => 'empty_due_at_allowed',\n 183→            'normalized_due_at' => '',\n 184→        ]);\n 185→        return [\n 186→            'valid' => true,\n 187→            'normalized' => '',\n 188→            'error' => '',\n 189→            'reason' => 'empty_due_at_allowed',\n 190→        ];\n 191→    }\n 192→\n 193→    $dateTime = DateTimeImmutable::createFromFormat('Y-m-d\\TH:i', $trimmedDueAt);\n 194→    $dateErrors = DateTimeImmutable::getLastErrors();\n 195→    if (!$dateTime instanceof DateTimeImmutable || $dateErrors !== false) {\n 196→        writeDebugLog('task_due_at_validation', [\n 197→        