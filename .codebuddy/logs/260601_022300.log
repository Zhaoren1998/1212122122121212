STS tasks (\n 510→                id TEXT PRIMARY KEY,\n 511→                title TEXT NOT NULL,\n 512→                content TEXT NOT NULL DEFAULT '',\n 513→                status TEXT NOT NULL DEFAULT '待处理',\n 514→                priority TEXT NOT NULL DEFAULT '中',\n 515→                category_id TEXT NULL,\n 516→                due_at TEXT NULL,\n 517→                archived_at TEXT NULL,\n 518→                deleted_at TEXT NULL,\n 519→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 520→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 521→                FOREIGN KEY (category_id) REFERENCES categories(id) ON UPDATE CASCADE ON DELETE SET NULL\n 522→            )\",\n 523→            'tags' => \"CREATE TABLE IF NOT EXISTS tags (\n 524→                id TEXT PRIMARY KEY,\n 525→                name TEXT NOT NULL UNIQUE,\n 526→                color TEXT NOT NULL DEFAULT '#667085',\n 527→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 528→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 529→            )\",\n 530→            'task_tags' => \"CREATE TABLE IF NOT EXISTS task_tags (\n 531→                task_id TEXT NOT NULL,\n 532→                tag_id TEXT NOT NULL,\n 533→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 534→                PRIMARY KEY (task_id, tag_id),\n 535→                FOREIGN KEY (task_id) REFERENCES tasks(id) ON UPDATE CASCADE ON DELETE CASCADE,\n 536→                FOREIGN KEY (tag_id) REFERENCES tags(id) ON UPDATE CASCADE ON DELETE CASCADE\n 537→            )\",\n 538→            'subtasks' => \"CREATE TABLE IF NOT EXISTS subtasks (\n 539→                id TEXT PRIMARY KEY,\n 540→                task_id TEXT NOT NULL,\n 541→                title TEXT NOT NULL,\n 542→                is_completed INTEGER NOT NULL DEFAULT 0,\n 543→                sort_order INTEGER N