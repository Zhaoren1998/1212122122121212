tion formatDueAtForInput(string $dueAt): string\n 250→{\n 251→    $normalizedDueAt = normalizeStoredDueAt($dueAt);\n 252→    if ($normalizedDueAt === '') {\n 253→        return '';\n 254→    }\n 255→\n 256→    $timestamp = strtotime($normalizedDueAt);\n 257→    return $timestamp === false ? '' : date('Y-m-d\\TH:i', $timestamp);\n 258→}\n 259→\n 260→function buildDueAtState(array $task, string $source): array\n 261→{\n 262→    $taskId = isset($task['id']) && is_string($task['id']) ? $task['id'] : '';\n 263→    $dueAt = normalizeStoredDueAt($task['due_at'] ?? '');\n 264→    $nowTimestamp = time();\n 265→    $todayStart = strtotime(date('Y-m-d 00:00:00', $nowTimestamp));\n 266→    $todayEnd = strtotime(date('Y-m-d 23:59:59', $nowTimestamp));\n 267→\n 268→    if ($dueAt === '') {\n 269→        writeDebugLog('task_due_at_status_calculate', [\n 270→            'task_id' => $taskId,\n 271→            'due_at' => '',\n 272→            'source' => $source,\n 273→        ], 'success', [\n 274→            'result_status' => '未设置',\n 275→            'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 276→            'has_due_at' => false,\n 277→        ]);\n 278→        return [\n 279→            'label' => '未设置',\n 280→            'class' => 'due-none',\n 281→            'description' => '未设置截止时间',\n 282→            'datetime' => '',\n 283→        ];\n 284→    }\n 285→\n 286→    $dueTimestamp = strtotime($dueAt);\n 287→    if ($dueTimestamp === false) {\n 288→        writeDebugLog('task_due_at_status_calculate', [\n 289→            'task_id' => $taskId,\n 290→            'due_at' => $dueAt,\n 291→            'source' => $source,\n 292→        ], 'failed', [\n 293→            'reason' => 'stored_due_at_unparseable',\n 294→            'result_status' => '无效日期',\n 295→            'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 296→        ]);\n 297→        return [\n 298→            'label' => '无效日期',\n 299→            'class' => 'due-invalid',\n 300→            'description' => '截止时间格