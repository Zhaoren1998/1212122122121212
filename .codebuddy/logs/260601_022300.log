d ON tasks(category_id)',\n 610→            'idx_task_tags_tag_id' => 'CREATE INDEX IF NOT EXISTS idx_task_tags_tag_id ON task_tags(tag_id)',\n 611→            'idx_subtasks_task_id' => 'CREATE INDEX IF NOT EXISTS idx_subtasks_task_id ON subtasks(task_id)',\n 612→            'idx_comments_task_id' => 'CREATE INDEX IF NOT EXISTS idx_comments_task_id ON comments(task_id)',\n 613→            'idx_attachments_task_id' => 'CREATE INDEX IF NOT EXISTS idx_attachments_task_id ON attachments(task_id)',\n 614→            'idx_reminders_task_id' => 'CREATE INDEX IF NOT EXISTS idx_reminders_task_id ON reminders(task_id)',\n 615→            'idx_reminders_remind_at' => 'CREATE INDEX IF NOT EXISTS idx_reminders_remind_at ON reminders(remind_at)',\n 616→        ];\n 617→\n 618→        foreach ($indexes as $indexName => $sql) {\n 619→            $pdo->exec($sql);\n 620→            writeDebugLog('database_index_create', [\n 621→                'index' => $indexName,\n 622→                'database_file' => basename(DB_FILE),\n 623→            ], 'success');\n 624→        }\n 625→\n 626→        upsertSystemSetting($pdo, 'schema_version', '1');\n 627→        $pdo->commit();\n 628→        $GLOBALS['suppressDatabaseDebugLog'] = false;\n 629→\n 630→        writeDebugLog('database_schema_initialize', [\n 631→            'database_file' => basename(DB_FILE),\n 632→            'table_count' => count($statements),\n 633→            'index_count' => count($indexes),\n 634→        ], 'success');\n 635→    } catch (Throwable $exception) {\n 636→        if ($pdo->inTransaction()) {\n 637→            $pdo->rollBack();\n 638→        }\n 639→        $GLOBALS['suppressDatabaseDebugLog'] = false;\n 640→\n 641→        writeDebugLog('database_schema_initialize', [\n 642→            'database_file' => basename(DB_FILE),\n 643→        ], 'failed', [\n 644→            'reason' => 'schema_exception',\n 645→            'message' => $exception->getMessage(),\n 646→        ]);\n 647→        throw $exception;\