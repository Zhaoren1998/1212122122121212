 ];\n2975→        }\n2976→\n2977→        writeDebugLog('task_history_load', [\n2978→            'task_id' => $taskId,\n2979→            'limit' => $limit,\n2980→        ], 'success', [\n2981→            'history_count' => count($history),\n2982→        ]);\n2983→\n2984→        return $history;\n2985→    } catch (Throwable $exception) {\n2986→        writeDebugLog('task_history_load', [\n2987→            'task_id' => $taskId,\n2988→            'limit' => $limit,\n2989→        ], 'failed', [\n2990→            'reason' => 'database_query_exception',\n2991→            'message' => $exception->getMessage(),\n2992→        ]);\n2993→        return [];\n2994→    }\n2995→}\n2996→\n2997→function createTaskId(): string\n2998→{\n2999→    try {\n3000→        return 'task-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n3001→    } catch (Throwable $exception) {\n3002→        return 'task-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n3003→    }\n3004→}\n3005→\n3006→function saveNewTask(array $task): bool\n3007→{\n3008→    try {\n3009→        $pdo = getDatabaseConnection();\n3010→        $now = date('Y-m-d H:i:s');\n3011→        $createdAt = isset($task['created_at']) && is_string($task['created_at']) && trim($task['created_at']) !== ''\n3012→            ? trim($task['created_at'])\n3013→            : $now;\n3014→        $updatedAt = isset($task['updated_at']) && is_string($task['updated_at']) && trim($task['updated_at']) !== ''\n3015→            ? trim($task['updated_at'])\n3016→            : $createdAt;\n3017→        $archivedAt = (string) $task['status'] === '已归档' ? $updatedAt : null;\n3018→        $priority = normalizeTaskPriority((string) ($task['priority'] ?? DEFAULT_TASK_PRIORITY));\n3019→        $dueAt = normalizeStoredDueAt($task['due_at'] ?? '');\n3020→        $categoryId = isset($task['category_id']) && is_string($task['category_id']) && trim($task['category_id']) !== ''\n3021→            ? trim($task['category_id'])\n3022→            : null;\n3023→        $statement = $pdo->prepare(\n3024→            \"INSERT INTO tasks\n3025→            (id, title, content, status, priority, category_id, due_at, archived_at, deleted_at, created_at, updated_at)\n3026→            VALUES\n3027→            (:id, :title, :content, :status, :priority, :category_id, :due_at, :archived_at, NULL, :created_at, :updated_at)\"\n3028→        );\n3029→\n3030→        $statement->execute([\n3031→            ':id' => (string) $task['id'],\n3032→            ':title' => (string) $task['title'],\n3033→            ':content' => (string) $task['content'],\n3034→            ':status' => (string) $task['status'],\n3035→            ':priority' => $priority,\n3036→            ':category_id' => $categoryId,\n3037→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_h6z3yodrthn7_1","__timestamp":"2026-05-31T18:40:44.049Z","_requestId":"bed89a94c25f4dbabe09eca48fcae341"}

