wed_enum_on_read',\n2408→                        'normalized_status' => normalizeTaskStatus($rawStatus),\n2409→                        'allowed_statuses' => ALLOWED_STATUSES,\n2410→                    ]);\n2411→                }\n2412→                $rawPriority = isset($row['priority']) && is_string($row['priority']) ? trim($row['priority']) : '';\n2413→                if (!isAllowedTaskPriority($rawPriority)) {\n2414→                    writeDebugLog('task_priority_read_exception', [\n2415→                        'task_id' => isset($row['id']) && is_string($row['id']) ? $row['id'] : '',\n2416→                        'raw_priority' => $rawPriority,\n2417→                    ], 'failed', [\n2418→                        'reason' => 'priority_outside_allowed_enum_on_read',\n2419→                        'normalized_priority' => normalizeTaskPriority($rawPriority),\n2420→                        'allowed_priorities' => ALLOWED_PRIORITIES,\n2421→                    ]);\n2422→                }\n2423→                $task = normalizeTask($row, (int) $index);\n2424→                $taskId = $task['id'];\n2425→                $task['tag_ids'] = loadTagIdsForTask($pdo, $taskId);\n2426→                $task['tags'] = loadTagsForTask($pdo, $taskId);\n2427→                $tasks[] = $task;\n2428→            }\n2429→        }\n2430→\n2431→        if (count($tasks) === 0) {\n2432→            writeDebugLog('task_list_empty_data', ['database_file' => basename(DB_FILE)], 'success', [\n2433→                'reason' => 'no_database_rows',\n2434→                'task_count' => 0,\n2435→            ]);\n2436→        }\n2437→\n2438→        writeDebugLog('task_list_load', ['database_file' => basename(DB_FILE)], 'success', [\n2439→            'task_count' => count($tasks),\n2440→            'sort' => 'priority_then_created_at_desc',\n2441→        ]);\n2442→\n2443→        return $tasks;\n2444→    } catch (Throwable $exception) {\n2445→        setDatabaseErrorMessage('数据库读取失败，系统已保留页面可用性，请稍后重试或查看日志。');\n2446→        writeDebugLog('task_list_read_exception', ['database_file' => basename(DB_FILE)], 'failed', [\n2447→            'reason' => 'database_query_exception',\n2448→            'message' => $exception->getMessage(),\n2449→        ]);\n2450→        return [];\n2451→    }\n2452→}\n2453→\n2454→function validateTaskInput(string $title, string $content, string $status, string $priority, string $dueAtInput, string $categoryId, array $categories, string $formAction, string $taskId = ''): array\n2455→{\n2456→    $errors = [];\n2457→    $trimmedTitle = trim($title);\n2458→    $trimmedContent = trim($content);\n2459→\n2460→    if ($trimmedTitle === '') {\n2461→        $errors['title'] = '任务标题不能为空。';\n2462→    } elseif (stringLength($trimmedTitle) > MAX_TITLE_LENGTH) {\n2463→        $errors['title'] = '任务标题不能超过 ' . MAX_TITLE_LENGTH . ' 个字符。';\n2464→    }\n2465→\n2466→    if (stringLength($trimmedContent) > MAX_CONTENT_LENGTH) {\n2467→        $errors['content'] = '任务内容不能超过 ' . MAX_CONTENT_LENGTH . ' 个字符。';\n2468→    }\n2469→\n2470→    if (!isAllowedTaskStatus($status)) {\n2471→        $errors['status'] = '请选择有效的任务状态。';\n2472→    }\n2473→\n2474→    if (!isAllowedTaskPriority($priority)) {\n2475→        $errors['priority'] = '请选择有效的任务优先级。';\n2476→    }\n2477→\n2478→    $dueAtValidation = validateDueAtInput($dueAtInput);\n2479→    if (!$dueAtValidation['valid']) {\n2480→        $errors['due_at'] = $dueAtValidation['error'];\n2481→    }\n2482→\n2483→    $categoryValidation = validateTaskCategoryId($categoryId, $categories, $formAction, $taskId);\n2484→    if (!$categoryValidation['valid']) {\n2485→        $errors['category_id'] = $categoryValidation['error'];\n2486→    }\n2487→\n2488→    return $errors;\n2489→}\n2490→\n2491→function buildStatusCounts(array $tasks): array\n2492→{\n2493→    $counts = [];\n2494→    foreach (ALLOWED_STATUSES as $status) {\n2495→        $counts[$status] = 0;\n2496→    }\n2497→\n2498→    foreach ($tasks as $task) {\n2499→        $status = isset($task['status']) && is_string($task['status']) ? normalizeTaskStatus($task['status']) : '未开始';\n2500→        if (!isset($counts[$status])) {\n2501→            $counts[$status] = 0;\n2502→        }\n2503→        $counts[$status]++;\n2504→    }\n2505→\n2506→    return $counts;\n2507→}\n2508→\n2509→function findTaskById(array $tasks, string $taskId): ?array\n2510→{\n2511→    foreach ($tasks as $task) {\n2512→        if (($task['id'] ?? '') === $taskId) {\n2513→            return $task;\n2514→        }\n2515→    }\n2516→\n2517→    return null;\n2518→}\n2519→\n2520→function createTaskId(): string\n2521→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_n43k64n46j00_1","__timestamp":"2026-05-31T18:30:17.636Z","_requestId":"13d439c4b1af40b0b3ba4355439be60c"}

