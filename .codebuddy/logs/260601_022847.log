   'errors' => $errors,\n1243→        'raw_page' => $rawPage,\n1244→        'raw_page_size' => $rawPageSize,\n1245→    ];\n1246→}\n1247→\n1248→function calculatePagination(int $totalCount, int $page, int $pageSize): array\n1249→{\n1250→    $totalPages = $pageSize > 0 ? (int) ceil($totalCount / $pageSize) : 1;\n1251→    if ($totalPages < 1) {\n1252→        $totalPages = 1;\n1253→    }\n1254→    if ($page > $totalPages) {\n1255→        $page = $totalPages;\n1256→    }\n1257→    $offset = ($page - 1) * $pageSize;\n1258→    $hasNextPage = $page < $totalPages;\n1259→    $hasPrevPage = $page > 1;\n1260→\n1261→    return [\n1262→        'total_count' => $totalCount,\n1263→        'total_pages' => $totalPages,\n1264→        'current_page' => $page,\n1265→        'page_size' => $pageSize,\n1266→        'offset' => $offset,\n1267→        'has_next_page' => $hasNextPage,\n1268→        'has_prev_page' => $hasPrevPage,\n1269→        'is_first_page' => $page === 1,\n1270→        'is_last_page' => $page === $totalPages,\n1271→    ];\n1272→}\n1273→\n1274→function sortTasks(array $tasks, string $sortBy, string $sortOrder): array\n1275→{\n1276→    if (empty($tasks) || $sortBy === '') {\n1277→        return $tasks;\n1278→    }\n1279→\n1280→    $isAsc = $sortOrder === 'asc';\n1281→\n1282→    $priorityWeight = ['高' => 1, '中' => 2, '低' => 3];\n1283→    $statusWeight = ['未开始' => 1, '进行中' => 2, '已完成' => 3, '已归档' => 4];\n1284→\n1285→    usort($tasks, function ($a, $b) use ($sortBy, $isAsc, $priorityWeight, $statusWeight) {\n1286→        $valueA = null;\n1287→        $valueB = null;\n1288→\n1289→        switch ($sortBy) {\n1290→            case 'created_at':\n1291→                $valueA = strtotime($a['created_at'] ?? '1970-01-01 00:00:00');\n1292→                $valueB = strtotime($b['created_at'] ?? '1970-01-01 00:00:00');\n1293→                break;\n1294→            case 'updated_at':\n1295→                $valueA = strtotime($a['updated_at'] ?? '1970-01-01 00:00:00');\n1296→                $valueB = strtotime($b['updated_at'] ?? '1970-01-01 00:00:00');\n1297→                break;\n1298→            case 'due_at':\n1299→                $dueA = normalizeStoredDueAt($a['due_at'] ?? '');\n1300→                $dueB = normalizeStoredDueAt($b['due_at'] ?? '');\n1301→                if ($dueA === '' && $dueB === '') {\n1302→                    $valueA = PHP_INT_MAX;\n1303→                    $valueB = PHP_INT_MAX;\n1304→                } elseif ($dueA === '') {\n1305→                    $valueA = PHP_INT_MAX;\n1306→                    $valueB = strtotime($dueB);\n1307→                } elseif ($dueB === '') {\n1308→                    $valueA = strtotime($dueA);\n1309→                    $valueB = PHP_INT_MAX;\n1310→                } else {\n1311→                    $valueA = strtotime($dueA);\n1312→                    $valueB = strtotime($dueB);\n1313→                }\n1314→                break;\n1315→            case 'priority':\n1316→                $pA = normalizeTaskPriority($a['priority'] ?? '中');\n1317→                $pB = normalizeTaskPriority($b['priority'] ?? '中');\n1318→                $valueA = $priorityWeight[$pA] ?? 4;\n1319→                $valueB = $priorityWeight[$pB] ?? 4;\n1320→                break;\n1321→            case 'status':\n1322→                $sA = normalizeTaskStatus($a['status'] ?? '未开始');\n1323→                $sB = normalizeTaskStatus($b['status'] ?? '未开始');\n1324→                $valueA = $statusWeight[$sA] ?? 5;\n1325→                $valueB = $statusWeight[$sB] ?? 5;\n1326→                break;\n1327→            case 'title':\n1328→                $valueA = $a['title'] ?? '';\n1329→                $valueB = $b['title'] ?? '';\n1330→                $cmp = strcasecmp($valueA, $valueB);\n1331→                return $isAsc ? $cmp : -$cmp;\n1332→            default:\n1333→                return 0;\n1334→        }\n1335→\n1336→        if ($valueA === $valueB) {\n1337→            return 0;\n1338→        }\n1339→\n1340→        return $isAsc ? ($valueA > $valueB ? 1 : -1) : ($valueA > $valueB ? -1 : 1);\n1341→    });\n1342→\n1343→    return $tasks;\n1344→}\n1345→\n1346→function normalizeTagName(string $name): string\n1347→{\n1348→    $normalized = preg_replace('/\\s+/u', ' ', trim($name));\n1349→    return is_string($normalized) ? $normalized : trim($name);\n1350→}\n1351→\n1352→function createTagId(): string\n1353→{\n1354→    try {\n1355→        return 'tag-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n1356→    } catch (Throwable $exception) {\n1357→        return 'tag-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n1358→    }\n1359→}\n1360→\n1361→function loadTags(): array\n1362→{\n1363→    writeDebugLog('tag_list_load', [\n1364→        'database_file' => basename(DB_FILE),\n1365→    ], 'started');\n1366→\n1367→    try {\n1368→        $pdo = getDatabaseConnection();\n1369→        $statement = $pdo->query(\n1370→            \"SELECT t.id,\n1371→                    t.name,\n1372→                    t.color,\n1373→                    t.created_at,\n1374→                    t.updated_at,\n1375→                    COUNT(DISTINCT tt.task_id) AS task_count\n1376→            FROM tags t\n1377→            LEFT JOIN task_tags tt ON tt.tag_id = t.id\n1378→            LEFT JOIN tasks ta ON ta.id = tt.task_id AND ta.deleted_at IS NULL\n1379→            GROUP BY t.id, t.name, t.color, t.created_at, t.updated_at\n1380→            ORDER BY t.name COLLATE NOCASE ASC\"\n1381→        );\n1382→        $rows = $statement !== false ? $statement->fetchAll() : [];\n1383→        $tags = [];\n1384→\n1385→        foreach ($rows as $row) {\n1386→            if (!is_array($row)) {\n1387→                continue;\n1388→            }\n1389→\n1390→            $tags[] = [\n1391→                'id' => isset($row['id']) && is_string($row['id']) ? trim($row['id']) : '',\n1392→                'name' => isset($row['name']) && is_string($row['name']) ? trim($row['name']) : '',\n1393→                'color' => isset($row['color']) && is_string($row['color']) && trim($row['color']) !== '' ? trim($row['color']) : '#667085',\n1394→                'created_at' => isset($row['created_at']) && is_string($row['created_at']) ? trim($row['created_at']) : '',\n1395→                'updated_at' => isset($row['updated_at']) && is_string($row['updated_at']) ? trim($row['updated_at']) : '',\n1396→                'task_count' => isset($row['task_count']) ? (int) $row['task_count'] : 0,\n1397→            ];\n1398→        }\n1399→\n1400→        writeDebugLog('tag_list_load', [\n1401→            'database_file' => basename(DB_FILE),\n1402→        ], 'success', [\n1403→            'tag_count' => count($tags),\n1404→        ]);\n1405→\n1406→        return $tags;\n1407→    } catch (Throwable $exception) {\n1408→        writeDebugLog('tag_list_load_exception', [\n1409→            'database_file' => basename(DB_FILE),\n1410→        ], 'failed', [\n1411→            'reason' => 'database_query_exception',\n1412→            'message' => $exception->getMessage(),\n1413→        ]);\n1414→        return [];\n1415→    }\n1416→}\n1417→\n1418→function findTagById(array $tags, string $tagId): ?array\n1419→{\n1420→    foreach ($tags as $tag) {\n1421→        if (($tag['id'] ?? '') === $tagId) {\n1422→            return $tag;\n1423→        }\n1424→    }\n1425→\n1426→    return null;\n1427→}\n1428→\n1429→function tagNameExists(PDO $pdo, string $name, string $excludeTagId = ''): bool\n1430→{\n1431→    $statement = $pdo->prepare(\n1432→        \"SELECT id FROM tags\n1433→        WHERE lower(name) = lower(:name)\n1434→            AND (:exclude_id = '' OR id <> :exclude_id)\n1435→        LIMIT 1\"\n1436→    );\n1437→    $statement->execute([\n1438→        ':name' => $name,\n1439→        ':exclude_id' => $excludeTagId,\n1440→    ]);\n1441→    $existingId = $statement->fetchColumn();\n1442→    $statement->closeCursor();\n1443→\n1444→    return is_string($existingId) && $existingId !== '';\n1445→}\n1446→\n1447→function validateTagInput(string $name, string $excludeTagId = ''): array\n1448→{\n1449→    $errors = [];\n1450→    $normalizedName = normalizeTagName($name);\n1451→\n1452→    if ($normalizedName === '') {\n1453→        $errors['tag_name'] = '标签名称不能为空。';\n1454→    } elseif (stringLength($normalizedName) > MAX_TAG_NAME_LENGTH) {\n1455→        $errors['tag_name'] = '标签名称不能超过 ' . MAX_TAG_NAME_LENGTH . ' 个字符。';\n1456→    } else {\n1457→        try {\n1458→            $pdo = getDatabaseConnection();\n1459→            if (tagNameExists($pdo, $normalizedName, $excludeTagId)) {\n1460→                $errors['tag_name'] = '标签名称已存在，请使用不同名称。';\n1461→            }\n1462→        } catch (Throwable $exception) {\n1463→            $errors['tag_name'] = '标签校验失败，请稍后重试。';\n1464→            writeDebugLog('tag_validation_exception', [\n1465→                'tag_id' => $excludeTagId,\n1466→                'name_length' => stringLength($normalizedName),\n1467→            ], 'failed', [\n1468→                'reason' => 'database_query_exception',\n1469→                'message' => $exception->getMessage(),\n1470→            ]);\n1471→        }\n1472→    }\n1473→\n1474→    return [\n1475→        'valid' => $errors === [],\n1476→        'name' => $normalizedName,\n1477→        'errors' => $errors,\n1478→    ];\n1479→}\n1480→\n1481→function saveNewTag(string $name, string $color = '#2563eb'): string\n1482→{\n1483→    $tagId = createTagId();\n1484→    writeDebugLog('tag_create', [\n1485→        'tag_id' => $tagId,\n1486→        'name_length' => stringLength($name),\n1487→        'color' => $color,\n1488→    ], 'started');\n1489→\n1490→    try {\n1491→        $pdo = getDatabaseConnection();\n1492→        $now = date('Y-m-d H:i:s');\n1493→\n1494→        $statement = $pdo->prepare(\n1495→            \"INSERT INTO tags (id, name, color, created_at, updated_at)\n1496→            VALUES (:id, :name, :color, :created_at, :updated_at)\"\n1497→        );\n1498→        $statement->execute([\n1499→            ':id' => $tagId,\n1500→            ':name' => $name,\n1501→            ':color' => $color,\n1502→            ':created_at' => $now,\n1503→            ':updated_at' => $now,\n1504→        ]);\n1505→        $statement->closeCursor();\n1506→\n1507→        writeDebugLog('tag_create', [\n1508→            'tag_id' => $tagId,\n1509→            'name_length' => stringLength($name),\n1510→            'color' => $color,\n1511→        ], 'success', [\n1512→            'database_file' => basename(DB_FILE),\n1513→            'created_at' => $now,\n1514→        ]);\n1515→\n1516→        return 'success';\n1517→    } catch (Throwable $exception) {\n1518→        writeDebugLog('tag_create', [\n1519→            'tag_id' => $tagId,\n1520→            'name_length' => stringLength($name),\n1521→            'color' => $color,\n1522→        ], 'failed', [\n1523→            'reason' => 'database_write_exception',\n1524→            'message' => $exception->getMessage(),\n1525→            'database_file' => basename(DB_FILE),\n1526→        ]);\n1527→        return 'exception';\n1528→    }\n1529→}\n1530→\n1531→function saveUpdatedTag(string $tagId, string $name, string $color): string\n1532→{\n1533→    writeDebugLog('tag_update', [\n1534→        'tag_id' => $tagId,\n1535→        'name_length' => stringLength($name),\n1536→        'color' => $color,\n1537→    ], 'started');\n1538→\n1539→    try {\n1540→        $pdo = getDatabaseConnection();\n1541→        $existingStatement = $pdo->prepare('SELECT id, name, color FROM tags WHERE id = :id LIMIT 1');\n1542→        $existingStatement->execute([':id' => $tagId]);\n1543→        $existingTag = $existingStatement->fetch();\n1544→        $existingStatement->closeCursor();\n1545→\n1546→        if (!is_array($existingTag)) {\n1547→            writeDebugLog('tag_update', [\n1548→                'tag_id' => $tagId,\n1549→                'name_length' => stringLength($name),\n1550→                'color' => $color,\n1551→            ], 'failed', [\n1552→                'reason' => $tagId === '' ? 'empty_tag_id' : 'missing_tag',\n1553→            ]);\n1554→            return 'not_found';\n1555→        }\n1556→\n1557→        $updatedAt = date('Y-m-d H:i:s');\n1558→        $statement = $pdo->prepare(\n1559→            \"UPDATE tags\n1560→            SET name = :name,\n1561→                color = :color,\n1562→                updated_at = :updated_at\n1563→            WHERE id = :id\"\n1564→        );\n1565→        $statement->execute([\n1566→            ':name' => $name,\n1567→            ':color' => $color,\n1568→            ':updated_at' => $updatedAt,\n1569→            ':id' => $tagId,\n1570→        ]);\n1571→        $statement->closeCursor();\n1572→\n1573→        writeDebugLog('tag_update', [\n1574→            'tag_id' => $tagId,\n1575→            'name_length' => stringLength($name),\n1576→            'color' => $color,\n1577→        ], 'success', [\n1578→            'previous_name' => (string) $existingTag['name'],\n1579→            'previous_color' => (string) $existingTag['color'],\n1580→            'new_name' => $name,\n1581→            'new_color' => $color,\n1582→            'changed' => (string) $existingTag['name'] !== $name || (string) $existingTag['color'] !== $color,\n1583→            'updated_at' => $updatedAt,\n1584→            'database_file' => basename(DB_FILE),\n1585→        ]);\n1586→\n1587→        return 'success';\n1588→    } catch (Throwable $exception) {\n1589→        writeDebugLog('tag_update', [\n1590→            'tag_id' => $tagId,\n1591→            'name_length' => stringLength($name),\n1592→            'color' => $color,\n1593→        ], 'failed', [\n1594→            'reason' => 'database_write_exception',\n1595→            'message' => $exception->getMessage(),\n1596→            'database_file' => basename(DB_FILE),\n1597→        ]);\n1598→        return 'exception';\n1599→    }\n1600→}\n1601→\n1602→function deleteTagById(string $tagId): string\n1603→{\n1604→    writeDebugLog('tag_delete', [\n1605→        'tag_id' => $tagId,\n1606→    ], 'started');\n1607→\n1608→    try {\n1609→        $pdo = getDatabaseConnection();\n1610→        $existingStatement = $pdo->prepare('SELECT id, name FROM tags WHERE id = :id LIMIT 1');\n1611→        $existingStatement->execute([':id' => $tagId]);\n1612→        $existingTag = $existingStatement->fetch();\n1613→        $existingStatement->closeCursor();\n1614→\n1615→        if (!is_array($existingTag)) {\n1616→            writeDebugLog('tag_delete', [\n1617→                'tag_id' => $tagId,\n1618→            ], 'failed', [\n1619→                'reason' => $tagId === '' ? 'empty_tag_id' : 'missing_tag',\n1620→            ]);\n1621→            return 'not_found';\n1622→        }\n1623→\n1624→        $deleteStatement = $pdo->prepare('DELETE FROM tags WHERE id = :id');\n1625→        $deleteStatement->execute([':id' => $tagId]);\n1626→        $changedRows = $deleteStatement->rowCount();\n1627→        $deleteStatement->closeCursor();\n1628→\n1629→        writeDebugLog('tag_delete', [\n1630→            'tag_id' => $tagId,\n1631→            'tag_name' => (string) $existingTag['name'],\n1632→        ], 'success', [\n1633→            'changed_rows' => $changedRows,\n1634→            'database_file' => basename(DB_FILE),\n1635→        ]);\n1636→\n1637→        return 'success';\n1638→    } catch (Throwable $exception) {\n1639→        writeDebugLog('tag_delete', [\n1640→            'tag_id' => $tagId,\n1641→        ], 'failed', [\n1642→            'reason' => 'database_write_exception',\n1643→            'message' => $exception->getMessage(),\n1644→            'database_file' => basename(DB_FILE),\n1645→        ]);\n1646→        return 'exception';\n1647→    }\n1648→}\n1649→\n1650→function loadTagIdsForTask(PDO $pdo, string $taskId): array\n1651→{\n1652→    $statement = $pdo->prepare('SELECT tag_id FROM task_tags WHERE task_id = :task_id');\n1653→    $statement->execute([':task_id' => $taskId]);\n1654→    $rows = $statement->fetchAll();\n1655→    $statement->closeCursor();\n1656→\n1657→    $tagIds = [];\n1658→    foreach ($rows as $row) {\n1659→        if (is_array($row) && isset($row['tag_id']) && is_string($row['tag_id'])) {\n1660→            $tagIds[] = $row['tag_id'];\n1661→        }\n1662→    }\n1663→\n1664→    return $tagIds;\n1665→}\n1666→\n1667→function loadTagsForTask(PDO $pdo, string $taskId): array\n1668→{\n1669→    $statement = $pdo->prepare(\n1670→        \"SELECT t.id, t.name, t.color\n1671→        FROM tags t\n1672→        INNER JOIN task_tags tt ON tt.tag_id = t.id\n1673→        WHERE tt.task_id = :task_id\n1674→        ORDER BY t.name COLLATE NOCASE ASC\"\n1675→    );\n1676→    $statement->execute([':task_id' => $taskId]);\n1677→    $rows = $statement->fetchAll();\n1678→    $statement->closeCursor();\n1679→\n1680→    $tags = [];\n1681→    foreach ($rows as $row) {\n1682→        if (is_array($row)) {\n1683→            $tags[] = [\n1684→                'id' => isset($row['id']) && is_string($row['id']) ? trim($row['id']) : '',\n1685→                'name' => isset($row['name']) && is_string($row['name']) ? trim($row['name']) : '',\n1686→                'color' => isset($row['color']) && is_string($row['color']) ? trim($row['color']) : '#667085',\n1687→            ];\n1688→        }\n1689→    }\n1690→\n1691→    return $tags;\n1692→}\n1693→\n1694→function assignTagsToTask(string $taskId, array $tagIds): bool\n1695→{\n1696→    writeDebugLog('tag_assign', [\n1697→        'task_id' => $taskId,\n1698→        'tag_ids' => $tagIds,\n1699→    ], 'started');\n1700→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_58s3j627iwp3_2","__timestamp":"2026-05-31T18:29:18.137Z","_requestId":"13d439c4b1af40b0b3ba4355439be60c"}

