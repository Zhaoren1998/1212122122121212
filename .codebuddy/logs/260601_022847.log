$windowSize = 2;\n5528→                                $startPage = max(1, $currentPage - $windowSize);\n5529→                                $endPage = min($totalPages, $currentPage + $windowSize);\n5530→\n5531→                                if ($startPage > 1): ?>\n5532→                                    <a class=\"pagination-button\" href=\"<?php echo escapeHtml(buildPaginationUrl($baseParams, 1)); ?>\">1</a>\n5533→                                    <?php if ($startPage > 2): ?>\n5534→                                        <span style=\"color:var(--text-muted);padding:0 4px;\">...</span>\n5535→                                    <?php endif; ?>\n5536→                                <?php endif; ?>\n5537→\n5538→                                <?php for ($i = $startPage; $i <= $endPage; $i++): ?>\n5539→                                    <a class=\"pagination-button<?php echo $i === $currentPage ? ' current' : ''; ?>\" href=\"<?php echo escapeHtml(buildPaginationUrl($baseParams, $i)); ?>\"<?php echo $i === $currentPage ? ' aria-current=\"page\"' : ''; ?>><?php echo $i; ?></a>\n5540→                                <?php endfor; ?>\n5541→\n5542→                                <?php if ($endPage < $totalPages): ?>\n5543→                                    <?php if ($endPage < $totalPages - 1): ?>\n5544→                                        <span style=\"color:var(--text-muted);padding:0 4px;\">...</span>\n5545→                                    <?php endif; ?>\n5546→                                    <a class=\"pagination-button\" href=\"<?php echo escapeHtml(buildPaginationUrl($baseParams, $totalPages)); ?>\"><?php echo $totalPages; ?></a>\n5547→                                <?php endif; ?>\n5548→\n5549→                                <a class=\"pagination-button\" href=\"<?php echo escapeHtml($nextUrl); ?>\"<?php echo !$paginationInfo['has_next_page'] ? ' aria-disabled=\"true\" style=\"opacity:0.5;pointer-events:none;\"' : ''; ?>>下一页</a>\n5550→"}],"is_erro