{"type":"user","uuid":"80b98f08-5ee5-4243-820a-6e207be1d281","session_id":"27f3764f-c0df-4208-97c8-9d1a11200fc7","message":{"content":[{"type":"tool_result","tool_use_id":"call_function_nay1sxrx974n_1","content":[{"type":"text","text":"   1→<?php\n   2→declare(strict_types=1);\n   3→\n   4→const DATA_FILE = __DIR__ . '/data/tasks.json';\n   5→const DB_FILE = __DIR__ . '/data/tasks.sqlite';\n   6→const LOG_FILE = __DIR__ . '/logs/app.log';\n   7→const MAX_TITLE_LENGTH = 80;\n   8→const MAX_CONTENT_LENGTH = 1000;\n   9→const MAX_SEARCH_KEYWORD_LENGTH = 120;\n  10→const MAX_CATEGORY_NAME_LENGTH = 40;\n  11→const MIN_DUE_AT = '2000-01-01 00:00:00';\n  12→const MAX_DUE_AT = '2100-12-31 23:59:00';\n  13→const ALLOWED_STATUSES = ['未开始', '进行中', '已完成', '已归档'];\n  14→const ALLOWED_PRIORITIES = ['高', '中', '低'];\n  15→const DEFAULT_TASK_PRIORITY = '中';\n  16→const LEGACY_STATUS_MAP = [\n  17→    '待处理' => '未开始',\n  18→];\n  19→\n  20→date_default_timezone_set('Asia/Shanghai');\n  21→\n  22→function writeDebugLog(string $operation, array $parameters, string $status, array $context = []): void\n  23→{\n  24→    $logDirectory = dirname(LOG_FILE);\n  25→    if (!is_dir($logDirectory)) {\n  26→        mkdir($logDirectory, 0775, true);\n  27→    }\n  28→\n  29→    $entry = [\n  30→        'timestamp' => date('Y-m-d H:i:s'),\n  31→        'operation' => $operation,\n  32→        'parameters' => $parameters,\n  33→        'status' => $status,\n  34→        'context' => $context,\n  35→    ];\n  36→\n  37→    file_put_contents(\n  38→        LOG_FILE,\n  39→        json_encode($entry, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL,\n  40→        FILE_APPEND | LOCK_EX\n  41→    );\n  42→    persistDebugLogToDatabase($entry);\n  43→}\n  44→\n  45→function persistDebugLogToDatabase(array $entry): void\n  46→{\n  47→    if (!empty($GLOBALS['isPersistingDebugLog']) || !empty($GLOBALS['suppressDatabaseDebugLog']) || !extension_loaded('pdo_sqlite')) {\n  48→        return;\n  49→    }\n  50→\n  51→    $GLOBALS['isPersistingDebugLog'] = true;\n  52→\n  53→    try {\n  54→        $dataDirectory = dirname(DB_FILE);\n  55→        if (!is_dir($dataDirectory) && !mkdir($dataDirectory, 0775, true) && !is_dir($dataDirectory)) {\n  56→            return;\n  57→        }\n  58→\n  59→        $pdo = new PDO('sqlite:' . DB_FILE);\n  60→        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n  61→        $pdo->exec('PRAGMA busy_timeout = 5000');\n  62→        $pdo->exec(\"CREATE TABLE IF NOT EXISTS operation_logs (\n  63→            id INTEGER PRIMARY KEY AUTOINCREMENT,\n  64→            operation TEXT NOT NULL,\n  65→            parameters_json TEXT NOT NULL DEFAULT '{}',\n  66→            status TEXT NOT NULL,\n  67→            context_json TEXT NOT NULL DEFAULT '{}',\n  68→            created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n  69→        )\");\n  70→\n  71→        $parametersJson = json_encode($entry['parameters'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n  72→        $contextJson = json_encode($entry['context'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n  73→        $statement = $pdo->prepare(\n  74→            'INSERT INTO operation_logs (operation, parameters_json, status, context_json, created_at)\n  75→            VALUES (:operation, :parameters_json, :status, :context_json, :created_at)'\n  76→        );\n  77→        $statement->execute([\n  78→            ':operation' => (string) ($entry['operation'] ?? 'unknown'),\n  79→            ':parameters_json' => is_string($parametersJson) ? $parametersJson : '{}',\n  80→            ':status' => (string) ($entry['status'] ?? 'unknown'),\n  81→            ':context_json' => is_string($contextJson) ? $contextJson : '{}',\n  82→            ':created_at' => (string) ($entry['timestamp'] ?? date('Y-m-d H:i:s')),\n  83→        ]);\n  84→    } catch (Throwable $exception) {\n  85→        $GLOBALS['lastDebugLogDatabaseError'] = $exception->getMessage();\n  86→    } finally {\n  87→        $GLOBALS['isPersistingDebugLog'] = false;\n  88→    }\n  89→}\n  90→\n  91→function escapeHtml(string $value): string\n  92→{\n  93→    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');\n  94→}\n  95→\n  96→function normalizeTaskStatus(string $status, string $fallback = '未开始'): string\n  97→{\n  98→    $trimmedStatus = trim($status);\n  99→    if (isset(LEGACY_STATUS_MAP[$trimmedStatus])) {\n 100→        return LEGACY_STATUS_MAP[$trimmedStatus];\n 101→    }\n 102→\n 103→    if (in_array($trimmedStatus, ALLOWED_STATUSES, true)) {\n 104→        return $trimmedStatus;\n 105→    }\n 106→\n 107→    return in_array($fallback, ALLOWED_STATUSES, true) ? $fallback : '未开始';\n 108→}\n 109→\n 110→function isAllowedTaskStatus(string $status): bool\n 111→{\n 112→    return in_array(trim($status), ALLOWED_STATUSES, true);\n 113→}\n 114→\n 115→function normalizeTaskPriority(string $priority, string $fallback = DEFAULT_TASK_PRIORITY): string\n 116→{\n 117→    $trimmedPriority = trim($priority);\n 118→    if (in_array($trimmedPriority, ALLOWED_PRIORITIES, true)) {\n 119→        return $trimmedPriority;\n 120→    }\n 121→\n 122→    return in_array($fallback, ALLOWED_PRIORITIES, true) ? $fallback : DEFAULT_TASK_PRIORITY;\n 123→}\n 124→\n 125→function isAllowedTaskPriority(string $priority): bool\n 126→{\n 127→    return in_array(trim($priority), ALLOWED_PRIORITIES, true);\n 128→}\n 129→\n 130→function getPriorityBadgeClass(string $priority): string\n 131→{\n 132→    $normalizedPriority = normalizeTaskPriority($priority);\n 133→    if ($normalizedPriority === '高') {\n 134→        return 'priority-high';\n 135→    }\n 136→    if ($normalizedPriority === '低') {\n 137→        return 'priority-low';\n 138→    }\n 139→\n 140→    return 'priority-medium';\n 141→}\n 142→\n 143→function normalizeStoredDueAt($dueAt): string\n 144→{\n 145→    if (!is_string($dueAt)) {\n 146→        return '';\n 147→    }\n 148→\n 149→    $trimmedDueAt = trim($dueAt);\n 150→    if ($trimmedDueAt === '') {\n 151→        return '';\n 152→    }\n 153→\n 154→    $dateTime = DateTimeImmutable::createFromFormat('Y-m-d H:i:s', $trimmedDueAt);\n 155→    $dateErrors = DateTimeImmutable::getLastErrors();\n 156→    if ($dateTime instanceof DateTimeImmutable && $dateErrors === false) {\n 157→        return $dateTime->format('Y-m-d H:i:s');\n 158→    }\n 159→\n 160→    $timestamp = strtotime($trimmedDueAt);\n 161→    if ($timestamp === false) {\n 162→        return '';\n 163→    }\n 164→\n 165→    return date('Y-m-d H:i:s', $timestamp);\n 166→}\n 167→\n 168→function validateDueAtInput(string $dueAtInput): array\n 169→{\n 170→    $trimmedDueAt = trim($dueAtInput);\n 171→    if ($trimmedDueAt === '') {\n 172→        writeDebugLog('task_due_at_validation', [\n 173→            'submitted_due_at' => $dueAtInput,\n 174→        ], 'success', [\n 175→            'result' => 'empty_due_at_allowed',\n 176→            'normalized_due_at' => '',\n 177→        ]);\n 178→        return [\n 179→            'valid' => true,\n 180→            'normalized' => '',\n 181→            'error' => '',\n 182→            'reason' => 'empty_due_at_allowed',\n 183→        ];\n 184→    }\n 185→\n 186→    $dateTime = DateTimeImmutable::createFromFormat('Y-m-d\\TH:i', $trimmedDueAt);\n 187→    $dateErrors = DateTimeImmutable::getLastErrors();\n 188→    if (!$dateTime instanceof DateTimeImmutable || $dateErrors !== false) {\n 189→        writeDebugLog('task_due_at_validation', [\n 190→            'submitted_due_at' => $dueAtInput,\n 191→        ], 'failed', [\n 192→            'reason' => 'invalid_datetime_format',\n 193→            'expected_format' => 'Y-m-dTH:i',\n 194→            'database_write_blocked' => true,\n 195→        ]);\n 196→        return [\n 197→            'valid' => false,\n 198→            'normalized' => '',\n 199→            'error' => '截止日期时间格式无效，请使用页面日期时间控件选择。',\n 200→            'reason' => 'invalid_datetime_format',\n 201→        ];\n 202→    }\n 203→\n 204→    $minDateTime = new DateTimeImmutable(MIN_DUE_AT);\n 205→    $maxDateTime = new DateTimeImmutable(MAX_DUE_AT);\n 206→    if ($dateTime < $minDateTime || $dateTime > $maxDateTime) {\n 207→        writeDebugLog('task_due_at_validation', [\n 208→            'submitted_due_at' => $dueAtInput,\n 209→            'normalized_due_at' => $dateTime->format('Y-m-d H:i:s'),\n 210→        ], 'failed', [\n 211→            'reason' => 'datetime_out_of_allowed_range',\n 212→            'min_due_at' => MIN_DUE_AT,\n 213→            'max_due_at' => MAX_DUE_AT,\n 214→            'database_write_blocked' => true,\n 215→        ]);\n 216→        return [\n 217→            'valid' => false,\n 218→            'normalized' => '',\n 219→            'error' => '截止日期时间必须在 2000-01-01 00:00 到 2100-12-31 23:59 之间。',\n 220→            'reason' => 'datetime_out_of_allowed_range',\n 221→        ];\n 222→    }\n 223→\n 224→    $normalizedDueAt = $dateTime->format('Y-m-d H:i:s');\n 225→    writeDebugLog('task_due_at_validation', [\n 226→        'submitted_due_at' => $dueAtInput,\n 227→        'normalized_due_at' => $normalizedDueAt,\n 228→    ], 'success', [\n 229→        'result' => 'valid_due_at',\n 230→        'min_due_at' => MIN_DUE_AT,\n 231→        'max_due_at' => MAX_DUE_AT,\n 232→    ]);\n 233→\n 234→    return [\n 235→        'valid' => true,\n 236→        'normalized' => $normalizedDueAt,\n 237→        'error' => '',\n 238→        'reason' => 'valid_due_at',\n 239→    ];\n 240→}\n 241→\n 242→function formatDueAtForInput(string $dueAt): string\n 243→{\n 244→    $normalizedDueAt = normalizeStoredDueAt($dueAt);\n 245→    if ($normalizedDueAt === '') {\n 246→        return '';\n 247→    }\n 248→\n 249→    $timestamp = strtotime($normalizedDueAt);\n 250→    return $timestamp === false ? '' : date('Y-m-d\\TH:i', $timestamp);\n 251→}\n 252→\n 253→function buildDueAtState(array $task, string $source): array\n 254→{\n 255→    $taskId = isset($task['id']) && is_string($task['id']) ? $task['id'] : '';\n 256→    $dueAt = normalizeStoredDueAt($task['due_at'] ?? '');\n 257→    $nowTimestamp = time();\n 258→    $todayStart = strtotime(date('Y-m-d 00:00:00', $nowTimestamp));\n 259→    $todayEnd = strtotime(date('Y-m-d 23:59:59', $nowTimestamp));\n 260→\n 261→    if ($dueAt === '') {\n 262→        writeDebugLog('task_due_at_status_calculate', [\n 263→            'task_id' => $taskId,\n 264→            'due_at' => '',\n 265→            'source' => $source,\n 266→        ], 'success', [\n 267→            'result_status' => '未设置',\n 268→            'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 269→            'has_due_at' => false,\n 270→        ]);\n 271→        return [\n 272→            'label' => '未设置',\n 273→            'class' => 'due-none',\n 274→            'description' => '未设置截止时间',\n 275→            'datetime' => '',\n 276→        ];\n 277→    }\n 278→\n 279→    $dueTimestamp = strtotime($dueAt);\n 280→    if ($dueTimestamp === false) {\n 281→        writeDebugLog('task_due_at_status_calculate', [\n 282→            'task_id' => $taskId,\n 283→            'due_at' => $dueAt,\n 284→            'source' => $source,\n 285→        ], 'failed', [\n 286→            'reason' => 'stored_due_at_unparseable',\n 287→            'result_status' => '无效日期',\n 288→            'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 289→        ]);\n 290→        return [\n 291→            'label' => '无效日期',\n 292→            'class' => 'due-invalid',\n 293→            'description' => '截止时间格式异常',\n 294→            'datetime' => $dueAt,\n 295→        ];\n 296→    }\n 297→\n 298→    if ($dueTimestamp < $nowTimestamp) {\n 299→        $label = '已逾期';\n 300→        $class = 'due-overdue';\n 301→    } elseif ($todayStart !== false && $todayEnd !== false && $dueTimestamp >= $todayStart && $dueTimestamp <= $todayEnd) {\n 302→        $label = '今日到期';\n 303→        $class = 'due-today';\n 304→    } else {\n 305→        $label = '未到期';\n 306→        $class = 'due-future';\n 307→    }\n 308→\n 309→    writeDebugLog('task_due_at_status_calculate', [\n 310→        'task_id' => $taskId,\n 311→        'due_at' => $dueAt,\n 312→        'source' => $source,\n 313→    ], 'success', [\n 314→        'result_status' => $label,\n 315→        'now' => date('Y-m-d H:i:s', $nowTimestamp),\n 316→        'due_timestamp' => $dueTimestamp,\n 317→        'has_due_at' => true,\n 318→    ]);\n 319→\n 320→    return [\n 321→        'label' => $label,\n 322→        'class' => $class,\n 323→        'description' => formatDateTime($dueAt),\n 324→        'datetime' => $dueAt,\n 325→    ];\n 326→}\n 327→\n 328→function normalizeTask(array $task, int $index): array\n 329→{\n 330→    $createdAt = isset($task['created_at']) && is_string($task['created_at']) && trim($task['created_at']) !== ''\n 331→        ? trim($task['created_at'])\n 332→        : '1970-01-01 00:00:00';\n 333→    $updatedAt = isset($task['updated_at']) && is_string($task['updated_at']) && trim($task['updated_at']) !== ''\n 334→        ? trim($task['updated_at'])\n 335→        : $createdAt;\n 336→\n 337→    $rawStatus = isset($task['status']) && is_string($task['status']) && trim($task['status']) !== ''\n 338→        ? trim($task['status'])\n 339→        : '未开始';\n 340→    $rawPriority = isset($task['priority']) && is_string($task['priority']) && trim($task['priority']) !== ''\n 341→        ? trim($task['priority'])\n 342→        : DEFAULT_TASK_PRIORITY;\n 343→\n 344→    return [\n 345→        'id' => isset($task['id']) && is_string($task['id']) && trim($task['id']) !== ''\n 346→            ? trim($task['id'])\n 347→            : 'task-' . $index,\n 348→        'title' => isset($task['title']) && is_string($task['title'])\n 349→            ? $task['title']\n 350→            : '未命名任务',\n 351→        'content' => isset($task['content']) && is_string($task['content'])\n 352→            ? $task['content']\n 353→            : '',\n 354→        'status' => normalizeTaskStatus($rawStatus),\n 355→        'priority' => normalizeTaskPriority($rawPriority),\n 356→        'category_id' => isset($task['category_id']) && is_string($task['category_id'])\n 357→            ? trim($task['category_id'])\n 358→            : '',\n 359→        'category_name' => isset($task['category_name']) && is_string($task['category_name'])\n 360→            ? trim($task['category_name'])\n 361→            : '',\n 362→        'due_at' => normalizeStoredDueAt($task['due_at'] ?? ''),\n 363→        'created_at' => $createdAt,\n 364→        'updated_at' => $updatedAt,\n 365→        'archived_at' => isset($task['archived_at']) && is_string($task['archived_at'])\n 366→            ? trim($task['archived_at'])\n 367→            : '',\n 368→    ];\n 369→}\n 370→\n 371→function stringLength(string $value): int\n 372→{\n 373→    if (function_exists('mb_strlen')) {\n 374→        return mb_strlen($value, 'UTF-8');\n 375→    }\n 376→\n 377→    return strlen($value);\n 378→}\n 379→\n 380→function normalizeSearchText(string $value): string\n 381→{\n 382→    $normalized = preg_replace('/\\s+/u', ' ', trim($value));\n 383→    if (!is_string($normalized)) {\n 384→        $normalized = trim($value);\n 385→    }\n 386→\n 387→    return function_exists('mb_strtolower') ? mb_strtolower($normalized, 'UTF-8') : strtolower($normalized);\n 388→}\n 389→\n 390→function stringContainsInsensitive(string $haystack, string $needle): bool\n 391→{\n 392→    if ($needle === '') {\n 393→        return true;\n 394→    }\n 395→\n 396→    $normalizedHaystack = normalizeSearchText($haystack);\n 397→    $normalizedNeedle = normalizeSearchText($needle);\n 398→\n 399→    if (function_exists('mb_strpos')) {\n 400→        return mb_strpos($normalizedHaystack, $normalizedNeedle, 0, 'UTF-8') !== false;\n 401→    }\n 402→\n 403→    return strpos($normalizedHaystack, $normalizedNeedle) !== false;\n 404→}\n 405→\n 406→function setDatabaseErrorMessage(string $message): void\n 407→{\n 408→    $GLOBALS['databaseErrorMessage'] = $message;\n 409→}\n 410→\n 411→function getDatabaseErrorMessage(): string\n 412→{\n 413→    return isset($GLOBALS['databaseErrorMessage']) && is_string($GLOBALS['databaseErrorMessage'])\n 414→        ? $GLOBALS['databaseErrorMessage']\n 415→        : '';\n 416→}\n 417→\n 418→function createDatabaseConnection(): PDO\n 419→{\n 420→    if (!extension_loaded('pdo_sqlite')) {\n 421→        writeDebugLog('database_connection_exception', [\n 422→            'driver' => 'pdo_sqlite',\n 423→        ], 'failed', [\n 424→            'reason' => 'pdo_sqlite_extension_missing',\n 425→        ]);\n 426→        throw new RuntimeException('当前 PHP 环境未启用 SQLite 数据库扩展。');\n 427→    }\n 428→\n 429→    $dataDirectory = dirname(DB_FILE);\n 430→    if (!is_dir($dataDirectory) && !mkdir($dataDirectory, 0775, true) && !is_dir($dataDirectory)) {\n 431→        writeDebugLog('database_connection_exception', [\n 432→            'database_file' => basename(DB_FILE),\n 433→        ], 'failed', [\n 434→            'reason' => 'data_directory_unavailable',\n 435→            'directory' => $dataDirectory,\n 436→        ]);\n 437→        throw new RuntimeException('数据库目录不可写，无法初始化数据存储。');\n 438→    }\n 439→\n 440→    $databaseExisted = file_exists(DB_FILE);\n 441→    writeDebugLog('database_connection_open', [\n 442→        'database_file' => basename(DB_FILE),\n 443→        'database_existed' => $databaseExisted,\n 444→    ], 'started');\n 445→\n 446→    $pdo = new PDO('sqlite:' . DB_FILE);\n 447→    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n 448→    $pdo->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);\n 449→    $pdo->exec('PRAGMA foreign_keys = ON');\n 450→    $pdo->exec('PRAGMA busy_timeout = 5000');\n 451→\n 452→    writeDebugLog('database_connection_open', [\n 453→        'database_file' => basename(DB_FILE),\n 454→        'database_existed' => $databaseExisted,\n 455→    ], 'success');\n 456→\n 457→    return $pdo;\n 458→}\n 459→\n 460→function getDatabaseConnection(): PDO\n 461→{\n 462→    static $pdo = null;\n 463→    static $schemaReady = false;\n 464→\n 465→    if (!$pdo instanceof PDO) {\n 466→        $pdo = createDatabaseConnection();\n 467→    }\n 468→\n 469→    if (!$schemaReady) {\n 470→        initializeDatabaseSchema($pdo);\n 471→        ensureTaskCategorySchema($pdo);\n 472→        ensureTaskDeadlineSchema($pdo);\n 473→        ensureTaskPrioritySchema($pdo);\n 474→        migrateLegacyTasksJson($pdo);\n 475→        migrateTaskStatuses($pdo);\n 476→        migrateTaskPriorities($pdo);\n 477→        $schemaReady = true;\n 478→    }\n 479→\n 480→    return $pdo;\n 481→}\n 482→\n 483→function initializeDatabaseSchema(PDO $pdo): void\n 484→{\n 485→    writeDebugLog('database_schema_initialize', [\n 486→        'database_file' => basename(DB_FILE),\n 487→    ], 'started');\n 488→\n 489→    try {\n 490→        $GLOBALS['suppressDatabaseDebugLog'] = true;\n 491→        $pdo->beginTransaction();\n 492→\n 493→        $statements = [\n 494→            'categories' => \"CREATE TABLE IF NOT EXISTS categories (\n 495→                id TEXT PRIMARY KEY,\n 496→                name TEXT NOT NULL UNIQUE,\n 497→                color TEXT NOT NULL DEFAULT '#2563eb',\n 498→                sort_order INTEGER NOT NULL DEFAULT 0,\n 499→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 500→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 501→            )\",\n 502→            'tasks' => \"CREATE TABLE IF NOT EXISTS tasks (\n 503→                id TEXT PRIMARY KEY,\n 504→                title TEXT NOT NULL,\n 505→                content TEXT NOT NULL DEFAULT '',\n 506→                status TEXT NOT NULL DEFAULT '待处理',\n 507→                priority TEXT NOT NULL DEFAULT '中',\n 508→                category_id TEXT NULL,\n 509→                due_at TEXT NULL,\n 510→                archived_at TEXT NULL,\n 511→                deleted_at TEXT NULL,\n 512→                c