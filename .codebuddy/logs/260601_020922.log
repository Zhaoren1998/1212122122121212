\n1103→{\n1104→    if ($keyword === '' && $status === '' && $priority === '') {\n1105→        return $tasks;\n1106→    }\n1107→\n1108→    $filteredTasks = [];\n1109→    foreach ($tasks as $task) {\n1110→        $matchesKeyword = $keyword === ''\n1111→            || stringContainsInsensitive((string) ($task['title'] ?? ''), $keyword)\n1112→            || stringContainsInsensitive((string) ($task['content'] ?? ''), $keyword);\n1113→        $matchesStatus = $status === '' || (string) ($task['status'] ?? '') === $status;\n1114→        $matchesPriority = $priority === '' || normalizeTaskPriority((string) ($task['priority'] ?? '')) === $priority;\n1115→\n1116→        if ($matchesKeyword && $matchesStatus && $matchesPriority) {\n1117→            $filteredTasks[] = $task;\n1118→        }\n1119→    }\n1120→\n1121→    return $filteredTasks;\n1122→}\n1123→\n1124→function normalizeCategoryName(string $name): string\n1125→{\n1126→    $normalized = preg_replace('/\\s+/u', ' ', trim($name));\n1127→    return is_string($normalized) ? $normalized : trim($name);\n1128→}\n1129→\n1130→function createCategoryId(): string\n1131→{\n1132→    try {\n1133→        return 'category-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n1134→    } catch (Throwable $exception) {\n1135→        return 'category-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n1136→    }\n1137→}\n1138→\n1139→function loadCategories(): array\n1140→{\n1141→    writeDebugLog('category_list_load', [\n1142→        'database_file' => basename(DB_FILE),\n1143→    ], 'started');\n1144→\n1145→    try {\n1146→        $pdo = getDatabaseConnection();\n1147→        $statement = $pdo->query(\n1148→            \"SELECT c.id,\n1149→                    c.name,\n1150→                    c.color,\n1151→                    c.sort_order,\n1152→                    c.created_at,\n1153→                    c.updated_at,\n1154→                    COUNT(t.id) AS task_count,\n1155→                    SUM(CASE WHEN t.deleted_at IS NULL THEN 1 ELSE 0 END) AS active_task_count\n1156→            FROM categories c\n1157→            LEFT JOIN tasks t ON t.category_id = c.id\n1158→            GROUP BY c.id, c.name, c.color, c.sort_order, c.created_at, c.updated_at\n1159→            ORDER BY c.sort_order ASC, c.name COLLATE NOCASE ASC\"\n1160→        );\n1161→        $rows = $statement !== false ? $statement->fetchAll() : [];\n1162→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_zr7sktxcoufj_1","__timestamp":"2026-05-31T18:09:50.427Z","_requestId":"877e12d40e8845d791c7472c08ca184d"}

