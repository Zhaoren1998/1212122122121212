NOT NULL,\n 544→                content TEXT NOT NULL,\n 545→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 546→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 547→                FOREIGN KEY (task_id) REFERENCES tasks(id) ON UPDATE CASCADE ON DELETE CASCADE\n 548→            )\",\n 549→            'attachments' => \"CREATE TABLE IF NOT EXISTS attachments (\n 550→                id TEXT PRIMARY KEY,\n 551→                task_id TEXT NOT NULL,\n 552→                file_name TEXT NOT NULL,\n 553→                file_size INTEGER NOT NULL DEFAULT 0,\n 554→                mime_type TEXT NOT NULL DEFAULT 'application/octet-stream',\n 555→                storage_path TEXT NOT NULL DEFAULT '',\n 556→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 557→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 558→                FOREIGN KEY (task_id) REFERENCES tasks(id) ON UPDATE CASCADE ON DELETE CASCADE\n 559→            )\",\n 560→            'operation_logs' => \"CREATE TABLE IF NOT EXISTS operation_logs (\n 561→                id INTEGER PRIMARY KEY AUTOINCREMENT,\n 562→                operation TEXT NOT NULL,\n 563→                parameters_json TEXT NOT NULL DEFAULT '{}',\n 564→                status TEXT NOT NULL,\n 565→                context_json TEXT NOT NULL DEFAULT '{}',\n 566→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 567→            )\",\n 568→            'reminders' => \"CREATE TABLE IF NOT EXISTS reminders (\n 569→                id TEXT PRIMARY KEY,\n 570→                task_id TEXT NOT NULL,\n 571→                remind_at TEXT NOT NULL,\n 572→                status TEXT NOT NULL DEFAULT 'pending',\n 573→                delivered_at TEXT NULL,\n 574→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 575→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 576→                FOREIGN KEY (task_id) REFERENCES tasks(id) ON UPDATE CASCADE ON DELETE CASCADE\n 577→            )\",\n 578→            'system_settings' => \"CREATE TABLE IF NOT EXISTS system_settings (\n 579→                setting_key TEXT PRIMARY KEY,\n 580→                setting_value TEXT NOT NULL,\n 581→                created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),\n 582→                updated_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 583→            )\",\n 584→        ];\n 585→\n 586→        foreach ($statements as $tableName => $sql) {\n 587→            writeDebugLog('database_table_create', [\n 588→                'table' => $tableName,\n 589→                'database_file' => basename(DB_FILE),\n 590→            ], 'started');\n 591→            $pdo->exec($sql);\n 592→            writeDebugLog('database_table_create', [\n 593→                'table' => $tableName,\n 594→                'database_file' => basename(DB_FILE),\n 595→            ], 'success');\n 596→        }\n 597→\n 598→        $indexes = [\n 599→            'idx_tasks_status' => 'CREATE INDEX IF NOT EXISTS idx_tasks_status ON tasks(status)',\n 600→            'idx_tasks_created_at' => 'CREATE INDEX IF NOT EXISTS idx_tasks_created_at ON tasks(created_at)',\n 601→            'idx_tasks_updated_at' => 'CREATE INDEX IF NOT EXISTS idx_tasks_updated_at ON tasks(updated_at)',\n 602→            'idx_tasks_category_id' => 'CREATE INDEX IF NOT EXISTS idx_tasks_category_id ON tasks(category_id)',\n 603→            'idx_task_tags_tag_id' => 'CREATE INDEX IF NOT EXISTS idx_task_tags_tag_id ON task_tags(tag_id)',\n 604→            'idx_subtasks_task_id' => 'CREATE INDEX IF NOT EXISTS idx_subtasks_task_id ON subtasks(task_id)',\n 605→            'idx_comments_task_id' => 'CREATE INDEX IF NOT EXISTS idx_comments_task_id ON comments(task_id)',\n 606→            'idx_attachments_task_id' => 'CREATE INDEX IF NOT EXISTS idx_attachments_task_id ON attachments(task_id)',\n 607→            'idx_reminders_task_id' => 'CREATE INDEX IF NOT EXISTS idx_reminders_task_id ON reminders(task_id)',\n 608→            'idx_reminders_remind_at' => 'CREATE INDEX IF NOT EXISTS idx_reminders_remind_at ON reminders(remind_at)',\n 609→        ];\n 610→\n 611→        foreach ($indexes as $indexName => $sql) {\n 612→            $pdo->exec($sql);\n 613→            writeDebugLog('database_index_create', [\n 614→                'index' => $indexName,\n 615→                'database_file' => basename(DB_FILE),\n 616→            ], 'success');\n 617→        }\n 618→\n 619→        upsertSystemSetting($pdo, 'schema_version', '1');\n 620→        $pdo->commit();\n 621→        $GLOBALS['suppressDatabaseDebugLog'] = false;\n 622→\n 623→        writeDebugLog('database_schema_initialize', [\n 624→            'database_file' => basename(DB_FILE),\n 625→            'table_count' => count($statements),\n 626→            'index_count' => count($indexes),\n 627→        ], 'success');\n 628→    } catch (Throwable $exception) {\n 629→        if ($pdo->inTransaction()) {\n 630→            $pdo->rollBack();\n 631→        }\n 632→        $GLOBALS['suppressDatabaseDebugLog'] = false;\n 633→\n 634→        writeDebugLog('database_schema_initialize', [\n 635→            'database_file' => basename(DB_FILE),\n 636→        ], 'failed', [\n 637→            'reason' => 'schema_exception',\n 638→            'message' => $exception->getMessage(),\n 639→        ]);\n 640→        throw $exception;\n 641→    }\n 642→}\n 643→\n 644→function ensureTaskCategorySchema(PDO $pdo): void\n 645→{\n 646→    writeDebugLog('task_category_schema_check', [\n 647→        'database_file' => basename(DB_FILE),\n 648→        'column' => 'category_id',\n 649→    ], 'started');\n 650→\n 651→    try {\n 652→        $columnsStatement = $pdo->query('PRAGMA table_info(tasks)');\n 653→        $columns = $columnsStatement !== false ? $columnsStatement->fetchAll() : [];\n 654→        $hasCategoryColumn = false;\n 655→\n 656→        foreach ($columns as $column) {\n 657→            if (is_array($column) && isset($column['name']) && (string) $column['name'] === 'category_id') {\n 658→                $hasCategoryColumn = true;\n 659→                break;\n 660→            }\n 661→        }\n 662→\n 663→        if (!$hasCategoryColumn) {\n 664→            $pdo->exec('ALTER TABLE tasks ADD COLUMN category_id TEXT NULL');\n 665→            writeDebugLog('task_category_schema_alter', [\n 666→                'database_file' => basename(DB_FILE),\n 667→                'column' => 'category_id',\n 668→            ], 'success');\n 669→        }\n 670→\n 671→        $pdo->exec('CREATE INDEX IF NOT EXISTS idx_tasks_category_id ON tasks(category_id)');\n 672→        writeDebugLog('task_category_schema_check', [\n 673→            'database_file' => basename(DB_FILE),\n 674→            'column' => 'category_id',\n 675→            'index' => 'idx_tasks_category_id',\n 676→        ], 'success', [\n 677→            'column_added' => !$hasCategoryColumn,\n 678→            'reference_policy' => 'delete_blocked_when_referenced',\n 679→        ]);\n 680→    } catch (Throwable $exception) {\n 681→        writeDebugLog('task_category_schema_check', [\n 682→            'database_file' => basename(DB_FILE),\n 683→            'column' => 'category_id',\n 684→        ], 'failed', [\n 685→            'reason' => 'category_schema_exception',\n 686→            'message' => $exception->getMessage(),\n 687→        ]);\n 688→        throw $exception;\n 689→    }\n 690→}\n 691→\n 692→function ensureTaskDeadlineSchema(PDO $pdo): void\n 693→{\n 694→    writeDebugLog('task_due_at_schema_check', [\n 695→        'database_file' => basename(DB_FILE),\n 696→        'column' => 'due_at',\n 697→    ], 'started');\n 698→\n 699→    try {\n 700→        $columnsStatement = $pdo->query('PRAGMA table_info(tasks)');\n 701→        $columns = $columnsStatement !== false ? $columnsStatement->fetch