 751→        $hasPriorityColumn = false;\n 752→\n 753→        foreach ($columns as $column) {\n 754→            if (is_array($column) && isset($column['name']) && (string) $column['name'] === 'priority') {\n 755→                $hasPriorityColumn = true;\n 756→                break;\n 757→            }\n 758→        }\n 759→\n 760→        if (!$hasPriorityColumn) {\n 761→            $pdo->exec(\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT '\" . DEFAULT_TASK_PRIORITY . \"'\");\n 762→            writeDebugLog('task_priority_schema_alter', [\n 763→                'database_file' => basename(DB_FILE),\n 764→                'column' => 'priority',\n 765→                'default_priority' => DEFAULT_TASK_PRIORITY,\n 766→            ], 'success');\n 767→        }\n 768→\n 769→        $pdo->exec('CREATE INDEX IF NOT EXISTS idx_tasks_priority ON tasks(priority)');\n 770→        writeDebugLog('task_priority_schema_check', [\n 771→            'database_file' => basename(DB_FILE),\n 772→            'column' => 'priority',\n 773→            'index' => 'idx_tasks_priority',\n 774→        ], 'success', [\n 775→            'column_added' => !$hasPriorityColumn,\n 776→            'allowed_priorities' => ALLOWED_PRIORITIES,\n 777→        ]);\n 778→    } catch (Throwable $exception) {\n 779→        writeDebugLog('task_priority_schema_check', [\n 780→            'database_file' => basename(DB_FILE),\n 781→            'column' => 'priority',\n 782→        ], 'failed', [\n 783→            'reason' => 'priority_schema_exception',\n 784→            'message' => $exception->getMessage(),\n 785→        ]);\n 786→        throw $exception;\n 787→    }\n 788→}\n 789→\n 790→function upsertSystemSetting(PDO $pdo, string $key, string $value): void\n 791→{\n 792→    $statement = $pdo->prepare(\n 793→        \"INSERT INTO system_settings (setting_key, setting_value, created_at, updated_at)\n 794→        VALUES (:setting_key, :setting_value, datetime('now', 'localtime'), datetime('now', 'localtime'))\n 795→        ON CONFLICT(setting_key) DO UPDATE SET\n 796→            setting_value = excluded.setting_value,\n 797→            updated_at = datetime('now', 'localtime')\"\n 798→    );\n 799→    $statement->execute([\n 800→        ':setting_key' => $key,\n 801→        ':setting_value' => $value,\n 802→    ]);\n 803→}\n 804→\n 805→function getSystemSetting(PDO $pdo, string $key): ?string\n 806→{\n 807→    $statement = $pdo->prepare('SELECT setting_value FROM system_settings WHERE setting_key = :setting_key LIMIT 1');\n 808→    $statement->execute([':setting_key' => $key]);\n 809→    $value = $statement->fetchColumn();\n 810→\n 811→    return is_string($value) ? $value : null;\n 812→}\n 813→\n 814→function migrateLegacyTasksJson(PDO $pdo): void\n 815→{\n 816→    if (getSystemSetting($pdo, 'legacy_json_migrated') === '1') {\n 817→        return;\n 818→    }\n 819→\n 820→    writeDebugLog('database_legacy_json_migration', [\n 821→        'data_file' => basename(DATA_FILE),\n 822→        'database_file' => basename(DB_FILE),\n 823→    ], 'started');\n 824→\n 825→    $migratedCount = 0;\n 826→    $skippedCount = 0;\n 827→\n 828→    try {\n 829→        if (file_exists(DATA_FILE)) {\n 830→            $rawJson = file_get_contents(DATA_FILE);\n 831→            if ($rawJson === false) {\n 832→                throw new RuntimeException('旧 JSON 数据文件读取失败。');\n 833→            }\n 834→\n 835→            $trimmedJson = trim($rawJson);\n 836→            if ($trimmedJson !== '') {\n 837→                $decoded = json_decode($trimmedJson, true);\n 838→                if (!is_array($decoded)) {\n 839→                    throw new RuntimeException('旧 JSON 数据格式无效：' . json_last_error_msg());\n 840→                }\n 841→\n 842→                $statement = $pdo->prepare(\n 843→                    \"INSERT OR IGNORE INTO tasks\n 844→                    (id, title, content, status, priority, category_id, due_at, archived_at, deleted_at, created_at, updated_at)\n 845→                    VALUES\n 846→                    (:id, :title, :content, :status, :priority, NULL, NULL, NULL, NULL, :created_at, :updated_at)\"\n 847→                );\n 848→\n 849→                foreach ($decoded as $index => $legacyTask) {\n 850→                    if (!is_array($legacyTask)) {\n 851→                        $skippedCount++;\n 852→                        continue;\n 853→                    }\n 854→\n 855→                    $task = normalizeTask($legacyTask, (int) $index);\n 856→                    $statement->execute([\n 857→                        ':id' => $task['id'],\n 858→                        ':title' => $task['title'],\n 859→                        ':content' => $task['content'],\n 860→                        ':status' => normalizeTaskStatus($task['status']),\n 861→                        ':priority' => '中',\n 862→                        ':created_at' => $task['created_at'],\n 863→                        ':updated_at' => $task['updated_at'],\n 864→                    ]);\n 865→\n 866→                    if ($statement->rowCount() > 0) {\n 867→                        $migratedCount++;\n 868→                    } else {\n 869→                        $skippedCount++;\n 870→                    }\n 871→                }\n 872→            }\n 873→        }\n 874→\n 875→        upsertSystemSetting($pdo, 'legacy_json_migrated', '1');\n 876→        writeDebugLog('database_legacy_json_migration', [\n 877→            'data_file' => basename(DATA_FILE),\n 878→            'database_file' => basename(DB_FILE),\n 879→        ], 'success', [\n 880→            'migrated_count' => $migratedCount,\n 881→            'skipped_count' => $skippedCount,\n 882→        ]);\n 883→    } catch (Throwable $exception) {\n 884→        writeDebugLog('database_legacy_json_migration', [\n 885→            'data_file' => basename(DATA_FILE),\n 886→            'database_file' => basename(DB_FILE),\n 887→        ], 'failed', [\n 888→            'reason' => 'migration_exception',\n 889→            'message' => $exception->getMessage(),\n 890→            'migrated_count' => $migratedCount,\n 891→            'skipped_count' => $skippedCount,\n 892→        ]);\n 893→        throw $exception;\n 894→    }\n 895→}\n 896→\n 897→function migrateTaskStatuses(PDO $pdo): void\n 898→{\n 899→    if (getSystemSetting($pdo, 'task_status_migrated_v2') === '1') {\n 900→        return;\n 901→    }\n 902→\n 903→    writeDebugLog('task_status_migration', [\n 904→        'database_file' => basename(DB_FILE),\n 905→        'allowed_statuses' => ALLOWED_STATUSES,\n 906→        'legacy_statuses' => array_keys(LEGACY_STATUS_MAP),\n 907→    ], 'started');\n 908→\n 909→    try {\n 910→        $statement = $pdo->query('SELECT id, status, archived_at FROM tasks WHERE deleted_at IS NULL');\n 911→        $rows = $statement !== false ? $statement->fetchAll() : [];\n 912→        $updatedCount = 0;\n 913→        $invalidCount = 0;\n 914→        $now = date('Y-m-d H:i:s');\n 915→        $updateStatement = $pdo->prepare(\n 916→            'UPDATE tasks\n 917→            SET status = :status,\n 918→                archived_at = :archived_at,\n 919→                updated_at = :updated_at\n 920→            WHERE id = :id'\n 921→        );\n 922→\n 923→        foreach ($rows as $row) {\n 924→            if (!is_array($row)) {\n 925→                continue;\n 926→            }\n 927→\n 928→            $taskId = isset($row['id']) && is_string($row['id']) ? $row['id'] : '';\n 929→            $rawStatus = isset($row['status']) && is_string($row['status']) ? trim($row['status']) : '';\n 930→            $normalizedStatus = normalizeTaskStatus($rawStatus);\n 931→            $archivedAt = isset($row['archived_at']) && is_string($row['archived_at']) ? trim($row['archived_at']) : '';\n 932→\n 933→            if ($taskId === '') {\n 934→                continue;\n 935→            }\n 936→\n 937→            if ($rawStatus !== $normalizedStatus) {\n 938→                $invalidCount++;\n 939→                writeDebugLog('task_status_read_exception', [\n 940→                    'task_id' => $taskId,\n 941→                    'raw_status' => $rawStatus,\n 942→                ], 'failed', [\n 943→                    'reason' => 'status_outside_allowed_enum',\n 944→                    'normalized_status' => $normalizedStatus,\n 945→                    'allowed_statuses' => ALLOWED_STATUSES,\n 946→                ]);\n 947→            }\n 948→\n 949→            $targetArchivedAt = $normalizedStatus === '已归档'\n 950→                ? ($archivedAt !== '' ? $archivedAt : $now)\n 951→                : null;\n 952→\n 953→            if ($rawStatus !== $normalizedStatus || ($normalizedStatus !== '已归档' && $archivedAt !== '') || ($normalizedStatus === '已归档' && $archivedAt === '')) {\n 954→                $updateStatement->execute([\n 955→                    ':status' => $normalizedStatus,\n 956→                    ':archived_at' => $targetArchivedAt,\n 957→                    ':updated_at' => $now,\n 958→                    ':id' => $taskId,\n 959→                ]);\n 960→                $updatedCount += $updateStatement->rowCount();\n 961→            }\n 962→        }\n 963→\n 964→        upsertSystemSetting($pdo, 'task_status_migrated_v2', '1');\n 965→        writeDebugLog('task_status_migration', [\n 966→            'database_file' => basename(DB_FILE),\n 967→        ], 'success', [\n 968→            'scanned_count' => count($rows),\n 969→            'updated_count' => $updatedCount,\n 970→            'invalid_status_count' => $invalidCount,\n 971→            'allowed_statuses' => ALLOWED_STATUSES,\n 972→        ]);\n 973→    } catch (Throwable $exception) {\n 974→        writeDebugLog('task_status_migration', [\n 975→            'database_file' => basename(DB_FILE),\n 976→        ], 'failed', [\n 977→            'reason' => 'status_migration_exception',\n 978→            'message' => $exception->getMessage(),\n 979→        ]);\n 980→        throw $exception;\n 981→    }\n 982→}\n 983→\n 984→function migrateTaskPriorities(PDO $pdo): void\n 985→{\n 986→    if (getSystemSetting($pdo, 'task_priority_migrated_v1') === '1') {\n 987→        return;\n 988→    }\n 989→\n 990→    writeDebugLog('task_priority_migration', [\n 991→        'database_file' => basename(DB_FILE),\n 992→        'allowed_priorities' => ALLOWED_PRIORITIES,\n 993→        'default_priority' => DEFAULT_TASK_PRIORITY,\n 994→    ], 'started');\n 995→\n 996→    try {\n 997→        $statement = $pdo->query('SELECT id, priority FROM tasks WHERE deleted_at IS NULL');\n 998→        $rows = $statement !== false ? $statement->fetchAll() : [];\n 999→        $updatedCount = 0;\n1000→        $invalidCount = 0;\n1001→        $now = date('Y-m-d H:i:s');\n1002→        $updateStatement = $pdo->prepare(\n1003→            'UPDATE tasks\n1004→            SET priority = :priority,\n1005→                updated_at = :updated_at\n1006→            WHERE id = :id'\n1007→        );\n1008→\n1009→        foreach ($rows as $row) {\n1010→            if (!is_array($row)) {\n1011→                continue;\n1012→            }\n1013→\n1014→            $taskId = isset($row['id']) && is_string($row['id']) ? $row['id'] : '';\n1015→            $rawPriority = isset($row['priority']) && is_string($row['priority']) ? trim($row['priority']) : '';\n1016→            $normalizedPriority = normalizeTaskPriority($rawPriority);\n1017→\n1018→            if ($taskId === '') {\n1019→                continue;\n1020→            }\n1021→\n1022→            if ($rawPriority !== $normalizedPriority) {\n1023→                $invalidCount++;\n1024→                writeDebugLog('task_priority_read_exception', [\n1025→                    'task_id' => $taskId,\n1026→                    'raw_priority' => $rawPriority,\n1027→                ], 'failed', [\n1028→                    'reason' => 'priority_outside_allowed_enum',\n1029→                    'normalized_priority' => $normalizedPriority,\n1030→                    'allowed_priorities' => ALLOWED_PRIORITIES,\n1031→                ]);\n1032→\n1033→                $updateStatement->execute([\n1034→                    ':priority' => $normalizedPriority,\n1035→                    ':updated_at' => $now,\n1036→                    ':id' => $taskId,\n1037→                ]);\n1038→                $updatedCount += $updateStatement->rowCount();\n1039→            }\n1040→        }\n1041→\n1042→        upsertSystemSetting($pdo, 'task_priority_migrated_v1', '1');\n1043→        writeDebugLog('task_priority_migration', [\n1044→            'database_file' => basename(DB_FILE),\n1045→        ], 'success', [\n1046→            'scanned_count' => count($rows),\n1047→            'updated_count' => $updatedCount,\n1048→            'invalid_priority_count' => $invalidCount,\n1049→            'allowed_priorities' => ALLOWED_PRIORITIES,\n1050→        ]);\n1051→    } catch (Throwable $exception) {\n1052→        writeDebugLog('task_priority_migration', [\n1053→            'database_file' => basename(DB_FILE),\n1054→        ], 'failed', [\n1055→            'reason' => 'priority_migration_exception',\n1056→            'message' => $exception->getMessage(),\n1057→        ]);\n1058→        throw $exception;\n1059→    }\n1060→}\n1061→\n1062→function normalizeFilterParameters(array $query): array\n1063→{\n1064→    $rawKeyword = isset($query['keyword']) && is_string($query['keyword']) ? $query['keyword'] : '';\n1065→    $rawStatus = isset($query['status']) && is_string($query['status']) ? $query['status'] : '';\n1066→    $rawPriority = isset($query['priority']) && is_string($query['priority']) ? $query['priority'] : '';\n1067→    $keyword = trim($rawKeyword);\n1068→    $status = trim($rawStatus);\n1069→    $priority = trim($rawPriority);\n1070→    $errors = [];\n1071→\n1072→    if (stringLength($keyword) > MAX_SEARCH_KEYWORD_LENGTH) {\n1073→        $errors['keyword'] = '关键词不能超过 ' . MAX_SEARCH_KEYWORD_LENGTH . ' 个字符，已自动截断后搜索。';\n1074→        if (function_exists('mb_substr')) {\n1075→            $keyword = mb_substr($keyword, 0, MAX_SEARCH_KEYWORD_LENGTH, 'UTF-8');\n1076→        } else {\n1077→            $keyword = substr($keyword, 0, MAX_SEARCH_KEYWORD_LENGTH);\n1078→        }\n1079→    }\n1080→\n1081→    if ($status !== '' && !isAllowedTaskStatus($status)) {\n1082→        $errors['status'] = '状态筛选参数无效，已忽略该条件。';\n1083→        $status = '';\n1084→    }\n1085→\n1086→    if ($priority !== '' && !isAllowedTaskPriority($priority)) {\n1087→        $errors['priority'] = '优先级筛选参数无效，已忽略该条件。';\n1088→        $priority = '';\n1089→    }\n1090→\n1091→    return [\n1092→        'keyword' => $keyword,\n1093→        'status' => $status,\n1094→        'priority' => $priority,\n1095→        'errors' => $errors,\n1096→        'raw_keyword_length' => stringLength($rawKeyword),\n1097→        'raw_status' => $rawStatus,\n1098→        'raw_priority' => $rawPriority,\n1099→    ];\n1100→}\n1101→\n1102→function filterTasks(array $tasks, string $keyword, string $status, string $priority): array\n1103→{\n1104→    if ($keyword === '' && $status === '' && $priority === '') {\n1105→        return $tasks;\n1106→    }\n1107→\n1108→    $filteredTasks = [];\n1109→    foreach ($tasks as $task) {\n1110→        $matchesKeyword = $keyword === ''\n1111→            || stringContainsInsensitive((string) ($task['title'] ?? ''), $keyword)\n1112→            || stringContainsInsensitive((string) ($task['content'] ?? ''), $keyword);\n1113→        $matchesStatus = $status === '' || (string) ($task['status'] ?? '') === $status;\n1114→        $matchesPriority = $priority === '' || normalizeTaskPriority((string) ($task['priority'] ?? '')) === $priority;\n1115→\n1116→        if ($matchesKeyword && $matchesStatus && $matchesPriority) {\n1117→            $filteredTasks[] = $task;\n1118→        }\n1119→    }\n1120→\n1121→    return $filteredTasks;\n1122→}\n1123→\n1124→function normalizeCategoryName(string $name): string\n1125→{\n1126→    $normalized = preg_replace('/\\s+/u', ' ', trim($name));\n1127→    return is_string($normalized) ? $normalized : trim($name);\n1128→}\n1129→\n1130→function createCategoryId(): string\n1131→{\n1132→    try {\n1133→        return 'category-' . date('YmdHis') . '-' . bin2hex(random_bytes(4));\n1134→    } catch (Throwable $exception) {\n1135→        return 'category-' . date('YmdHis') . '-' . str_replace('.', '', uniqid('', true));\n1136→    }\n1137→}\n1138→\n1139→function loadCategories(): array\n1140→{\n1141→    writeDebugLog('category_list_load', [\n1142→        'database_file' => basename(DB_FILE),\n1143→    ], 'started');\n1144→\n1145→    try {\n1146→        $pdo = getDatabaseConnection();\n1147→        $statement = $pdo->query(\n1148→            \"SELECT c.id,\n1149→                    c.name,\n1150→                    c.color,\n1151→                    c.sort_order,\n1152→                    c.created_at,\n1153→                    c.updated_at,\n1154→                    COUNT(t.id) AS task_count,\n1155→                    SUM(CASE WHEN t.deleted_at IS NULL THEN 1 ELSE 0 END) AS active_task_count\n1156→            FROM categories c\n1157→            LEFT JOIN tasks t ON t.category_id = c.id\n1158→            GROUP BY c.id, c.name, c.color, c.sort_order, c.created_at, c.updated_at\n1159→            ORDER BY c.sort_order ASC, c.name COLLATE NOCASE ASC\"\n1160→        );\n1161→        $rows = $statement !== false ? $statement->fetchAll() : [];\n1162→        $categories = [];\n1163→\n1164→        foreach ($rows as $row) {\n1165→            if (!is_array($row)) {\n1166→                continue;\n1167→            }\n1168→\n1169→            $categories[] = [\n1170→                'id' => isset($row['id']) && is_string($row['id']) ? trim($row['id']) : '',\n1171→                'name' => isset($row['name']) && is_string($row['name']) ? trim($row['name']) : '',\n1172→                'color' => isset($row['color']) && is_string($row['color']) && trim($row['color']) !== '' ? trim($row['color']) : '#2563eb',\n1173→                'sort_order' => isset($row['sort_order']) ? (int) $row['sort_order'] : 0,\n1174→                'created_at' => isset($row['created_at']) && is_string($row['created_at']) ? trim($row['created_at']) : '',\n1175→                'updated_at' => isset($row['updated_at']) && is_string($row['updated_at']) ? trim($row['updated_at']) : '',\n1176→                'task_count' => isset($row['task_count']) ? (int) $row['task_count'] : 0,\n1177→                'active_task_count' => isset($row['active_task_count']) ? (int) $row['active_task_count'] : 0,\n1178→            ];\n1179→        }\n1180→\n1181→        writeDebugLog('category_list_load', [\n1182→            'database_file' => basename(DB_FILE),\n1183→        ], 'success', [\n1184→            'category_count' => count($categories),\n1185→        ]);\n1186→\n1187→        return $categories;\n1188→    } catch (Throwable $exception) {\n1189→        writeDebugLog('category_list_load_exception', [\n1190→            'database_file' => basename(DB_FILE),\n1191→        ], 'failed', [\n1192→            'reason' => 'database_query_exception',\n1193→            'message' => $exception->getMessage(),\n1194→        ]);\n1195→        return [];\n1196→    }\n1197→}\n1198→\n1199→function findCategoryById(array $categories, string $categoryId): ?array\n1200→{\n1201→    foreach ($categories as $category) {\n1202→        if (($category['id'] ?? '') === $categoryId) {\n1203→            return $category;\n1204→        }\n1205→    }\n1206→\n1207→    return null;\n1208→}\n1209→\n1210→function categoryNameExists(PDO $pdo, string $name, string $excludeCategoryId = ''): bool\n1211→{\n1212→    $statement = $pdo->prepare(\n1213→        \"SELECT id FROM categories\n1214→        WHERE lower(name) = lower(:name)\n1215→            AND (:exclude_id = '' OR id <> :exclude_id)\n1216→        LIMIT 1\"\n1217→    );\n1218→    $statement->execute([\n1219→        ':name' => $name,\n1220→        ':exclude_id' => $excludeCategoryId,\n1221→    ]);\n1222→    $existingId = $statement->fetchColumn();\n1223→    $statement->closeCursor();\n1224→\n1225→    return is_string($existingId) && $existingId !== '';\n1226→}\n1227→\n1228→function validateCategoryInput(string $name, string $excludeCategoryId = ''): array\n1229→{\n1230→    $errors = [];\n1231→    $normalizedName = normalizeCategoryName($name);\n1232→\n1233→    if ($normalizedName === '') {\n1234→        $errors['category_name'] = '分类名称不能为空。';\n1235→    } elseif (stringLength($normalizedName) > MAX_CATEGORY_NAME_LENGTH) {\n1236→        $errors['category_name'] = '分类名称不能超过 ' . MAX_CATEGORY_NAME_LENGTH . ' 个字符。';\n1237→    } else {\n1238→        try {\n1239→            $pdo = getDatabaseConnection();\n1240→            if (categoryNameExists($pdo, $normalizedName, $excludeCategoryId)) {\n1241→                $errors['category_name'] = '分类名称已存在，请使用不同名称。';\n1242→            }\n1243→        } catch (Throwable $exception) {\n1244→            $errors['category_name'] = '分类校验失败，请稍后重试。';\n1245→            writeDebugLog('category_validation_exception', [\n1246→                'category_id' => $excludeCategoryId,\n1247→                'name_length' => stringLength($normalizedName),\n1248→            ], 'failed', [\n1249→                'reason' => 'database_query_exception',\n1250→                'message' => $exception->getMessage(),\n1251→            ]);\n1252→        }\n1253→    }\n1254→\n1255→    return [\n1256→        'valid' => $errors === [],\n1257→        'name' => $normalizedName,\n1258→        'errors' => $errors,\n1259→    ];\n1260→}\n1261→\n1262→function validateTaskCategoryId(string $categoryId, array $categories, string $formAction, string $taskId = ''): array\n1263→{\n1264→    $trimmedCategoryId = trim($categoryId);\n1265→    if ($trimmedCategoryId === '') {\n1266→        writeDebugLog('task_category_validation', [\n1267→            'task_id' => $taskId,\n1268→            'category_id' => '',\n1269→            'form_action' => $formAction,\n1270→        ], 'success', [\n1271→            'result' => 'empty_category_allowed',\n1272→        ]);\n1273→\n1274→        return [\n1275→            'valid' => true,\n1276→            'category_id' => '',\n1277→            'error' => '',\n1278→        ];\n1279→    }\n1280→\n1281→    $category = findCategoryById($categories, $trimmedCategoryId);\n1282→    if ($category === null) {\n1283→        writeDebugLog('task_category_validation', [\n1284→            'task_id' => $taskId,\n1285→            'category_id' => $trimmedCategoryId,\n1286→            'form_action' => $formAction,\n1287→        ], 'failed', [\n1288→            'reason' => 'category_not_found',\n1289→            'database_write_blocked' => true,\n1290→        ]);\n1291→\n1292→        return [\n1293→            'valid' => false,\n1294→            'category_id' => '',\n1295→            'error' => '请选择有效的任务分类。',\n1296→        ];\n1297→    }\n1298→\n1299→    writeDebugLog('task_category_validation', [\n1300→        'task_id' => $taskId,\n1301→        'category_id' => $trimmedCategoryId,\n1302→        'form_action' => $formAction,\n1303→    ], 'success', [\n1304→        'category_name' => (string) $category['name'],\n1305→    ]);\n1306→\n1307→    return [\n1308→        'valid' => true,\n1309→        'category_id' => $trimmedCategoryId,\n1310→        'error' => '',\n1311→    ];\n1312→}\n1313→\n1314→function saveNewCategory(string $name): string\n1315→{\n1316→    $categoryId = createCategoryId();\n1317→    writeDebugLog('category_create', [\n1318→        'category_id' => $categoryId,\n1319→        'name_length' => stringLength($name),\n1320→    ], 'started');\n1321→\n1322→    try {\n1323→        $pdo = getDatabaseConnection();\n1324→        $now = date('Y-m-d H:i:s');\n1325→        $sortOrderStatement = $pdo->query('SELECT COALESCE(MAX(sort_order), 0) + 1 FROM categories');\n1326→        $sortOrder = $sortOrderStatement !== false ? (int) $sortOrderStatement->fetchColumn() : 1;\n1327→        if ($sortOrderStatement !== 