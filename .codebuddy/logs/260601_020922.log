button class=\"status-button\" type=\"submit\">保存</button>\n4299→                            </form>\n4300→                            <div class=\"category-actions\">\n4301→                                <form class=\"delete-form\" method=\"post\" action=\"index.php\" data-category-delete-form data-category-id=\"<?php echo escapeHtml($categoryId); ?>\" data-category-name=\"<?php echo escapeHtml($categoryName); ?>\">\n4302→                                    <input type=\"hidden\" name=\"form_action\" value=\"category_delete\">\n4303→                                    <input type=\"hidden\" name=\"manage_category_id\" value=\"<?php echo escapeHtml($categoryId); ?>\">\n4304→                                    <button class=\"delete-button\" type=\"submit\"<?php echo $categoryTotalCount > 0 ? ' title=\"分类已被任务引用，提交后会被保护拦截\"' : ''; ?>>删除</button>\n4305→                                </form>\n4306→                            </div>\n4307→                        </article>\n4308→                    <?php endforeach; ?>\n4309→                <?php endif; ?>\n4310→            </div>\n4311→        </section>\n4312→\n4313→        <?php if (is_array($viewTask)): ?>\n4314→            <?php\n4315→            $detailStatus = normalizeTaskStatus((string) $viewTask['status']);\n4316→            $detailPriority = normalizeTaskPriority((string) ($viewTask['priority'] ?? DEFAULT_TASK_PRIORITY));\n4317→            $detailCategoryName = isset($viewTask['category_name']) && is_string($viewTask['category_name']) && trim($viewTask['category_name']) !== ''\n4318→                ? trim($viewTask['category_name'])\n4319→                : '未分类';\n4320→            $detailArchivedAt = isset($viewTask['archived_at']) && is_string($viewTask['archived_at']) && trim($viewTask['archived_at']) !== ''\n4321→                ? formatDateTime($viewTask['archived_at'])\n4322→                : '未归档';\n4323→            $detailDueState = buildDueAtState($viewTask, 'detail');\n4324→            ?>\n4325→    