               t.due_at,\n3550→                    t.repeat_rule,\n3551→                    t.created_at,\n3552→                    t.updated_at\n3553→            FROM tasks t\n3554→            LEFT JOIN categories c ON c.id = t.category_id\n3555→            INNER JOIN task_tags tt ON tt.task_id = t.id\n3556→            WHERE \" . $whereClause . \" AND tt.tag_id = :tag_id\n3557→            ORDER BY t.created_at DESC\";\n3558→            $params[':tag_id'] = $tagId;\n3559→        } else {\n3560→            $sql = \"SELECT t.id,\n3561→                    t.title,\n3562→                    t.content,\n3563→                    t.status,\n3564→                    t.priority,\n3565→                    t.category_id,\n3566→                    c.name AS category_name,\n3567→                    t.due_at,\n3568→                    t.repeat_rule,\n3569→                    t.created_at,\n3570→                    t.updated_at\n3571→            FROM tasks t\n3572→            LEFT JOIN categories c ON c.id = t.category_id\n3573→            WHERE \" . $whereClause . \"\n3574→            ORDER BY t.created_at DESC\";\n3575→        }\n3576→\n3577→        $statement = $pdo->prepare($sql);\n3578→        foreach ($params as $key => $value) {\n3579→            $statement->bindValue($key, $value);\n3580→        }\n3581→        $statement->execute();\n3582→        $rows = $statement->fetchAll();\n3583→        $statement->closeCursor();\n3584→\n3585→        $tasks = [];\n3586→        foreach ($rows as $row) {\n3587→            if (is_array($row)) {\n3588→                $taskId = isset($row['id']) ? $row['id'] : '';\n3589→                $tagIds = loadTagIdsForTask($pdo, $taskId);\n3590→                $tags = loadTagsForTask($pdo, $taskId);\n3591→                $tagNames = array_column($tags, 'name');\n3592→                $row['tag_names'] = implode(',', $tagNames);\n3593→                $tasks[] = $row;\n3594→            }\n3595→        }\n3596→\n3597→        writeDebugLog('csv_export_query_success', [\n3598→            'task_count' => count($tasks),\n3599→            'keyword_empty' => $keyword === '',\n3600→            'status_empty' => $status === '',\n3601→            'priority_empty' => $priority === '',\n3602→            'tag_id_empty' => $tagId === '',\n3603→        ], 'success');\n3604→\n3605→        $csvContent = generateCsvContent($tasks);\n3606→\n3607→        writeDebugLog('csv_export_content_generated', [\n3608→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_482c9yt10a4z_1","__timestamp":"2026-06-01T03:51:26.683Z","_requestId":"131016f949f8498194e0c5e6453ad04d"}

