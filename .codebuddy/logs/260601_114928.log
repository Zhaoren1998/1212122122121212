n  94→        FILE_APPEND | LOCK_EX\n  95→    );\n  96→    persistDebugLogToDatabase($entry);\n  97→}\n  98→\n  99→function persistDebugLogToDatabase(array $entry): void\n 100→{\n 101→    if (!empty($GLOBALS['isPersistingDebugLog']) || !empty($GLOBALS['suppressDatabaseDebugLog']) || !extension_loaded('pdo_sqlite')) {\n 102→        return;\n 103→    }\n 104→\n 105→    $GLOBALS['isPersistingDebugLog'] = true;\n 106→\n 107→    try {\n 108→        $dataDirectory = dirname(DB_FILE);\n 109→        if (!is_dir($dataDirectory) && !mkdir($dataDirectory, 0775, true) && !is_dir($dataDirectory)) {\n 110→            return;\n 111→        }\n 112→\n 113→        $pdo = new PDO('sqlite:' . DB_FILE);\n 114→        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);\n 115→        $pdo->exec('PRAGMA busy_timeout = 5000');\n 116→        $pdo->exec(\"CREATE TABLE IF NOT EXISTS operation_logs (\n 117→            id INTEGER PRIMARY KEY AUTOINCREMENT,\n 118→            operation TEXT NOT NULL,\n 119→            parameters_json TEXT NOT NULL DEFAULT '{}',\n 120→            status TEXT NOT NULL,\n 121→            context_json TEXT NOT NULL DEFAULT '{}',\n 122→            created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))\n 123→        )\");\n 124→\n 125→        $parametersJson = json_encode($entry['parameters'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n 126→        $contextJson = json_encode($entry['context'] ?? [], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);\n 127→        $statement = $pdo->prepare(\n 128→            'INSERT INTO operation_logs (operation, parameters_json, status, context_json, created_at)\n 129→            VALUES (:operation, :parameters_json, :status, :context_json, :created_at)'\n 130→        );\n 131→        $statement->execute([\n 132→            ':operation' => (string) ($entry['operation'] ?? 'unknown'),\n 133→            ':parameters_json' => is_string($parametersJson) ? $parametersJson : '{}',\n 134→            ':status