ines[] = implode(',', $headers);\n3650→\n3651→    if (empty($tasks)) {\n3652→        writeDebugLog('csv_export_empty_data', [], 'success');\n3653→        return implode(\"\\n\", $lines) . \"\\n\";\n3654→    }\n3655→\n3656→    foreach ($tasks as $task) {\n3657→        $row = [\n3658→            csvEscapeString(isset($task['title']) ? $task['title'] : ''),\n3659→            csvEscapeString(isset($task['content']) ? $task['content'] : ''),\n3660→            csvEscapeString(isset($task['status']) ? $task['status'] : ''),\n3661→            csvEscapeString(isset($task['priority']) ? $task['priority'] : ''),\n3662→            csvEscapeString(isset($task['category_name']) ? $task['category_name'] : ''),\n3663→            csvEscapeString(isset($task['tag_names']) ? $task['tag_names'] : ''),\n3664→            csvEscapeString(isset($task['due_at']) ? $task['due_at'] : ''),\n3665→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_1qvid8gr58os_1","__timestamp":"2026-06-01T03:51:32.190Z","_requestId":"131016f949f8498194e0c5e6453ad04d"}

