= 't.priority = :priority';\n4018→            $params[':priority'] = $priority;\n4019→        }\n4020→\n4021→        $whereClause = implode(' AND ', $whereConditions);\n4022→\n4023→        $countSql = \"SELECT COUNT(*) FROM tasks t WHERE \" . $whereClause;\n4024→        $countStatement = $pdo->prepare($countSql);\n4025→        foreach ($params as $key => $value) {\n4026→            $countStatement->bindValue($key, $value);\n4027→        }\n4028→        $countStatement->execute();\n4029→        $totalCount = (int) $countStatement->fetchColumn();\n4030→        $countStatement->closeCursor();\n4031→\n4032→        writeDebugLog('task_list_count_query', [\n4033→            'database_file' => basename(DB_FILE),\n4034→            'total_count' => $totalCount,\n4035→            'keyword_length' => stringLength($keyword),\n4036→            'status' => $status,\n4037→            'priority' => $priority,\n4038→            'visibility' => $normalizedVisibility,\n4039→        ], 'success');\n4040→\n4041→        $pagination = calculatePagination($totalCount, $page, $pageSize);\n4042→\n4043→        if ($tagId !== '') {\n4044→            $sql = \"SELECT t.id,\n4045→                    t.title,\n4046→                    t.content,\n4047→                    t.status,\n4048→                    t.priority,\n4049→                    t.category_id,\n4050→                    c.name AS category_name,\n4051→                    t.due_at,\n4052→                    t.repeat_rule,\n4053→                    t.archived_at,\n4054→                    t.archive_previous_status,\n4055→                    t.deleted_at,\n4056→                    t.created_at,\n4057→                    t.updated_at\n4058→            FROM tasks t\n4059→            LEFT JOIN categories c ON c.id = t.category_id\n4060→            INNER JOIN task_tags tt ON tt.task_id = t.id\n4061→            WHERE \" . $whereClause . \" AND tt.tag_id = :tag_id\n4062→            ORDER BY \" . buildOrderByClause($sortBy, $sortOrder) . \"\n4063→            LIMIT :limit OFFSET :offset\";\n4064→            $params[':tag_id'] = $tagId;\n4065→        } else {\n4066→            $sql = \"SELECT t.id,\n4067→                    t.title,\n4068→                    t.content,\n4069→                    t.status,\n4070→                    t.priority,\n4071→                    t.category_id,\n4072→                    c.name AS category_name,\n4073→                    t.due_at,\n4074→                    t.repeat_rule,\n4075→                    t.archived_at,\n4076→                    t.archive_previous_status,\n4077→                    t.deleted_at,\n4078→                    t.created_at,\n4079→                    t.updated_at\n4080→            FROM tasks t\n4081→            LEFT JOIN categories c ON c.id = t.category_id\n4082→            WHERE \" . $whereClause . \"\n4083→            ORDER BY \" . buildOrderByClause($sortBy, $sortOrder) . \"\n4084→            LIMIT :limit OFFSET :offset\";\n4085→        }\n4086→\n4087→        $params[':limit'] = $pagination['page_size'];\n4088→        $params[':offset'] = $pagination['offset'];\n4089→\n4090→        $statement = $pdo->prepare($sql);\n4091→        foreach ($params as $key => $value) {\n4092→            $statement->bindValue($key, $value);\n4093→        }\n4094→        $statement->execute();\n4095→        $rows = $statement->fetchAll();\n4096→        $statement->closeCursor();\n4097→\n4098→        $tasks = [];\n4099→        foreach ($rows as $index => $row) {\n4100→            if (is_array($row)) {\n4101→                $rawStatus = isset($row['status']) && is_string($row['status']) ? trim($row['status']) : '';\n4102→                if (!isAllowedTaskStatus($rawStatus)) {\n4103→                    writeDebugLog('task_status_read_exception', [\n4104→                        'task_id' => isset($row['id']) && is_string($row['id']) ? $row['id'] : '',\n4105→                        'raw_status' => $rawStatus,\n4106→                    ], 'failed', [\n4107→                        'reason' => 'status_outside_allowed_enum_on_read',\n4108→                        'normalized_status' => normalizeTaskStatus($rawStatus),\n4109→                        'allowed_statuses' => ALLOWED_STATUSES,\n4110→                    ]);\n4111→                }\n4112→                $rawPriority = isset($row['priority']) && is_string($row['priority']) ? trim($row['priority']) : '';\n4113→                if (!isAllowedTaskPriority($rawPriority)) {\n4114→                    writeDebugLog('task_priority_read_exception', [\n4115→                        'task_id' => isset($row['id']) && is_string($row['id']) ? $row['id'] : '',\n4116→                        'raw_priority' => $rawPriority,\n4117→                    ], 'failed', [\n4118→                        'reason' => 'priority_outside_allowed_enum_on_read',\n4119→                        'normalized_priority' => normalizeTaskPriority($rawPriority),\n4120→                        'allowed_priorities' => ALLOWED_PRIORITIES,\n4121→                    ]);\n4122→                }\n4123→                $task = normalizeTask($row, (int) $index);\n4124→                $taskId = $task['id'];\n4125→                $task['tag_ids'] = loadTagIdsForTask($pdo, $taskId);\n4126→                $task['tags'] = loadTagsForTask($pdo, $taskId);\n4127→                $taskReminder = loadTaskReminder($taskId);\n4128→                if ($taskReminder !== null) {\n4129→                    $task['remind_at'] = $taskReminder['remind_at'];\n4130→                    $task['remind_status'] = $taskReminder['status'];\n4131→                }\n4132→                $tasks[] = $task;\n4133→            }\n4134→        }\n4135→\n4136→        writeDebugLog('task_list_load_paginated', [\n4137→            'database_file' => basename(DB_FILE),\n4138→            'page' => $page,\n4139→            'page_size' => $pageSize,\n4140→            'total_count' => $totalCount,\n4141→            'returned_count' => count($tasks),\n4142→            'sort_by' => $sortBy,\n4143→            'sort_order' => $sortOrder,\n4144→            'visibility' => $normalizedVisibility,\n4145→        ], 'success', [\n4146→            'pagination' => $pagination,\n4147→            'keyword_empty' => $keyword === '',\n4148→            'status_empty' => $status === '',\n4149→            'priority_empty' => $priority === '',\n4150→            'tag_id_empty' => $tagId === '',\n4151→            'visibility' => $normalizedVisibility,\n4152→        ]);\n4153→\n4154→        return [\n4155→            'tasks' => $tasks,\n4156→            'pagination' => $pagination,\n4157→        ];\n4158→    } catch (Throwable $exception) {\n4159→        setDatabaseErrorMessage('数据库读取失败，系统已保留页面可用性，请稍后重试或查看日志。');\n4160→        writeDebugLog('task_list_read_paginated_exception', [\n4161→            'database_file' => basename(DB_FILE),\n4162→            'page' => $page,\n4163→            'page_size' => $pageSize,\n4164→        ], 'failed', [\n4165→            'reason' => 'database_query_exception',\n4166→            'message' => $exception->getMessage(),\n4167→        ]);\n4168→        return [\n4169→            'tasks' => [],\n4170→            'pagination' => calculatePagination(0, $page, $pageSize),\n4171→            'error' => $exception->getMessage(),\n4172→        ];\n4173→    }\n4174→}\n4175→\n4176→function loadTasks(string $visibility = TASK_VISIBILITY_ALL): array\n4177→{\n4178→    $normalizedVisibility = normalizeTaskVisibility($visibility);\n4179→    setDatabaseErrorMessage('');\n4180→    writeDebugLog('task_list_load', [\n4181→        'database_file' => basename(DB_FILE),\n4182→        'visibility' => $normalizedVisibility,\n4183→"}],"is_error":false}],"role":"user"},"parent_tool_use_id":"call_function_bj1yxa1a6yg6_1","__timestamp":"2026-06-01T03:45:46.520Z","_requestId":"7917a0761d0a480e97b9c05003604ad1"}

